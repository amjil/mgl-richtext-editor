(ns rich-editor.utils.platform
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/foundation.dart" :as foundation]))

(defn is-mobile?
  "True if the current platform is mobile (iOS or Android)."
  []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform m/TargetPlatform.iOS)
        (= platform m/TargetPlatform.android))))

(defn is-desktop?
  "True if the current platform is desktop (macOS, Windows, Linux), excluding Web."
  []
  (and (not foundation/kIsWeb)
       (not= foundation/defaultTargetPlatform m/TargetPlatform.iOS)
       (not= foundation/defaultTargetPlatform m/TargetPlatform.android)))

(defn is-web?
  "True if running on Web."
  []
  (boolean foundation/kIsWeb))
