(ns rich-editor.ui.find-replace-dialog
  (:require [cljd.flutter :as f]
            [rich-editor.ui-state :as ui]
            [rich-editor.command.search-commands :as search-cmd]
            [rich-editor.utils.platform :as platform]
            [components.text-field :refer [text-field]]
            ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]))

;; =============================================================
;; Find and replace dialog
;; =============================================================

(defn find-replace-dialog
  "Find and replace dialog component"
  []
  (f/widget
   :get {{{:flds [surface onSurfaceVariant scrim]} .-colorScheme} m/Theme
         {{:flds [width]} .-size} m/MediaQuery}
   :managed [search-controller (m/TextEditingController.)
             replace-controller (m/TextEditingController.)]
   :watch [search-state (f/$ (:search (f/<! ui/!ui-state)))]
   :let [show-dialog? (:show-dialog? search-state)
         replace-mode? (:replace-mode? search-state)
         replace-term (:replace-term search-state)
         matches (:matches search-state)
         current-index (:current-match-index search-state)
         match-count (count matches)
         match-info (if (pos? match-count)
                      (str (inc current-index) " / " match-count)
                      "No matches")
         is-mobile? (platform/is-mobile?)
         use-vertical-layout? (or is-mobile? (< width 600.0))
         button-padding (if use-vertical-layout?
                          (m/EdgeInsets.symmetric :horizontal 12.0 :vertical 24.0)
                          (m/EdgeInsets.symmetric :horizontal 8.0 :vertical 16.0))
         icon-btn-size (if use-vertical-layout? 48.0 40.0)
         shadow-color (or scrim (-> m/Colors.black (.withOpacity 0.12)))]

   (if show-dialog?
     (m/Positioned
      .top 0.0 .bottom 0.0 .right 0.0
      .child
      (m/Container
       .padding (if use-vertical-layout? (m/EdgeInsets.all 12.0) (m/EdgeInsets.all 16.0))
       .decoration (m/BoxDecoration
                    .color surface
                    .boxShadow [(m/BoxShadow .color shadow-color .blurRadius 8.0 .offset (m/Offset. 0.0 2.0))])
       .child
       (m/Row
        .mainAxisSize m/MainAxisSize.min
        .crossAxisAlignment m/CrossAxisAlignment.start
        .children
        [;; --- Search Area ---
         (m/Row
            :mainAxisSize m/MainAxisSize.min
            :children
            [(text-field
              {:controller search-controller
               :hint "Enter text to find"
               :max-lines 1 ;; 限制为单行
               :suffix-icon (m/IconButton
                             :icon (m/Icon m/Icons.close)
                             :tooltip "Clear"
                             :iconSize icon-btn-size
                             :onPressed (fn [] (.clear search-controller) (search-cmd/update-search-term! "")))
               :decoration (m/InputDecoration :labelText "Find" :border (m/OutlineInputBorder))
               :on-changed (fn [value] (search-cmd/update-search-term! value))})

             (m/Padding
              :padding (m/EdgeInsets.only :top 8.0)
              :child
              (m/Column
               :mainAxisAlignment m/MainAxisAlignment.spaceEvenly
               :children
               [(mgl/MongolElevatedButton.icon
                 :icon (m/Icon m/Icons.arrow_upward)
                 :label (mgl/MongolText "Previous")
                 :onPressed (when (pos? match-count) (fn [] (search-cmd/find-previous!)))
                 :style (m/ButtonStyle :padding (m/MaterialStateProperty.all button-padding)))
                (mgl/MongolElevatedButton.icon
                 :icon (m/Icon m/Icons.arrow_downward)
                 :label (mgl/MongolText "Next")
                 :onPressed (when (pos? match-count) (fn [] (search-cmd/find-next!)))
                 :style (m/ButtonStyle :padding (m/MaterialStateProperty.all button-padding)))
                (mgl/MongolElevatedButton.icon
                 :icon (m/Icon m/Icons.close)
                 :label (mgl/MongolText "Close")
                 :onPressed (fn [] (search-cmd/hide-find-dialog!))
                 :style (m/ButtonStyle :padding (m/MaterialStateProperty.all button-padding)))]))])

         ;; Match info
         (m/Padding
          :padding (m/EdgeInsets.only :top 8.0 :left (if use-vertical-layout? 0.0 16.0))
          :child (mgl/MongolText match-info :style (m/TextStyle :fontSize 12.0 :color onSurfaceVariant)))

         ;; --- Replace Area ---
         (if replace-mode?
           (m/Padding
            :padding (m/EdgeInsets.only :top 8.0)
            :child
            (m/Column
             :children
             [(m/Expanded
               :child (text-field
                       {:controller replace-controller
                        :hint "Enter replacement text"
                        :max-lines 1
                        :decoration (m/InputDecoration :labelText "Replace With" :border (m/OutlineInputBorder))
                        :on-changed (fn [value] (search-cmd/update-replace-term! value))}))
              (mgl/MongolElevatedButton :onPressed (when (pos? match-count) (fn [] (search-cmd/replace-current! replace-term)))
                                        :child (mgl/MongolText "Replace")
                                        :style (m/ButtonStyle :padding (m/MaterialStateProperty.all button-padding)))
              (mgl/MongolElevatedButton :onPressed (when (pos? match-count) (fn [] (search-cmd/replace-all! replace-term)))
                                        :child (mgl/MongolText "Replace All")
                                        :style (m/ButtonStyle :padding (m/MaterialStateProperty.all button-padding)))]))
           (m/SizedBox.shrink))])))
     (m/SizedBox.shrink))))