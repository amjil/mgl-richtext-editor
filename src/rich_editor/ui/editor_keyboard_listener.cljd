(ns rich-editor.ui.editor-keyboard-listener
  (:require [cljd.flutter :as f]
            ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as service]
            ["package:flutter/foundation.dart" :as foundation]
            ["package:flutter/gestures.dart" :as gestures]))

;; =============================================================
;; Editor Keyboard Listener Widget
;; Handles keyboard events on desktop platforms for shortcuts and navigation
;; =============================================================

(defn editor-keyboard-listener
  "Widget that listens to keyboard events and handles shortcuts/navigation.
   
   Args:
     :child - The child widget to wrap
     :on-key-event - Callback function that receives KeyEvent and returns bool
                    (true if handled, false otherwise)
   
   Only handles keyboard events on desktop platforms (macOS, Windows, Linux).
   Mobile platforms (iOS, Android) and web are ignored.
   
   Navigation keys (Arrow keys, Home, End, Page Up/Down) and modifier keys
   (Meta/Ctrl, Alt) are processed. Enter key is always passed through to
   TextInputConnection for text input."
  [{:keys [child on-key-event]}]
  (f/widget
   :managed [focus-node (m/FocusNode.)]
   :let [platform foundation/defaultTargetPlatform
         ;; Only handle keyboard events on desktop platforms
         ;; Mobile platforms should not use HardwareKeyboard
         is-desktop? (and (not foundation/kIsWeb)
                         (not= platform m/TargetPlatform.iOS)
                         (not= platform m/TargetPlatform.android))
         
         ;; Navigation keys that should be handled
         navigation-keys #{"Arrow Left" "Arrow Right" "Arrow Up" "Arrow Down"
                          "Home" "End" "Page Up" "Page Down"}
         
         ;; Key event handler
         handle-key-event (fn [_node event]
                           ;; Only handle keyboard events on desktop platforms
                           (if (not is-desktop?)
                             m/KeyEventResult.ignored
                             (let [logical-key (.-logicalKey event)
                                   key-label (.-keyLabel logical-key)]
                               ;; Let Enter key pass through to TextInputConnection for text input
                               ;; Check this first, before processing any other events
                               (if (= key-label "Enter")
                                 m/KeyEventResult.ignored
                                 ;; Process KeyDownEvent and KeyRepeatEvent for shortcuts/navigation
                                 (if (or (instance? service/KeyDownEvent event)
                                         (instance? service/KeyRepeatEvent event))
                                   (let [is-navigation-key? (contains? navigation-keys key-label)
                                         keyboard-instance (.-instance service/HardwareKeyboard)
                                         is-meta? (or (.-isMetaPressed keyboard-instance)
                                                     (.-isControlPressed keyboard-instance))
                                         is-alt? (.-isAltPressed keyboard-instance)
                                         is-shortcut? (or is-meta? is-alt?)]
                                     (if (or is-navigation-key? is-shortcut?)
                                       (do
                                         ;; Call handler, but always return handled to prevent system default behavior
                                         ;; even if the handler returns false (e.g., no selection to copy)
                                         (on-key-event event)
                                         m/KeyEventResult.handled)
                                       m/KeyEventResult.ignored))
                                   m/KeyEventResult.ignored)))))]
   (m/Focus
    .focusNode focus-node
    .autofocus true
    .onKeyEvent handle-key-event
    .child (m/GestureDetector
            .behavior m/HitTestBehavior.translucent
            .onTapDown (fn [_] (.requestFocus focus-node))
            .child child))))
