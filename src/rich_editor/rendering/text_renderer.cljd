(ns rich-editor.rendering.text-renderer
  "Handles the conversion of raw text and attribute spans into Flutter TextSpan trees.
   Supports inline formatting and interactive deterministic entities (Tags/Mentions)."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/gestures.dart" :as g]
            [clojure.string :as str]))

;; =============================================================================
;; 1. Formatting & Styling Helpers
;; =============================================================================

(defn- hex-string->color [hex-str]
  (try
    (let [clean-hex (if (.startsWith hex-str "#") (subs hex-str 1) hex-str)
          full-hex (if (= 6 (count clean-hex)) (str "FF" clean-hex) clean-hex)]
      (m/Color (dart:core/int.parse full-hex .radix 16)))
    (catch Exception _ nil)))

(defn apply-inline-formats
  "Applies formatting attributes to the base text style.
   Automatically colors and bolds text identified as a `:tag`."
  [^m/TextStyle base-style attributes]
  (if (empty? attributes)
    base-style
    (let [is-bold (:bold attributes)
          is-italic (:italic attributes)
          is-underline (:underline attributes)
          is-strikethrough (:strikethrough attributes)
          is-tag (:tag attributes)
          color-hex (:color attributes)

          ;; Determine the final color (Tag default is blue, but can be overridden)
          final-color (cond
                        color-hex (hex-string->color color-hex)
                        is-tag m/Colors.blue 
                        :else (.-color base-style))

          decorations (cond-> []
                        is-underline (conj m.TextDecoration/underline)
                        is-strikethrough (conj m.TextDecoration/lineThrough))
          final-decoration (if (seq decorations)
                             (m.TextDecoration/combine decorations)
                             m.TextDecoration/none)]

      (.copyWith base-style
                 .fontWeight (if (or is-bold is-tag) m.FontWeight/bold (.-fontWeight base-style))
                 .fontStyle (if is-italic m.FontStyle/italic (.-fontStyle base-style))
                 .decoration final-decoration
                 .color final-color))))

;; =============================================================================
;; 2. Core Segmenting Engine
;; =============================================================================

(defn- text+spans->segments
  "Converts absolute ranges into continuous, non-overlapping segments.
   If a character is covered by multiple spans, their attributes are merged."
  [text spans]
  (let [len (count text)
        char-attrs (reduce (fn [acc {:keys [start end attrs]}]
                             (reduce (fn [a i]
                                       (if (and (>= i 0) (< i len))
                                         (update a i merge attrs)
                                         a))
                                     acc
                                     (range start end)))
                           (vec (repeat len {}))
                           spans)]
    (if (empty? text)
      []
      (->> (map vector text char-attrs)
           (partition-by second)
           (map (fn [group]
                  {:text (apply str (map first group))
                   :attrs (second (first group))}))))))

;; =============================================================================
;; 3. Main Builder function
;; =============================================================================

(defn build-rich-text-span
  "Builds a Flutter TextSpan tree from content and span data.
   Extracts :on-tag-tap from cfg to handle entity clicks dynamically."
  [content spans base-style cfg]
  (if (empty? content)
    (m/TextSpan. .text "" .style base-style)
    (let [on-tag-tap (:on-tag-tap cfg)
          
          segments (text+spans->segments content spans)
          children (mapv (fn [{:keys [text attrs]}]
                           (let [;; Handle Mongolian specific invisible formatting characters
                                 display-text (str/replace text "\u202F" " ") 
                                 
                                 is-tag (:tag attrs)
                                 entity-id (:entity-id attrs)
                                 
                                 recognizer (when (and is-tag entity-id on-tag-tap)
                                              (let [recog (g/TapGestureRecognizer.)]
                                                (set! (.-onTap recog) 
                                                      (fn [] (on-tag-tap entity-id)))
                                                recog))]
                             (m/TextSpan.
                              .text display-text
                              .recognizer recognizer
                              .style (apply-inline-formats base-style attrs))))
                         segments)]
      (m/TextSpan. .style base-style .children children))))