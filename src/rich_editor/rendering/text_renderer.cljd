(ns rich-editor.rendering.text-renderer
  "Handles the conversion of raw text and attribute spans into Flutter TextSpan trees.
   Supports inline formatting and interactive deterministic entities (Tags/Mentions)."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/gestures.dart" :as g]
            [clojure.string :as str]
            [rich-editor.config :as config]))

;; =============================================================================
;; 1. Formatting & Styling Helpers
;; =============================================================================

(def apply-inline-formats
  "Fallback when config has no :inline-format-applier. Prefer config/default-apply-inline."
  config/default-apply-inline)

;; =============================================================================
;; 2. Core Segmenting Engine
;; =============================================================================

(defn- text+spans->segments
  "Converts absolute ranges into continuous, non-overlapping segments.
   If a character is covered by multiple spans, their attributes are merged."
  [text spans]
  (let [len (count text)
        char-attrs (reduce (fn [acc {:keys [start end attrs]}]
                             (reduce (fn [a i]
                                       (if (and (>= i 0) (< i len))
                                         (update a i merge attrs)
                                         a))
                                     acc
                                     (range start end)))
                           (vec (repeat len {}))
                           spans)]
    (if (empty? text)
      []
      (->> (map vector text char-attrs)
           (partition-by second)
           (map (fn [group]
                  {:text (apply str (map first group))
                   :attrs (second (first group))}))))))

;; =============================================================================
;; 3. Main Builder function
;; =============================================================================

(defonce !tag-recognizers (atom {}))

(defn- sync-tag-recognizers! [needed-ids on-tag-tap]
  (let [needed (set needed-ids)
        current @!tag-recognizers
        stale-ids (filterv #(not (contains? needed %)) (keys current))
        missing-ids (filterv #(not (contains? current %)) needed)]
    (doseq [id stale-ids]
      (when-let [recog (get current id)]
        (.dispose recog)))
    (let [created (into {}
                        (map (fn [id]
                               (let [recog (g/TapGestureRecognizer.)]
                                 (set! (.-onTap recog) (fn [] (on-tag-tap id)))
                                 [id recog]))
                             missing-ids))]
      (reset! !tag-recognizers
              (merge (apply dissoc current stale-ids) created)))
    (doseq [[id recog] @!tag-recognizers]
      (set! (.-onTap recog) (fn [] (on-tag-tap id))))
    @!tag-recognizers))

(defn build-rich-text-span
  "Builds a Flutter TextSpan tree from content and span data.
   Extracts :on-tag-tap from cfg to handle entity clicks dynamically."
  [content spans base-style cfg]
  (if (empty? content)
    (m/TextSpan. .text "" .style base-style)
    (let [on-tag-tap (:on-tag-tap cfg)
          apply-fn (or (:inline-format-applier cfg) apply-inline-formats)
          segments (text+spans->segments content spans)
          entity-ids (into []
                           (keep (fn [{:keys [attrs]}]
                                   (when (and (:tag attrs) (:entity-id attrs) on-tag-tap)
                                     (:entity-id attrs)))
                                 segments))
          recogs (when on-tag-tap (sync-tag-recognizers! entity-ids on-tag-tap))
          children (mapv (fn [{:keys [text attrs]}]
                           (let [display-text (str/replace text "\u202F" " ")
                                 is-tag (:tag attrs)
                                 entity-id (:entity-id attrs)
                                 recognizer (when (and is-tag entity-id on-tag-tap)
                                              (get recogs entity-id))]
                             (m/TextSpan.
                              .text display-text
                              .recognizer recognizer
                              .style (apply-fn base-style attrs))))
                         segments)]
      (m/TextSpan. .style base-style .children children))))