(ns rich-editor.components.editor
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["package:flutter/foundation.dart" :as foundation]
            [cljd.flutter :as f]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.services.ime-service :as ime]
            [rich-editor.services.clipboard-service :as clipboard]
            [rich-editor.config :as config]
            [rich-editor.defaults :as defaults]
            [rich-editor.components.node-view :as node-view]
            [virtual-keyboard.keyboard :as keyboard]
            [virtual-keyboard.keyboard-state :as vk-state]
            [virtual-keyboard.keyboard-action :as vk-action]
            [virtual-keyboard.options :as options]
            [shared-ime.controller :as ime-ctrl]
            [shared-ime.overlay-view :as overlay]))

(defn is-mobile? []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform foundation.TargetPlatform/android)
        (= platform foundation.TargetPlatform/iOS))))

(defn- handle-key-event [cfg* !state _node event]
  (let [ime-res (ime-ctrl/handle-key-event event)]
    (if (= ime-res m.KeyEventResult/handled)
      ime-res
      (let [logical-key (.-logicalKey event)
            is-down? (dart/is? event s/KeyDownEvent)
            
            ;; Detect Ctrl (Win/Linux) or Cmd (Mac) modifier keys
            hw-kb (.-instance s/HardwareKeyboard)
            is-ctrl? (or (.-isControlPressed hw-kb) (.-isMetaPressed hw-kb))
            
            is-up? (= logical-key s.LogicalKeyboardKey/arrowUp)
            is-down-arrow? (= logical-key s.LogicalKeyboardKey/arrowDown)
            is-left? (= logical-key s.LogicalKeyboardKey/arrowLeft)
            is-right? (= logical-key s.LogicalKeyboardKey/arrowRight)
            is-arrow? (or is-up? is-down-arrow? is-left? is-right?)]
        (cond
          ;; CLIPBOARD SHORTCUTS
          (and is-down? is-ctrl? (= logical-key s.LogicalKeyboardKey/keyC))
          (do
            (clipboard/copy! @!state)
            m.KeyEventResult/handled)

          (and is-down? is-ctrl? (= logical-key s.LogicalKeyboardKey/keyV))
          (do
            (clipboard/paste! !state)
            m.KeyEventResult/handled)

          (and is-down? is-ctrl? (= logical-key s.LogicalKeyboardKey/keyX))
          (do
            (clipboard/cut! !state editor-cmd/delete-global-selection!)
            m.KeyEventResult/handled)

          ;; Handle Escape
          (= logical-key s.LogicalKeyboardKey/escape)
          m.KeyEventResult/handled

          ;; 🌟 Handle Backspace (Physical Keyboard)
          (= logical-key s.LogicalKeyboardKey/backspace)
          (if is-down?
            (let [state @!state
                  global-sel (:global-selection state)
                  active-id (:active-block-id state)]
              (cond
                ;; Case 1: Cross-block global selection exists
                global-sel
                (do
                  (editor-cmd/delete-global-selection! !state)
                  m.KeyEventResult/handled)

                ;; Case 2: Local block is active
                active-id
                (let [block (get-in state [:blocks active-id])
                      sel (:selection block)]
                  (if sel
                    (let [start (min (.-baseOffset sel) (.-extentOffset sel))
                          end (max (.-baseOffset sel) (.-extentOffset sel))]
                      (cond
                        ;; Sub-case 2A: Range selection exists
                        (not= start end)
                        (do
                          (text-cmd/delete-range !state active-id start (- end start))
                          ;; 🌟 FIX: Force collapse caret after range deletion
                          (editor-cmd/focus-block !state active-id start))

                        ;; Sub-case 2B: Delete 1 char backwards
                        (> start 0)
                        (text-cmd/delete-range !state active-id (dec start) 1)

                        ;; Sub-case 2C: Cursor at line start
                        (= start 0)
                        (dart:core/print "TODO: Merge block with previous block (Cursor at 0)")))
                    
                    m.KeyEventResult/ignored)
                  m.KeyEventResult/handled)

                :else m.KeyEventResult/ignored))
            m.KeyEventResult/handled)

          ;; Handle Tab / Shift+Tab
          (= logical-key s.LogicalKeyboardKey/tab)
          (if is-down?
            (do
              (if (.-isShiftPressed hw-kb)
                (config/run-command cfg* !state :outdent)
                (config/run-command cfg* !state :indent))
              m.KeyEventResult/handled)
            m.KeyEventResult/handled)

          ;; Handle Arrow keys
          is-arrow?
          (if is-down?
            (let [active-id (:active-block-id @!state)]
              (if active-id
                (let [block (get-in @!state [:blocks active-id])
                      sel (:selection block)
                      offset (if sel (.-extentOffset sel) 0)
                      content-len (count (:content block ""))
                      root (:root @!state)
                      idx (.indexOf root active-id)]
                  (cond
                    is-up?
                    (if (> offset 0)
                      (do (editor-cmd/focus-block !state active-id (dec offset))
                          m.KeyEventResult/handled)
                      (if (> idx 0)
                        (let [prev-id (nth root (dec idx))
                              prev-len (count (:content (get-in @!state [:blocks prev-id]) ""))]
                          (editor-cmd/focus-block !state prev-id prev-len)
                          m.KeyEventResult/handled)
                        m.KeyEventResult/handled))

                    is-down-arrow?
                    (if (< offset content-len)
                      (do (editor-cmd/focus-block !state active-id (inc offset))
                          m.KeyEventResult/handled)
                      (if (< idx (dec (count root)))
                        (let [next-id (nth root (inc idx))]
                          (editor-cmd/focus-block !state next-id 0)
                          m.KeyEventResult/handled)
                        m.KeyEventResult/handled))

                    is-left?
                    (if (> idx 0)
                      (let [prev-id (nth root (dec idx))
                            prev-len (count (:content (get-in @!state [:blocks prev-id]) ""))
                            new-offset (min offset prev-len)]
                        (editor-cmd/focus-block !state prev-id new-offset)
                        m.KeyEventResult/handled)
                      m.KeyEventResult/handled)

                    is-right?
                    (if (< idx (dec (count root)))
                      (let [next-id (nth root (inc idx))
                            next-len (count (:content (get-in @!state [:blocks next-id]) ""))
                            new-offset (min offset next-len)]
                        (editor-cmd/focus-block !state next-id new-offset)
                        m.KeyEventResult/handled)
                      m.KeyEventResult/handled)

                    :else m.KeyEventResult/ignored))
                m.KeyEventResult/handled))
            m.KeyEventResult/handled)

          :else m.KeyEventResult/ignored)))))

(defn mongol-editor
  "Highly encapsulated Mongolian rich text editor."
  [!state editor-config & {:keys [leading-widget]}]
  (let [cfg (config/merge-config defaults/full-default-config editor-config)]
    (f/widget
     :managed [editor-focus-node (m/FocusNode)]
     :watch [state !state]
     
     (let [content-list (m/ListView
                         .scrollDirection m.Axis/horizontal
                         .padding (m.EdgeInsets/all 20.0)
                         .children (mapv (fn [i]
                                           (let [id (nth (:root state) i)]
                                             (m/KeyedSubtree
                                              .key (m/ValueKey. id)
                                              .child (m/Padding
                                                      .padding (m.EdgeInsets/only .right 12.0)
                                                      .child (node-view/block-node id !state i cfg)))))
                                         (range (count (:root state)))))
           
           clickable-content (m/Listener
                              .behavior m.HitTestBehavior/translucent
                              .onPointerDown (fn [_]
                                               (when-not (.-hasFocus editor-focus-node)
                                                 (.requestFocus editor-focus-node)))
                              .child
                              (m/GestureDetector
                               .behavior m.HitTestBehavior/translucent
                               .onTap (fn []
                                        (when-not (:active-block-id @!state)
                                          (when-let [last-id (last (:root @!state))]
                                            (let [len (count (get-in @!state [:blocks last-id :content] ""))]
                                              (editor-cmd/focus-block !state last-id len)))))
                               .child content-list))
           
           core-input-area (m/Focus
                            .focusNode editor-focus-node
                            .onFocusChange 
                            (fn [has-focus?]
                              (if has-focus?
                                (do
                                  (s/SystemChannels.textInput.invokeMethod "TextInput.hide")
                                  (when-let [active-id (:active-block-id @!state)]
                                    (ime/attach! !state active-id)))
                                (do
                                  (ime/detach!)
                                  (swap! !state assoc :active-block-id nil :cursor-visible false))))
                            .onKeyEvent (fn [node event] (handle-key-event cfg !state node event))
                            .child clickable-content)

           combined-input-area (m/Row
                                .crossAxisAlignment m.CrossAxisAlignment/start
                                .children
                                [(if leading-widget
                                   leading-widget
                                   (m/SizedBox.shrink))
                                 (m/Expanded .child core-input-area)])]

       (if (is-mobile?)
         (f/widget
          :let [info (merge options/keyboard-option {:keyboard/mongol-font-family "OyunQaganTig"
                                                     :keyboard/key-container-color m/Colors.grey.shade500
                                                     :keyboard/font-size 16})]
          :bind {:info info}
          (m/Column
           .children
           [(m/Expanded
             .child
             (m/Stack
              .children
              [combined-input-area
               (if (or (:active-block-id state) (:external-keyboard-delegate state))
                 (keyboard/candidates nil)
                 (m/SizedBox.shrink))]))

            (if (or (:active-block-id state) (:external-keyboard-delegate state))
              (keyboard/keyboard
               {:custom-fns
                {:on-return
                 (fn []
                   (cond
                     (:active-block-id @!state)
                     (let [active-id (:active-block-id @!state)
                           block (get-in @!state [:blocks active-id])
                           sel (:selection block)
                           offset (if sel (.-extentOffset sel) 0)]
                       (editor-cmd/focus-block !state active-id offset)
                       (text-cmd/insert-string !state active-id offset "\n"))

                     (:external-keyboard-delegate @!state)
                     (when-let [on-return-fn (:on-return (:external-keyboard-delegate @!state))]
                       (on-return-fn))

                     :else nil))

                 ;; 🌟 FIX: Mobile Virtual Keyboard Backspace
                 :on-backspace
                 (fn []
                   (let [state-val @!state
                         candidates (:keyboard/candidates-list @vk-state/state)]
                     (if (seq candidates)
                       (vk-action/clear-candidates)
                       (cond
                         ;; 🌟 NEW: Check global selection first!
                         (:global-selection state-val)
                         (editor-cmd/delete-global-selection! !state)

                         (:active-block-id state-val)
                         (let [active-id (:active-block-id state-val)
                               block (get-in state-val [:blocks active-id])
                               sel (:selection block)
                               start (if sel (.-baseOffset sel) 0)
                               end (if sel (.-extentOffset sel) 0)]
                           (if (not= start end)
                             (do
                               (text-cmd/delete-range !state active-id (min start end) (- (max start end) (min start end)))
                               ;; 🌟 FIX: Force collapse caret after range deletion
                               (editor-cmd/focus-block !state active-id (min start end)))
                             (when (> start 0)
                               (text-cmd/delete-range !state active-id (dec start) 1))))

                         (:external-keyboard-delegate state-val)
                         (when-let [on-backspace-fn (:on-backspace (:external-keyboard-delegate state-val))]
                           (on-backspace-fn))

                         :else nil))))}})
              (m/SizedBox.shrink))]))

         (overlay/ime-global-wrapper
          (m/CallbackShortcuts
           .bindings (config/shortcut-bindings cfg !state)
           .child combined-input-area)))))))