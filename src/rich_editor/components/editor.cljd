(ns rich-editor.components.editor
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["package:flutter/foundation.dart" :as foundation]
            [cljd.flutter :as f]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.services.ime-service :as ime]
            [rich-editor.services.clipboard-service :as clipboard]
            [rich-editor.config :as config]
            [rich-editor.defaults :as defaults]
            [rich-editor.components.node-view :as node-view]
            [virtual-keyboard.keyboard :as keyboard]
            [virtual-keyboard.keyboard-state :as vk-state]
            [virtual-keyboard.keyboard-action :as vk-action]
            [virtual-keyboard.options :as options]
            [shared-ime.controller :as ime-ctrl]
            [shared-ime.overlay-view :as overlay]))

(defn is-mobile? []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform foundation.TargetPlatform/android)
        (= platform foundation.TargetPlatform/iOS))))

;; =============================================================================
;; THE CORE ENGINE FOR BACKSPACE
;; =============================================================================
(defn- handle-backspace-action [!state cfg]
  (let [state-val @!state
        global-sel (:global-selection state-val)
        active-id (:active-block-id state-val)]
    (cond
      global-sel
      (editor-cmd/delete-global-selection! !state)

      active-id
      (let [block (get-in state-val [:blocks active-id])
            block-type (:type block)
            is-text? (config/text-block-type? cfg block-type)
            sel (:selection block)
            start (if sel (min (.-baseOffset sel) (.-extentOffset sel)) 0)
            end (if sel (max (.-baseOffset sel) (.-extentOffset sel)) 0)]
        (if is-text?
          ;; ==========================================
          ;; Text Block Backspace Logic
          ;; ==========================================
          (if (not= start end)
            ;; 1. Range Deletion
            (do
              (text-cmd/delete-range !state active-id start (- end start))
              (editor-cmd/focus-block !state active-id start))
            (if (> start 0)
              ;; 2. Normal Backspace (Delete 1 char)
              (text-cmd/delete-range !state active-id (dec start) 1)
              
              ;; 3. Cursor at Offset 0! Merge with or delete previous line.
              (let [root (:root state-val)
                    idx (.indexOf root active-id)]
                (when (> idx 0)
                  (let [prev-id (nth root (dec idx))
                        prev-block (get-in state-val [:blocks prev-id])
                        prev-is-text? (config/text-block-type? cfg (:type prev-block))
                        curr-content (:content block "")]
                    (if prev-is-text?
                      ;; 3A: Merge into previous text block (Deletes empty line inherently)
                      (let [prev-content (:content prev-block "")
                            prev-len (count prev-content)
                            ;; 🌟 核心升级：合并段落时，同时合并并偏移 content-spans！
                            prev-spans (:content-spans prev-block [])
                            curr-spans (:content-spans block [])
                            shifted-curr-spans (mapv (fn [span]
                                                       (-> span
                                                           (update :start + prev-len)
                                                           (update :end + prev-len)))
                                                     curr-spans)
                            merged-spans (vec (concat prev-spans shifted-curr-spans))]
                        (swap! !state
                               (fn [s]
                                 (-> s
                                     (assoc-in [:blocks prev-id :content] (str prev-content curr-content))
                                     (assoc-in [:blocks prev-id :content-spans] merged-spans) ;; 写入合并后的样式
                                     (update :root #(vec (remove #{active-id} %)))
                                     (update :blocks dissoc active-id)
                                     (assoc :active-block-id prev-id)
                                     (assoc-in [:blocks prev-id :selection] (m/TextSelection.collapsed .offset prev-len))))))
                      
                      ;; 3B: Previous is Atomic Block -> Move focus to its end (Offset 1)
                      (editor-cmd/focus-block !state prev-id 1)))))))
          
          ;; ==========================================
          ;; Atomic Block Backspace Logic
          ;; ==========================================
          (if (> start 0)
            ;; Cursor is AFTER the block (offset 1) -> DELETE THE ENTIRE BLOCK
            (let [root (:root state-val)
                  idx (.indexOf root active-id)
                  prev-id (if (> idx 0) (nth root (dec idx)) nil)]
              (swap! !state (fn [s]
                              (let [s-new (-> s
                                              (update :root #(vec (remove #{active-id} %)))
                                              (update :blocks dissoc active-id)
                                              (assoc :active-block-id prev-id))]
                                (if prev-id
                                  (assoc-in s-new [:blocks prev-id :selection] 
                                            (m/TextSelection.collapsed .offset (count (get-in s [:blocks prev-id :content] ""))))
                                  s-new)))))
            ;; Cursor is BEFORE the block (offset 0) -> Just move focus to prev block
            (let [root (:root state-val)
                  idx (.indexOf root active-id)]
              (when (> idx 0)
                (let [prev-id (nth root (dec idx))]
                  (editor-cmd/focus-block !state prev-id (count (get-in state-val [:blocks prev-id :content] "")))))))))
      :else nil)))

;; =============================================================================
;; THE CORE ENGINE FOR ENTER / RETURN
;; =============================================================================
(defn- handle-enter-action [!state cfg]
  (let [state-val @!state
        active-id (:active-block-id state-val)]
    (when active-id
      (let [block (get-in state-val [:blocks active-id])
            block-type (:type block)
            is-text? (config/text-block-type? cfg block-type)
            sel (:selection block)
            offset (if sel (.-extentOffset sel) 0)]
        (if is-text?
          ;; ==========================================
          ;; Standard Text Block: SPLIT instead of \n
          ;; ==========================================
          (do
            ;; 1. Execute the split block transaction
            (text-cmd/split-block! !state active-id offset)
            ;; 2. Move cursor focus to the very beginning (offset 0) of the newly created block
            (let [new-active-id (:active-block-id @!state)]
              (editor-cmd/focus-block !state new-active-id 0)))
          
          ;; ==========================================
          ;; Atomic Block Escape (e.g. Images, References)
          ;; ==========================================
          (let [new-id (str (random-uuid))]
            (swap! !state
                   (fn [s]
                     (let [root (:root s)
                           idx (.indexOf root active-id)
                           insert-idx (if (>= offset 1) (inc idx) idx)
                           new-root (vec (concat (subvec root 0 insert-idx)
                                                 [new-id]
                                                 (subvec root insert-idx)))]
                       (-> s
                           (assoc :root new-root)
                           (assoc-in [:blocks new-id] {:id new-id :type :paragraph :content "" :attributes {}})
                           (assoc :active-block-id new-id)
                           (assoc-in [:blocks new-id :selection] (m/TextSelection.collapsed .offset 0))))))))))))

;; =============================================================================
;; KEYBOARD EVENT INTERCEPTOR
;; =============================================================================
(defn- handle-key-event [cfg* !state _node event]
  (let [ime-res (ime-ctrl/handle-key-event event)]
    (if (= ime-res m.KeyEventResult/handled)
      ime-res
      (let [logical-key (.-logicalKey event)
            is-down? (dart/is? event s/KeyDownEvent)
            
            hw-kb (.-instance s/HardwareKeyboard)
            is-ctrl? (or (.-isControlPressed hw-kb) (.-isMetaPressed hw-kb))
            
            is-up? (= logical-key s.LogicalKeyboardKey/arrowUp)
            is-down-arrow? (= logical-key s.LogicalKeyboardKey/arrowDown)
            is-left? (= logical-key s.LogicalKeyboardKey/arrowLeft)
            is-right? (= logical-key s.LogicalKeyboardKey/arrowRight)
            is-arrow? (or is-up? is-down-arrow? is-left? is-right?)]
        (cond
          (and is-down? is-ctrl? (= logical-key s.LogicalKeyboardKey/keyC))
          (do (clipboard/copy! @!state) m.KeyEventResult/handled)

          (and is-down? is-ctrl? (= logical-key s.LogicalKeyboardKey/keyV))
          (do (clipboard/paste! !state) m.KeyEventResult/handled)

          (and is-down? is-ctrl? (= logical-key s.LogicalKeyboardKey/keyX))
          (do (clipboard/cut! !state editor-cmd/delete-global-selection!) m.KeyEventResult/handled)

          (= logical-key s.LogicalKeyboardKey/escape)
          m.KeyEventResult/handled

          ;; Physical Keyboard Backspace
          (= logical-key s.LogicalKeyboardKey/backspace)
          (if is-down?
            (do
              (handle-backspace-action !state cfg*)
              m.KeyEventResult/handled)
            m.KeyEventResult/handled)

          ;; Physical Keyboard Enter
          (= logical-key s.LogicalKeyboardKey/enter)
          (if is-down?
            (do
              (handle-enter-action !state cfg*)
              m.KeyEventResult/handled)
            m.KeyEventResult/handled)

          (= logical-key s.LogicalKeyboardKey/tab)
          (if is-down?
            (do
              (if (.-isShiftPressed hw-kb)
                (config/run-command cfg* !state :outdent)
                (config/run-command cfg* !state :indent))
              m.KeyEventResult/handled)
            m.KeyEventResult/handled)

          ;; Arrow keys navigation
          is-arrow?
          (if is-down?
            (let [active-id (:active-block-id @!state)]
              (if active-id
                (let [block (get-in @!state [:blocks active-id])
                      sel (:selection block)
                      offset (if sel (.-extentOffset sel) 0)
                      content-len (if (config/text-block-type? cfg* (:type block))
                                    (count (:content block ""))
                                    1)
                      root (:root @!state)
                      idx (.indexOf root active-id)]
                  (cond
                    is-up?
                    (if (> offset 0)
                      (do (editor-cmd/focus-block !state active-id (dec offset))
                          m.KeyEventResult/handled)
                      (if (> idx 0)
                        (let [prev-id (nth root (dec idx))
                              prev-len (count (:content (get-in @!state [:blocks prev-id]) ""))]
                          (editor-cmd/focus-block !state prev-id prev-len)
                          m.KeyEventResult/handled)
                        m.KeyEventResult/handled))

                    is-down-arrow?
                    (if (< offset content-len)
                      (do (editor-cmd/focus-block !state active-id (inc offset))
                          m.KeyEventResult/handled)
                      (if (< idx (dec (count root)))
                        (let [next-id (nth root (inc idx))]
                          (editor-cmd/focus-block !state next-id 0)
                          m.KeyEventResult/handled)
                        m.KeyEventResult/handled))

                    is-left?
                    (if (> idx 0)
                      (let [prev-id (nth root (dec idx))
                            prev-len (count (:content (get-in @!state [:blocks prev-id]) ""))
                            new-offset (min offset prev-len)]
                        (editor-cmd/focus-block !state prev-id new-offset)
                        m.KeyEventResult/handled)
                      m.KeyEventResult/handled)

                    is-right?
                    (if (< idx (dec (count root)))
                      (let [next-id (nth root (inc idx))
                            next-len (count (:content (get-in @!state [:blocks next-id]) ""))
                            new-offset (min offset next-len)]
                        (editor-cmd/focus-block !state next-id new-offset)
                        m.KeyEventResult/handled)
                      m.KeyEventResult/handled)

                    :else m.KeyEventResult/ignored))
                m.KeyEventResult/handled))
            m.KeyEventResult/handled)

          :else m.KeyEventResult/ignored)))))

;; =============================================================================
;; MAIN EDITOR WIDGET
;; =============================================================================
(defn mongol-editor
  "Highly encapsulated Mongolian rich text editor."
  [!state editor-config & {:keys [leading-widget]}]
  (let [cfg (config/merge-config defaults/full-default-config editor-config)]
    (f/widget
     :managed [editor-focus-node (m/FocusNode)]
     :watch [state !state]
     
     (let [content-list (m/ListView
                         .scrollDirection m.Axis/horizontal
                         .padding (m.EdgeInsets/all 20.0)
                         .children (mapv (fn [i]
                                           (let [id (nth (:root state) i)]
                                             (m/KeyedSubtree
                                              .key (m/ValueKey. id)
                                              .child (m/Padding
                                                      .padding (m.EdgeInsets/only .right 12.0)
                                                      .child (node-view/block-node id !state i cfg)))))
                                         (range (count (:root state)))))
           
           clickable-content (m/Listener
                              .behavior m.HitTestBehavior/translucent
                              .onPointerDown (fn [_]
                                               (when-not (.-hasFocus editor-focus-node)
                                                 (.requestFocus editor-focus-node)))
                              .child
                              (m/GestureDetector
                               .behavior m.HitTestBehavior/translucent
                               .onTap (fn []
                                        (when-not (:active-block-id @!state)
                                          (when-let [last-id (last (:root @!state))]
                                            (let [len (count (get-in @!state [:blocks last-id :content] ""))]
                                              (editor-cmd/focus-block !state last-id len)))))
                               .child content-list))
           
           core-input-area (m/Focus
                            .focusNode editor-focus-node
                            .onFocusChange 
                            (fn [has-focus?]
                              (if has-focus?
                                (do
                                  (s/SystemChannels.textInput.invokeMethod "TextInput.hide")
                                  (when-let [active-id (:active-block-id @!state)]
                                    (ime/attach! !state active-id)))
                                (do
                                  (ime/detach!)
                                  (swap! !state assoc :active-block-id nil :cursor-visible false))))
                            .onKeyEvent (fn [node event] (handle-key-event cfg !state node event))
                            .child clickable-content)

           combined-input-area (m/Row
                                .crossAxisAlignment m.CrossAxisAlignment/start
                                .children
                                [(if leading-widget
                                   leading-widget
                                   (m/SizedBox.shrink))
                                 (m/Expanded .child core-input-area)])]

       (if (is-mobile?)
         (f/widget
          :let [info (merge options/keyboard-option {:keyboard/mongol-font-family "OyunQaganTig"
                                                     :keyboard/key-container-color m/Colors.grey.shade500
                                                     :keyboard/font-size 16})]
          :bind {:info info}
          (m/Column
           .children
           [(m/Expanded
             .child
             (m/Stack
              .children
              [combined-input-area
               (if (or (:active-block-id state) (:external-keyboard-delegate state))
                 (keyboard/candidates nil)
                 (m/SizedBox.shrink))]))

            (if (or (:active-block-id state) (:external-keyboard-delegate state))
              (keyboard/keyboard
               {:custom-fns
                {:on-return
                 (fn []
                   (cond
                     (:external-keyboard-delegate @!state)
                     (when-let [on-return-fn (:on-return (:external-keyboard-delegate @!state))]
                       (on-return-fn))

                     :else
                     (handle-enter-action !state cfg)))

                 :on-backspace
                 (fn []
                   (let [candidates (:keyboard/candidates-list @vk-state/state)]
                     (if (seq candidates)
                       (vk-action/clear-candidates)
                       (cond
                         (:external-keyboard-delegate @!state)
                         (when-let [on-backspace-fn (:on-backspace (:external-keyboard-delegate @!state))]
                           (on-backspace-fn))
                         
                         :else
                         (handle-backspace-action !state cfg)))))}})
              (m/SizedBox.shrink))]))

         (overlay/ime-global-wrapper
          (m/CallbackShortcuts
           .bindings (config/shortcut-bindings cfg !state)
           .child combined-input-area) "main-page-ime-wrapper"))))))