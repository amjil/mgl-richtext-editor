(ns rich-editor.components.editor
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["package:flutter/foundation.dart" :as foundation]
            [cljd.flutter :as f]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.services.ime-service :as ime]
            [rich-editor.services.history-service :as history]
            [rich-editor.config :as config]
            [rich-editor.defaults :as defaults]
            [rich-editor.components.node-view :as node-view]
            [rich-editor.model.selection :as sel]
            [rich-editor.model.node :as node]
            [virtual-keyboard.keyboard :as keyboard]
            [virtual-keyboard.keyboard-state :as vk-state]
            [virtual-keyboard.keyboard-action :as vk-action]
            [virtual-keyboard.options :as options]
            [shared-ime.controller :as ime-ctrl]
            [shared-ime.overlay-view :as overlay]))

(defn is-mobile? []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform foundation.TargetPlatform/android)
        (= platform foundation.TargetPlatform/iOS))))

(defn- adopt-orphans [state prev-id orphans]
  (reduce (fn [s oid]
            (assoc-in s [:blocks oid :parent] prev-id))
          (update-in state [:blocks prev-id :children] #(vec (concat (or % []) orphans)))
          orphans))

(defn- merge-text-blocks [state prev-id active-id]
  (let [prev (get-in state [:blocks prev-id])
        curr (get-in state [:blocks active-id])
        prev-content (:content prev "")
        curr-content (:content curr "")
        prev-len (count prev-content)
        shifted-curr (mapv (fn [span]
                             (-> span
                                 (update :start + prev-len)
                                 (update :end + prev-len)))
                           (:content-spans curr []))
        orphans (or (:children curr) [])]
    (-> state
        (assoc-in [:blocks prev-id :content] (str prev-content curr-content))
        (assoc-in [:blocks prev-id :content-spans] (vec (concat (:content-spans prev []) shifted-curr)))
        (adopt-orphans prev-id orphans)
        (node/remove-id-from-tree active-id)
        (update :blocks dissoc active-id)
        (assoc :active-block-id prev-id)
        (assoc-in [:blocks prev-id :selection] (m/TextSelection.collapsed .offset prev-len)))))

(defn- collect-descendants [state id]
  (letfn [(walk [cid]
            (cons cid (mapcat walk (get-in state [:blocks cid :children] []))))]
    (vec (mapcat walk (get-in state [:blocks id :children] [])))))

(defn- delete-block [state active-id prev-id]
  (let [desc (collect-descendants state active-id)
        state (-> state
                  (node/remove-id-from-tree active-id)
                  (update :blocks #(apply dissoc % (cons active-id desc)))
                  (assoc :active-block-id prev-id))]
    (if prev-id
      (assoc-in state [:blocks prev-id :selection]
                (m/TextSelection.collapsed .offset (count (get-in state [:blocks prev-id :content] ""))))
      state)))

(defn- split-block-at-cursor-impl! [!state block-id]
  (let [sel (get-in @!state [:blocks block-id :selection])
        offset (if sel (max 0 (.-extentOffset sel)) 0)]
    (text-cmd/split-block! !state block-id offset)
    (:active-block-id @!state)))

(defn- merge-with-previous-impl! [!state block-id]
  (let [state-val @!state
        cfg (or (:editor-config state-val) defaults/full-default-config)
        prev-id (sel/prev-id state-val block-id)
        prev-block (when prev-id (get-in state-val [:blocks prev-id]))]
    (when (and prev-id prev-block (config/text-block-type? cfg (:type prev-block)))
      (let [new-offset (count (:content prev-block ""))]
        (swap! !state (fn [s] (-> s (history/push-history false) (merge-text-blocks prev-id block-id))))
        {:prev-id prev-id :new-offset new-offset}))))

(defn- delete-cross-block-impl! [!state _g-sel]
  (editor-cmd/delete-global-selection! !state)
  (let [s @!state
        id (:active-block-id s)
        sel (when id (get-in s [:blocks id :selection]))]
    {:focus-block id
     :offset (if sel (.-extentOffset sel) 0)}))

(def ^:private builtin-block-ops
  {:split-block-at-cursor! split-block-at-cursor-impl!
   :merge-with-previous! merge-with-previous-impl!
   :delete-cross-block-selection! delete-cross-block-impl!})

(defn- resolve-editor-config [editor-config]
  (let [user (or editor-config {})
        with-ops (if (:block-ops user) user (assoc user :block-ops builtin-block-ops))]
    (config/merge-config defaults/full-default-config with-ops)))

;; =============================================================================
;; THE CORE ENGINE FOR BACKSPACE
;; =============================================================================
(defn- handle-backspace-action [!state cfg]
  (let [state-val @!state
        global-sel (:global-selection state-val)
        active-id (:active-block-id state-val)]
    (cond
      global-sel
      (editor-cmd/delete-global-selection! !state)

      active-id
      (let [block (get-in state-val [:blocks active-id])
            block-type (:type block)
            is-text? (config/text-block-type? cfg block-type)
            sel (:selection block)
            start (if sel (min (.-baseOffset sel) (.-extentOffset sel)) 0)
            end (if sel (max (.-baseOffset sel) (.-extentOffset sel)) 0)
            prev-id (sel/prev-id state-val active-id)]
        (if is-text?
          (if (not= start end)
            (do
              (text-cmd/delete-range !state active-id start (- end start))
              (editor-cmd/focus-block !state active-id start))
            (if (> start 0)
              (do
                (text-cmd/delete-range !state active-id (dec start) 1)
                (ime/sync-block! !state active-id)
                (when (empty? (get-in @!state [:blocks active-id :content] ""))
                  (editor-cmd/focus-block !state active-id 0)))
              (when prev-id
                (if-let [{:keys [prev-id new-offset]} (merge-with-previous-impl! !state active-id)]
                  (editor-cmd/focus-block !state prev-id new-offset)
                  (let [prev-block (get-in @!state [:blocks prev-id])
                        prev-off (if (config/text-block-type? cfg (:type prev-block))
                                   (count (:content prev-block ""))
                                   1)]
                    (editor-cmd/focus-block !state prev-id prev-off))))))
          (if (> start 0)
            (swap! !state (fn [s] (-> s (history/push-history false) (delete-block active-id prev-id))))
            (when prev-id
              (editor-cmd/focus-block !state prev-id (count (get-in state-val [:blocks prev-id :content] "")))))))
      :else nil)))

;; =============================================================================
;; THE CORE ENGINE FOR ENTER / RETURN
;; =============================================================================
(defn- handle-enter-action [!state cfg]
  (let [state-val @!state
        active-id (:active-block-id state-val)]
    (when active-id
      (let [block (get-in state-val [:blocks active-id])
            block-type (:type block)
            is-text? (config/text-block-type? cfg block-type)
            sel (:selection block)
            offset (if sel (.-extentOffset sel) 0)]
        (if is-text?
          (let [split! (or (get-in @!state [:editor-config :block-ops :split-block-at-cursor!])
                           split-block-at-cursor-impl!)
                new-id (split! !state active-id)]
            (when new-id
              (editor-cmd/focus-block !state new-id 0)))
          (let [new-id (str (random-uuid))
                parent (node/find-parent-id state-val active-id)]
            (swap! !state
                   (fn [s]
                     (let [s (history/push-history s false)
                           nb (cond-> {:id new-id :type :paragraph :content "" :attributes {} :children []}
                                (and parent (not= parent :root)) (assoc :parent parent))
                           s (assoc-in s [:blocks new-id] nb)
                           s (if (>= offset 1)
                               (node/insert-sibling-after s active-id new-id)
                               (node/insert-sibling-before s active-id new-id))]
                       (-> s
                           (assoc :active-block-id new-id)
                           (assoc-in [:blocks new-id :selection] (m/TextSelection.collapsed .offset 0))))))))))))

;; =============================================================================
;; KEYBOARD EVENT INTERCEPTOR
;; =============================================================================
(defn- handle-key-event [cfg* !state _node event]
  (let [ime-res (ime-ctrl/handle-key-event event)]
    (if (= ime-res m.KeyEventResult/handled)
      ime-res
      (let [logical-key (.-logicalKey event)
            is-down? (dart/is? event s/KeyDownEvent)
            hw-kb (.-instance s/HardwareKeyboard)
            is-up? (= logical-key s.LogicalKeyboardKey/arrowUp)
            is-down-arrow? (= logical-key s.LogicalKeyboardKey/arrowDown)
            is-left? (= logical-key s.LogicalKeyboardKey/arrowLeft)
            is-right? (= logical-key s.LogicalKeyboardKey/arrowRight)
            is-arrow? (or is-up? is-down-arrow? is-left? is-right?)]
        (cond
          (= logical-key s.LogicalKeyboardKey/escape) m.KeyEventResult/handled

          (= logical-key s.LogicalKeyboardKey/backspace)
          (if is-down? (do (handle-backspace-action !state cfg*) m.KeyEventResult/handled) m.KeyEventResult/handled)

          (= logical-key s.LogicalKeyboardKey/enter)
          (if is-down? (do (handle-enter-action !state cfg*) m.KeyEventResult/handled) m.KeyEventResult/handled)

          (= logical-key s.LogicalKeyboardKey/tab)
          (if is-down?
            (do (if (.-isShiftPressed hw-kb) (config/run-command cfg* !state :outdent) (config/run-command cfg* !state :indent)) m.KeyEventResult/handled)
            m.KeyEventResult/handled)

          is-arrow?
          (if is-down?
            (let [active-id (:active-block-id @!state)]
              (if active-id
                (let [block (get-in @!state [:blocks active-id])
                      sel (:selection block)
                      offset (if sel (.-extentOffset sel) 0)
                      content-len (if (config/text-block-type? cfg* (:type block)) (count (:content block "")) 1)
                      prev-id (sel/prev-id @!state active-id)
                      next-id (sel/next-id @!state active-id)]
                  (cond
                    is-up? (if (> offset 0)
                             (do (editor-cmd/focus-block !state active-id (dec offset)) m.KeyEventResult/handled)
                             (if prev-id
                               (let [prev-len (count (:content (get-in @!state [:blocks prev-id]) ""))]
                                 (editor-cmd/focus-block !state prev-id prev-len)
                                 m.KeyEventResult/handled)
                               m.KeyEventResult/handled))
                    is-down-arrow? (if (< offset content-len)
                                     (do (editor-cmd/focus-block !state active-id (inc offset)) m.KeyEventResult/handled)
                                     (if next-id
                                       (do (editor-cmd/focus-block !state next-id 0) m.KeyEventResult/handled)
                                       m.KeyEventResult/handled))
                    is-left? (if prev-id
                               (let [prev-len (count (:content (get-in @!state [:blocks prev-id]) ""))
                                     new-offset (min offset prev-len)]
                                 (editor-cmd/focus-block !state prev-id new-offset)
                                 m.KeyEventResult/handled)
                               m.KeyEventResult/handled)
                    is-right? (if next-id
                                (let [next-len (count (:content (get-in @!state [:blocks next-id]) ""))
                                      new-offset (min offset next-len)]
                                  (editor-cmd/focus-block !state next-id new-offset)
                                  m.KeyEventResult/handled)
                                m.KeyEventResult/handled)
                    :else m.KeyEventResult/ignored))
                m.KeyEventResult/handled))
            m.KeyEventResult/handled)

          :else m.KeyEventResult/ignored)))))

;; =============================================================================
;; MAIN EDITOR WIDGET
;; =============================================================================
(defn mongol-editor
  "Highly encapsulated Mongolian rich text editor."
  [!state editor-config & {:keys [leading-widget toolbar]}]
  (let [cfg (resolve-editor-config editor-config)]
    (when (nil? (get-in @!state [:editor-config :block-ops]))
      (swap! !state assoc :editor-config cfg))
    (f/widget
     :managed [editor-focus-node (m/FocusNode)]
     :watch [state !state]
     
     (let [_ (node-view/sync-text-keys! state)
           shortcut-child (fn [child]
                            (m/CallbackShortcuts
                             .bindings (config/shortcut-bindings cfg !state)
                             .child child))

           content-list (m/ListView
                         .scrollDirection m.Axis/horizontal
                         .padding (m.EdgeInsets/all 20.0)
                         .children (mapv (fn [i]
                                           (let [id (nth (:root state) i)]
                                             (m/KeyedSubtree
                                              .key (m/ValueKey. id)
                                              .child (m/Padding
                                                      .padding (m.EdgeInsets/only .right 12.0)
                                                      .child (node-view/block-node id !state i cfg)))))
                                         (range (count (:root state)))))

           clickable-content (m/Listener
                              .behavior m.HitTestBehavior/translucent
                              .onPointerDown (fn [_]
                                               (.requestFocus editor-focus-node))
                              
                              .onPointerUp (fn [_]
                                             (m/WidgetsBinding.instance.addPostFrameCallback
                                              (fn [_]
                                                (try 
                                                  (.requestFocus editor-focus-node) 
                                                  (catch Exception _)))))
                              .child
                              (m/GestureDetector
                               .behavior m.HitTestBehavior/translucent
                               .onTap (fn []
                                        (let [s @!state
                                              id (or (:active-block-id s) (last (:root s)))]
                                          (when id
                                            (let [sel (get-in s [:blocks id :selection])
                                                  len (count (get-in s [:blocks id :content] ""))
                                                  off (if (and sel (.-isValid sel))
                                                        (max 0 (min (.-extentOffset sel) len))
                                                        len)]
                                              (editor-cmd/focus-block !state id off)))))
                               .child content-list))
           
           core-input-area (m/Focus
                            .focusNode editor-focus-node
                            .onFocusChange
                            (fn [has-focus?]
                              (if has-focus?
                                (do
                                  (swap! !state assoc :external-keyboard-delegate nil :cursor-visible true)

                                  (when-let [target-id (or (:active-block-id @!state) (last (:root @!state)))]
                                    (let [sel (get-in @!state [:blocks target-id :selection])
                                          offset (if sel (.-extentOffset sel) (count (get-in @!state [:blocks target-id :content] "")))]
                                      (editor-cmd/focus-block !state target-id offset))))
                                (ime/schedule-detach-if-unfocused! editor-focus-node !state)))
                            .onKeyEvent (fn [node event] (handle-key-event cfg !state node event))
                            .child clickable-content)

           combined-input-area (shortcut-child
                                (m/Row
                                 .crossAxisAlignment m.CrossAxisAlignment/start
                                 .children
                                 [(if leading-widget
                                    leading-widget
                                    (m/SizedBox.shrink))
                                  (m/Expanded .child core-input-area)]))]

       (if (is-mobile?)
         (f/widget
          :let [info (merge options/keyboard-option {:keyboard/mongol-font-family "OyunQaganTig"
                                                     :keyboard/key-container-color m/Colors.grey.shade500
                                                     :keyboard/font-size 16})]
          :bind {:info info}
          (m/Column
           .children
           [(m/Expanded
             .child
             (m/Stack
              .children
              [combined-input-area
               (if (or (:active-block-id state) (:external-keyboard-delegate state))
                 (keyboard/candidates nil)
                 (m/SizedBox.shrink))]))

            (if toolbar toolbar (m/SizedBox.shrink))

            (if (or (:active-block-id state) (:external-keyboard-delegate state))
              (keyboard/keyboard
               {:custom-fns
                {:on-return
                 (fn []
                   (cond
                     (:external-keyboard-delegate @!state)
                     (when-let [on-return-fn (:on-return (:external-keyboard-delegate @!state))]
                       (on-return-fn))

                     :else
                     (handle-enter-action !state cfg)))

                 :on-backspace
                 (fn []
                   (let [candidates (:keyboard/candidates-list @vk-state/state)]
                     (if (seq candidates)
                       (vk-action/clear-candidates)
                       (cond
                         (:external-keyboard-delegate @!state)
                         (when-let [on-backspace-fn (:on-backspace (:external-keyboard-delegate @!state))]
                           (on-backspace-fn))
                         
                         :else
                         (handle-backspace-action !state cfg)))))}})
              (m/SizedBox.shrink))]))

         ;; Desktop layout
         (overlay/ime-global-wrapper
          (m/Column
           .children
           [(m/Expanded .child combined-input-area)
            (if toolbar toolbar (m/SizedBox.shrink))])
          "main-page-ime-wrapper"))))))