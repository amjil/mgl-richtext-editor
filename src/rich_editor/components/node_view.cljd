(ns rich-editor.components.node-view
  "Handles the UI rendering, gesture detection, and local selection logic for individual text and atomic blocks."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/gestures.dart" :as g]
            ["package:flutter/foundation.dart" :as foundation]
            [cljd.flutter :as f]
            ["package:mgl_editor_core/mgl_selectable_text.dart" :as native] 
            [shared-ime.controller :as ime-ctrl]
            [rich-editor.rendering.text-renderer :as text-renderer]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.model.selection :as sel]
            [rich-editor.config :as config]))

;; Helper to detect mobile environment
(defn is-mobile? []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform foundation.TargetPlatform/android)
        (= platform foundation.TargetPlatform/iOS))))

(defonce !block-text-keys (atom {}))

(defn sync-text-keys!
  "Drop GlobalKeys for blocks that no longer exist."
  [state]
  (let [live (set (keys (:blocks state {})))]
    (swap! !block-text-keys
           (fn [m]
             (if (every? #(contains? live %) (keys m))
               m
               (into {} (filter (fn [[k _]] (contains? live k)) m)))))))

(defn get-caret-global-offset
  "Return global Offset for the caret at character offset in the block identified by text-key, or nil."
  [text-key caret-offset]
  (native/MglSelectableText.getGlobalOffsetForCaret text-key (int caret-offset)))

(defn- get-safe-offset [state id text-key global-pos]
  (let [pos (native/MglSelectableText.getPositionAtOffset text-key global-pos)
        raw-offset (.-offset pos)
        content-len (count (get-in state [:blocks id :content] ""))]
    (max 0 (min raw-offset content-len))))

(defn- ordered-list-number
  [state id root-index]
  (when (= (get-in state [:blocks id :attributes :list-type]) :ordered)
    (let [root (:root state)
          start (loop [i (int (or root-index 0))]
                  (if (or (<= i 0)
                          (not= :list-item (get-in state [:blocks (nth root (dec i)) :type])))
                    i
                    (recur (dec i))))]
      (inc (- (int (or root-index 0)) start)))))

(defn- get-text-key [id]
  (get (swap! !block-text-keys
              (fn [m] (if (contains? m id) m (assoc m id (m/GlobalKey.)))))
       id))

(defn- mgl-separator? 
  "Determines if a character is a word boundary.
   Crucially EXCLUDES Mongolian specific modifiers like NNBSP (0x202F), MVS (0x180E), 
   and FVS1-3 (0x180B-0x180D) so that inflected words are selected as a single unit."
  [^String s idx]
  (let [code (.codeUnitAt s idx)]
    (or (<= code 31)     ;; Control chars
        (== code 0x0020) ;; Standard space
        (== code 0x3000) ;; Ideographic space
        (== code 0x202E) ;; RTL override (formatting)
        (contains? #{"." "," "!" "?" "：" "；" "“" "”" "（" "）" "(" ")" "《" "》" "〈" "〉" "、" "\n" "\t"} 
                   (subs s idx (inc idx))))))

(defn- get-word-boundaries 
  "Calculates the [start, end] boundaries of the word under the given offset."
  [^String text offset]
  (let [len (count text)
        safe-off (max 0 (min offset len))]
    (if (and (< safe-off len) (mgl-separator? text safe-off))
      [safe-off safe-off]
      (let [start (loop [i (dec safe-off)]
                    (if (or (< i 0) (mgl-separator? text i))
                      (inc i)
                      (recur (dec i))))
            end (loop [i safe-off]
                  (if (or (>= i len) (mgl-separator? text i))
                    i
                    (recur (inc i))))]
        [start end]))))

(defn- flatten-block-ids
  "Document order: each root, then its descendants (depth-first)."
  [state]
  (let [blocks (:blocks state)]
    (letfn [(walk [id]
              (cons id (mapcat walk (get-in blocks [id :children] []))))]
      (mapcat walk (:root state)))))

(defn- find-block-at-offset [state global-offset cfg]
  (reduce
   (fn [acc id]
     (if-let [text-key (get @!block-text-keys id)]
       (if-let [ctx (.-currentContext text-key)]
         (try
           (let [^m/RenderBox rb (.findRenderObject ctx)
                 local-pos (.globalToLocal rb global-offset)
                 size (.-size rb)]
             ;; Give a generous hit-test area for mobile fat-finger selection
             (if (and (>= (.-dx local-pos) -30.0)
                      (<= (.-dx local-pos) (+ (.-width size) 30.0)))
               (let [block-type (:type (get-in state [:blocks id]))
                     is-text? (config/text-block-type? cfg block-type)]
                 (if is-text?
                   (let [pos (native/MglSelectableText.getPositionAtOffset text-key global-offset)
                         content-len (count (get-in state [:blocks id :content] ""))
                         safe-off (max 0 (min (.-offset pos) content-len))]
                     (reduced {:id id :offset safe-off}))
                   ;; Atomic Block drag logic (split bounding box in half)
                   (let [local-y (.-dy local-pos)
                         height (.-height size)
                         safe-off (if (< local-y (/ height 2.0)) 0 1)]
                     (reduced {:id id :offset safe-off}))))
               acc))
           (catch Exception _ _st
             acc))
         acc)
       acc))
   nil
   (flatten-block-ids state)))

(defn- clamp-selection [content-len selection]
  (if (or (nil? selection) (not (.-isValid selection)))
    (m/TextSelection.collapsed .offset 0)
    (m/TextSelection. .baseOffset (max 0 (min (.-baseOffset selection) content-len))
                      .extentOffset (max 0 (min (.-extentOffset selection) content-len)))))

(defn- compute-selection [state id cfg]
  (let [g-sel (:global-selection state)
        local-sel (get-in state [:blocks id :selection])]
    (if (and g-sel (:start g-sel) (:end g-sel))
      (let [n-sel (sel/normalize state g-sel)
            start-id (get-in n-sel [:start :id])
            end-id (get-in n-sel [:end :id])
            start-off (get-in n-sel [:start :offset])
            end-off (get-in n-sel [:end :offset])
            cmp-start (sel/compare-block-order state id start-id)
            cmp-end (sel/compare-block-order state id end-id)
            ;; Atomic blocks conceptually have length 1 for selection purposes
            content-len (if (config/text-block-type? cfg (:type (get-in state [:blocks id])))
                          (count (get-in state [:blocks id :content] ""))
                          1)]
        (cond
          (or (< cmp-start 0) (> cmp-end 0)) nil
          (and (= cmp-start 0) (= cmp-end 0)) (clamp-selection content-len (m/TextSelection. .baseOffset start-off .extentOffset end-off))
          (= cmp-start 0) (clamp-selection content-len (m/TextSelection. .baseOffset start-off .extentOffset content-len))
          (= cmp-end 0) (clamp-selection content-len (m/TextSelection. .baseOffset 0 .extentOffset end-off))
          :else (clamp-selection content-len (m/TextSelection. .baseOffset 0 .extentOffset content-len))))
      (clamp-selection (if (config/text-block-type? cfg (:type (get-in state [:blocks id])))
                         (count (get-in state [:blocks id :content] ""))
                         1)
                       local-sel))))

(defonce !ordered-ids-cache (atom nil))

(defn- cached-ordered-ids [state]
  (let [c @!ordered-ids-cache]
    (if (identical? (:state c) state)
      (:ids c)
      (let [ids (vec (sel/get-all-ordered-ids state))]
        (reset! !ordered-ids-cache {:state state :ids ids})
        ids))))

(defn- block-in-selection? [ordered-ids id start-id end-id]
  (let [idx (.indexOf ordered-ids id)
        sidx (.indexOf ordered-ids start-id)
        eidx (.indexOf ordered-ids end-id)]
    (and (>= idx 0) (>= sidx 0) (>= eidx 0)
         (>= idx (min sidx eidx))
         (<= idx (max sidx eidx)))))

(defn- block-render-snapshot
  "Slice of editor state that this block's widget actually paints.
   Typing in another block leaves this map equal, so :watch skips rebuild."
  [state id root-index]
  (let [block (get-in state [:blocks id])
        g-sel (:global-selection state)
        start-id (get-in g-sel [:start :id])
        end-id (get-in g-sel [:end :id])
        active? (= (:active-block-id state) id)
        in-sel? (boolean
                 (and start-id end-id
                      (block-in-selection? (cached-ordered-ids state) id start-id end-id)))]
    {:block block
     :in-sel? in-sel?
     :is-sel-start? (boolean (= id start-id))
     :is-sel-end? (boolean (= id end-id))
     :g-start-off (when (= id start-id) (get-in g-sel [:start :offset]))
     :g-end-off (when (= id end-id) (get-in g-sel [:end :offset]))
     :is-active active?
     :cursor-visible (boolean (and active? (:cursor-visible state) (nil? g-sel)))
     :list-num (ordered-list-number state id root-index)}))

(defn block-node
  "Main rendering function for an individual block node (Text or Atomic)."
  ([id !state] (block-node id !state nil nil))
  ([id !state root-index] (block-node id !state root-index nil))
  ([id !state root-index editor-config]
   (let [cfg (or editor-config config/default-config)
         text-key (get-text-key id)]
     (sync-text-keys! @!state)
     (f/widget
      :watch [state !state]
      (let [snap (block-render-snapshot state id root-index)
            block (:block snap)
            block-type (:type block)
            is-text? (config/text-block-type? cfg block-type)
            selection (compute-selection state id cfg)

            is-active (boolean
                       (or (:is-active snap)
                           (and (:in-sel? snap) selection (not (.-isCollapsed selection)))))
            cursor-visible (boolean (:cursor-visible snap))

            is-mobile-env (boolean (is-mobile?))
            has-valid-sel (boolean (and selection (not (.-isCollapsed selection))))

            show-caret-handle (boolean (and is-mobile-env cursor-visible))
            show-start-handle (boolean (and is-mobile-env has-valid-sel
                                            (or (not (:in-sel? snap))
                                                (:is-sel-start? snap))))
            show-end-handle (boolean (and is-mobile-env has-valid-sel
                                          (or (not (:in-sel? snap))
                                              (:is-sel-end? snap))))

            style (config/get-block-style cfg block-type)
            indent-level (get-in block [:attributes :indent] 0)
            indent-padding (* indent-level 32.0)

            ;; Post-frame callback to update IME caret position for floating keyboards
            _ (when (and is-active cursor-visible)
                (-> m/WidgetsBinding.instance
                    (.addPostFrameCallback
                     (fn [_]   
                       (try
                         (let [offset (if selection (.-extentOffset selection) 0)]
                           (when-let [global-pos (get-caret-global-offset text-key offset)]
                             (ime-ctrl/update-caret-offset! global-pos)))
                         (catch Exception _)))))
                nil)]

        (if is-text?
          ;; ==========================================
          ;; 1. TEXT BLOCKS (Paragraphs, Headings, etc.)
          ;; ==========================================
          (m/GestureDetector
           .behavior m.HitTestBehavior/translucent
           .dragStartBehavior g/DragStartBehavior.down

           .onTapUp
           (fn [^m/TapUpDetails details]
             (swap! !state dissoc :global-selection)
             (let [global-pos (.globalPosition details)
                   offset (get-safe-offset @!state id text-key global-pos)
                   content (get-in @!state [:blocks id :content] "")
                   wiki-target (when-let [f (:wiki-target-at cfg)]
                                 (f content offset))
                   on-link (:on-link-tap cfg)]
               (if (and wiki-target on-link)
                 (on-link wiki-target)
                 (editor-cmd/focus-block !state id offset))))

           .onLongPressStart
           (fn [^m/LongPressStartDetails details] 
             (swap! !state dissoc :global-selection)
             (let [offset (get-safe-offset @!state id text-key (.globalPosition details))
                   text (get-in @!state [:blocks id :content] "")
                   [start end] (get-word-boundaries text offset)]
               (if (= start end)
                 (editor-cmd/focus-block !state id offset)
                 (swap! !state assoc :global-selection {:start {:id id :offset start}
                                                        :end   {:id id :offset end}}))))

           .onPanStart
           (fn [^m/DragStartDetails details]
             (swap! !state dissoc :global-selection)
             (let [offset (get-safe-offset @!state id text-key (.globalPosition details))]
               (swap! !state assoc :global-selection {:start {:id id :offset offset}
                                                      :end   {:id id :offset offset}})))

           .onPanUpdate
           (fn [^m/DragUpdateDetails details]
             (when-let [target (find-block-at-offset @!state (.globalPosition details) cfg)]
               (swap! !state assoc-in [:global-selection :end] target)))

           .child
           (m/Padding
            .padding (m.EdgeInsets/only .top (+ 4.0 indent-padding) .left 4.0 .right 4.0 .bottom 4.0)
            .child
            (let [span-builder (or (:text-span-builder cfg)
                                   text-renderer/build-rich-text-span)
                  text-span (span-builder (:content block)
                                          (:content-spans block [])
                                          style
                                          cfg)
                  text-widget (m/ExcludeFocus
                               .child
                               (native/MglSelectableText.
                                .textKey text-key
                                .textSpan text-span
                                .selection selection
                                .isFocused is-active
                                .showCursor cursor-visible
                                .showLineDivider true
                                .showCaretHandle show-caret-handle
                                .showStartHandle show-start-handle
                                .showEndHandle show-end-handle

                                .onSelectionChanged
                                (fn [^m/TextSelection new-selection]
                                  (if (:global-selection @!state)
                                    (let [start-id (get-in @!state [:global-selection :start :id])
                                          end-id (get-in @!state [:global-selection :end :id])]
                                      (when (= id start-id)
                                        (swap! !state assoc-in [:global-selection :start :offset] (.-baseOffset new-selection)))
                                      (when (= id end-id)
                                        (swap! !state assoc-in [:global-selection :end :offset] (.-extentOffset new-selection))))
                                    (do
                                      (let [len (count (get-in @!state [:blocks id :content] ""))]
                                        (swap! !state assoc-in [:blocks id :selection]
                                               (clamp-selection len new-selection)))
                                      (when (not is-active)
                                        ;; Do NOT call focus-block for range sels — it collapses the selection.
                                        (if (.-isCollapsed new-selection)
                                          (editor-cmd/focus-block !state id (.-extentOffset new-selection))
                                          (swap! !state assoc
                                                 :active-block-id id
                                                 :cursor-visible true))))))))]
              
              ;; TEXT BLOCK WRAPPERS (for warning boxes, quote blocks etc)
              (if-let [wrapper-fn (get-in cfg [:text-block-wrappers block-type])]
                (wrapper-fn text-widget id !state root-index block style cfg)
                
                (cond
                  (= block-type :list-item)
                  (m/Column
                   .crossAxisAlignment m.CrossAxisAlignment/start
                   .children
                   [(m/Padding
                     .padding (m.EdgeInsets/only .top 4.0 .right 8.0)
                     .child (m/Text (if-let [n (:list-num snap)]
                                      (str n ". ")
                                      "• ")
                                    .style (m/TextStyle. .fontSize 20.0 .height 2.0 .color m.Colors/white)))
                    text-widget])

                  (= block-type :blockquote)
                  (m/Container
                   .padding (m.EdgeInsets/only .top 12.0)
                   .decoration (m/BoxDecoration.
                                .border (m/Border. .top (m/BorderSide. .width 4.0 .color m.Colors/grey)))
                   .child text-widget)

                  :else
                  text-widget)))))

          ;; ==========================================
          ;; 2. ATOMIC BLOCKS (Images, Custom Widgets)
          ;; ==========================================
          (let [atomic-content (if-let [custom-render (get-in cfg [:custom-block-renderers block-type])]
                                 (custom-render id !state root-index block style cfg)
                                 (if (= block-type :image)
                                   (let [url (get-in block [:data :url] "")]
                                     (if (seq url)
                                       (m/Image.network url)
                                       (m/SizedBox. .width 120.0 .height 80.0)))
                                   (m/SizedBox.shrink)))
                sel-offset (if selection (.-extentOffset selection) 0)]
            (m/GestureDetector
             .behavior m.HitTestBehavior/translucent
             
             ;; Calculate if user tapped top half (offset 0) or bottom half (offset 1)
             .onTapUp
             (fn [^m/TapUpDetails details]
               (swap! !state dissoc :global-selection)
               (try
                 (let [box ^m/RenderBox (.findRenderObject (.-currentContext text-key))
                       local-y (.-dy (.globalToLocal box (.globalPosition details)))
                       height (.-height (.-size box))
                       new-offset (if (< local-y (/ height 2.0)) 0 1)]
                   (editor-cmd/focus-block !state id new-offset))
                 (catch Exception _)))

             .onPanStart
             (fn [^m/DragStartDetails details]
               (swap! !state dissoc :global-selection)
               (try
                 (let [box ^m/RenderBox (.findRenderObject (.-currentContext text-key))
                       local-y (.-dy (.globalToLocal box (.globalPosition details)))
                       height (.-height (.-size box))
                       new-offset (if (< local-y (/ height 2.0)) 0 1)]
                   (swap! !state assoc :global-selection {:start {:id id :offset new-offset}
                                                          :end   {:id id :offset new-offset}}))
                 (catch Exception _)))

             .onPanUpdate
             (fn [^m/DragUpdateDetails details]
               (when-let [target (find-block-at-offset @!state (.globalPosition details) cfg)]
                 (swap! !state assoc-in [:global-selection :end] target)))

             .child
             (m/Padding
              .padding (m.EdgeInsets/only .top (+ 4.0 indent-padding) .left 4.0 .right 4.0 .bottom 4.0)
              .child
              (m/Container
               .key text-key ;; Bind text-key so we can measure the atomic block bounds
               .decoration (if (and is-active has-valid-sel) 
                             (m/BoxDecoration. .border (m/Border.all .color m.Colors/blue .width 2.0))
                             nil)
               .child
               (m/Stack
                .clipBehavior m.Clip/none
                .children
                [atomic-content
                 ;; Render the horizontal line caret for Atomic blocks
                 (if (and is-active cursor-visible)
                   (m/Positioned
                    .left 0.0 .right 0.0
                    .top (if (== sel-offset 0) -2.0 nil)
                    .bottom (if (> sel-offset 0) -2.0 nil)
                    .child (m/Container .height 2.0 .color m.Colors/blue))
                   (m/SizedBox.shrink))])))))))))))