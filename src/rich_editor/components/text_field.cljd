(ns rich-editor.components.text-field
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/services.dart" :as s]
   ["package:flutter/foundation.dart" :as foundation]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   [shared-ime.controller :as ime-ctrl])) 

(def is-desktop? 
  (let [p foundation/defaultTargetPlatform]
    (or (= p foundation.TargetPlatform/macOS)
        (= p foundation.TargetPlatform/windows)
        (= p foundation.TargetPlatform/linux))))

(defn text-field
  "Autonomous Mongolian text field.
   Supports both Mobile virtual keyboard routing and Desktop physical keyboard IME injection."
  [!shared-state 
   {:keys [controller hint on-changed on-submitted style decoration max-lines min-lines autofocus
           prefix-icon suffix-icon obscure-text focus-node]
    :or {max-lines nil
         min-lines nil
         autofocus false
         obscure-text false
         focus-node nil}}]
  (let [default-font-size 16.0
        default-line-height 1.2]

    (f/widget
     ;; Explicitly assign an ObjectKey based on the controller to prevent GlobalKey collisions
     :key (m/ObjectKey. controller)
     
     :get {{{:flds [onSurface onSurfaceVariant]} .-colorScheme
            {:flds [bodyMedium]} .-textTheme} m/Theme}
     :let [font-size (or (when style (.-fontSize style))
                         (when bodyMedium (.-fontSize bodyMedium))
                         default-font-size)
           line-height (or (when style (.-height style))
                           (when bodyMedium (.-height bodyMedium))
                           default-line-height)
           base-style (let [style-obj (or style (m/TextStyle .color onSurface .fontSize font-size))]
                        (if (.-height style-obj) style-obj (.copyWith style-obj .height line-height)))

           ;; Native hint tracks controller.isEmpty (including IME replace-text!).
           final-decoration (-> (or decoration (m/InputDecoration .border m/InputBorder.none))
                                (.copyWith
                                 .hintText hint
                                 .hintStyle (.copyWith base-style .color (.withOpacity onSurfaceVariant 0.6))
                                 .contentPadding (m/EdgeInsets.symmetric .horizontal 8 .vertical 4)))]

     (m/Focus
      .onFocusChange 
      (fn [has-focus?]
        (if has-focus?
          (do
            ;; Desktop: hide the OS IME; physical keys go through shared-ime.
            ;; Mobile: keep TextInput shown so virtual-keyboard.input-control
            ;; can flip `visible` and the in-app keyboard appears.
            (when is-desktop?
              (s/SystemChannels.textInput.invokeMethod "TextInput.hide"))

            (ime-ctrl/register-client!
             {:replace-text!
              (fn [delete-len insert-str]
                (let [text (.-text controller)
                      sel (.-selection controller)
                      offset (max 0 (.-extentOffset sel))
                      start-idx (max 0 (- offset delete-len))
                      new-text (str (subs text 0 start-idx) insert-str (subs text offset))]
                  (set! (.-value controller)
                        (m/TextEditingValue 
                         .text new-text
                         .selection (m/TextSelection.collapsed .offset (+ start-idx (count insert-str)))))))
              :update-caret! (fn [])
              :get-context-text! 
              (fn []
                (let [text (.-text controller)
                      sel (.-selection controller)
                      offset (max 0 (.-extentOffset sel))]
                  (subs text 0 offset)))})
            
            (swap! !shared-state assoc :external-keyboard-delegate
                   {:on-return 
                    (fn []
                      (if on-submitted
                        (on-submitted (.-text controller))
                        (when focus-node (.unfocus focus-node))))
                    
                    :on-backspace 
                    (fn []
                      (let [text (.-text controller)
                            sel (.-selection controller)
                            base (max 0 (.-baseOffset sel))
                            ext (max 0 (.-extentOffset sel))
                            start (min base ext)
                            end (max base ext)]
                        (if (not= start end)
                          (set! (.-value controller)
                                (m/TextEditingValue 
                                 .text (str (subs text 0 start) (subs text end))
                                 .selection (m/TextSelection.collapsed .offset start)))
                          (when (> start 0)
                            (set! (.-value controller)
                                  (m/TextEditingValue 
                                   .text (str (subs text 0 (dec start)) (subs text end))
                                   .selection (m/TextSelection.collapsed .offset (dec start))))))))}))
          
          (do
            (swap! !shared-state assoc :external-keyboard-delegate nil))))
      
      .onKeyEvent 
      (fn ^m/KeyEventResult [^m/FocusNode node ^s/KeyEvent event]
        (let [res (ime-ctrl/handle-key-event event)]
          (if (= res m.KeyEventResult/handled)
            res
            (if (and is-desktop? (dart/is? event s/KeyDownEvent))
              (let [logical-key (.-logicalKey event)]
                (cond
                  (= logical-key s.LogicalKeyboardKey/escape)
                  m.KeyEventResult/handled

                  (= logical-key s.LogicalKeyboardKey/space)
                  (do
                    (let [text (.-text controller)
                          sel (.-selection controller)
                          base (max 0 (.-baseOffset sel))
                          ext (max 0 (.-extentOffset sel))
                          start (min base ext)
                          end (max base ext)]
                      (set! (.-value controller)
                            (m/TextEditingValue 
                             .text (str (subs text 0 start) " " (subs text end))
                             .selection (m/TextSelection.collapsed .offset (inc start)))))
                    m.KeyEventResult/handled)

                  (= logical-key s.LogicalKeyboardKey/backspace)
                  (do
                    (let [text (.-text controller)
                          sel (.-selection controller)
                          base (max 0 (.-baseOffset sel))
                          ext (max 0 (.-extentOffset sel))
                          start (min base ext)
                          end (max base ext)]
                      (if (not= start end)
                        (set! (.-value controller)
                              (m/TextEditingValue 
                               .text (str (subs text 0 start) (subs text end))
                               .selection (m/TextSelection.collapsed .offset start)))
                        (when (> start 0)
                          (set! (.-value controller)
                                (m/TextEditingValue 
                                 .text (str (subs text 0 (dec start)) (subs text end))
                                 .selection (m/TextSelection.collapsed .offset (dec start)))))))
                    m.KeyEventResult/handled)
                  
                  (= logical-key s.LogicalKeyboardKey/enter)
                  (do
                    ;; 🌟 FIX: Mirror mobile behavior. Do NOT unfocus if on-submitted is provided!
                    (if on-submitted 
                      (on-submitted (.-text controller))
                      (when focus-node (.unfocus focus-node)))
                    m.KeyEventResult/handled)
                  
                  :else m.KeyEventResult/ignored))
              m.KeyEventResult/ignored))))

      .child
      (m/Column
       .mainAxisSize m/MainAxisSize.min
       .children
       [(if prefix-icon
          (m/Padding .padding (m/EdgeInsets.only .bottom 4) .child prefix-icon)
          (m/SizedBox.shrink))

        (m/Flexible
         .fit m/FlexFit.loose
         .child
         (let [field
               (mgl/MongolTextField
                .controller controller
                .focusNode focus-node
                .readOnly is-desktop?
                .showCursor true
                .autofocus autofocus
                .minLines min-lines
                .maxLines max-lines
                .obscureText obscure-text
                .style base-style
                .decoration final-decoration
                .textAlign mgl/MongolTextAlign.top
                .cursorColor onSurface
                .onChanged (fn [text]
                             (when on-changed (on-changed text))))]
           
           (if focus-node
             (m/GestureDetector
              .behavior m/HitTestBehavior.opaque
              .onTap #(.requestFocus focus-node)
              .child field)
             field)))

        (if suffix-icon
          (m/Padding .padding (m/EdgeInsets.only .top 4) .child suffix-icon)
          (m/SizedBox.shrink))])))))