(ns rich-editor.components.editor-root
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            [cljd.flutter :as f]
            [rich-editor.components.node-view :as node-view]
            [rich-editor.config :as config]
            [rich-editor.defaults :as defaults]
            ;; shared-ime controller and overlay view
            [shared-ime.controller :as ime-ctrl]
            [shared-ime.overlay-view :as overlay]))

(defonce !refresh-tick (atom 0))

(defn editor-container
  ([!state] (editor-container !state nil))
  ([!state editor-config]
   (let [cfg (if editor-config (config/merge-config defaults/full-default-config editor-config) defaults/full-default-config)]
     (when (or (nil? (get @!state :editor-config)) editor-config)
       (swap! !state assoc :editor-config cfg))
     (f/widget
      :watch [state !state _ !refresh-tick]
      (let [cfg* (get state :editor-config cfg)]
        
        ;; wrap root with shared-ime candidate panel
        (overlay/ime-global-wrapper
         (m/Focus
          .autofocus true
          ;; delegate key events to FST engine
          .onKeyEvent  (fn [node event]
                         ;; 1. let FST input engine handle first
                         (let [ime-res (ime-ctrl/handle-key-event event)]
                           (if (= ime-res m.KeyEventResult/handled)
                             ime-res
                             ;; 2. if IME didn't handle, we intercept Tab
                             (if (= (.-logicalKey event) s.LogicalKeyboardKey/tab)
                               ;; must handle both KeyDown and KeyUp or focus will still escape
                               (if (dart/is? event s/KeyDownEvent)
                                 (do
                                   ;; check if Shift is pressed
                                   (if (.-isShiftPressed (.-instance s/HardwareKeyboard))
                                     (config/run-command cfg* !state :outdent)
                                     (config/run-command cfg* !state :indent))
                                   m.KeyEventResult/handled)
                                 m.KeyEventResult/handled)
                               ;; other keys: pass through to CallbackShortcuts
                               m.KeyEventResult/ignored))))
          .child
          (m/CallbackShortcuts
           .bindings (config/shortcut-bindings cfg* !state)
           .child
           (m/ListView
            .scrollDirection m.Axis/horizontal
            .padding (m.EdgeInsets/all 20.0)
            .children (mapv (fn [i]
                              (let [id (nth (:root state) i)]
                                (m/KeyedSubtree
                                 .key (m/ValueKey. id)
                                 .child (m/Padding
                                         .padding (m.EdgeInsets/only .right 12.0)
                                         .child (node-view/block-node id !state i cfg*)))))
                            (range (count (:root state)))))))))))))