(ns rich-editor.defaults
  "Contains default configurations, styling logic, and core command handlers for the editor."
  (:require [rich-editor.config :as config]
            [rich-editor.services.history-service :as history]
            [rich-editor.services.clipboard-service :as clipboard]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.model.selection :as sel]))

(defn- toggle-or-apply-style!
  "Range selection: smart toggle via 100% coverage.
   Collapsed caret: pending typing-attributes via toggle-style!."
  [!state attr-key]
  (let [state @!state]
    (if-let [g-sel (:global-selection state)]
      (text-cmd/apply-style-cross-block! !state g-sel attr-key
                                         (if (text-cmd/style-active? state attr-key) nil true))
      (when-let [active-id (:active-block-id state)]
        (let [sel (get-in state [:blocks active-id :selection])]
          (if (and sel (< (.-start sel) (.-end sel)))
            (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) attr-key
                                  (if (text-cmd/style-active? state attr-key) nil true))
            (text-cmd/toggle-style! !state attr-key)))))))

;; =============================================================
;; Default command registry
;; =============================================================

(defn default-command-handlers []
  {;; 🌟 FIX: Global Cross-Block Select All
   :select-all (fn [!state]
                 (let [state-val @!state
                       ordered (vec (sel/get-all-ordered-ids state-val))]
                   (when (seq ordered)
                     (let [first-id (first ordered)
                           last-id (last ordered)
                           last-len (count (get-in state-val [:blocks last-id :content] ""))]
                       (swap! !state assoc :global-selection
                              {:start {:id first-id :offset 0}
                               :end   {:id last-id :offset last-len}})))))
   
   :undo (fn [!state] (history/undo! !state))
   :redo (fn [!state] (history/redo! !state))
   
   :copy (fn [!state] (clipboard/copy! @!state))
   :cut (fn [!state]
          (clipboard/cut! !state editor-cmd/delete-global-selection!))
   :paste (fn [!state]
            (-> (clipboard/paste! !state editor-cmd/delete-global-selection!)
                (.then (fn [focus-info]
                         (when focus-info
                           (editor-cmd/focus-block !state (:focus-block focus-info) (:offset focus-info)))))))

   :bold (fn [!state] (toggle-or-apply-style! !state :bold))
   :italic (fn [!state] (toggle-or-apply-style! !state :italic))
   :underline (fn [!state] (toggle-or-apply-style! !state :underline))
                          
   ;; Block indent (Tab / Shift+Tab) — delegated via :block-ops when provided (e.g. by block-editor)
   :indent (fn [!state]
             (when-let [indent! (get-in @!state [:editor-config :block-ops :indent-selection!])]
               (indent! !state 1)))
   :outdent (fn [!state]
              (when-let [indent! (get-in @!state [:editor-config :block-ops :indent-selection!])]
                (indent! !state -1)))
   
   ;; Reserved link interface
   :link (fn [_state] nil)})

;; =============================================================
;; Config export
;; =============================================================

(def full-default-config
  (assoc config/default-config :commands (default-command-handlers)))

(defn merge-config [user-config]
  (config/merge-config full-default-config user-config))