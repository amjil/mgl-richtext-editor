(ns rich-editor.defaults
  (:require ["package:flutter/services.dart" :as s]
            [rich-editor.config :as config]
            [rich-editor.services.history-service :as history]
            [rich-editor.services.clipboard-service :as clipboard]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.commands.block-commands :as block-cmd]))

(defn default-command-handlers []
  {:select-all (fn [!state]
                 (let [active-id (:active-block-id @!state)]
                   (when active-id
                     (let [content (get-in @!state [:blocks active-id :content])]
                       (swap! !state assoc-in [:blocks active-id :selection]
                              (s/TextSelection. .baseOffset 0 .extentOffset (count content)))))))
   :undo (fn [!state] (history/undo! !state))
   :redo (fn [!state] (history/redo! !state))
   :copy (fn [!state] (clipboard/copy! @!state))
   :cut (fn [!state] 
          (let [state @!state]
            (if-let [g-sel (:global-selection state)]
              (do (block-cmd/delete-cross-block-selection! !state g-sel)
                  (swap! !state dissoc :global-selection))
              (clipboard/cut! @!state))))
   :paste (fn [!state]
            (-> (clipboard/paste! !state)
                (.then (fn [focus-info]
                         (when focus-info
                           (editor-cmd/focus-block !state (:focus-block focus-info) (:offset focus-info)))))))
                           
   ;; 🌟 支持跨块加粗
   :bold (fn [!state]
           (let [state @!state]
             (if-let [g-sel (:global-selection state)]
               (text-cmd/apply-style-cross-block! !state g-sel :bold true)
               (when-let [active-id (:active-block-id state)]
                 (let [sel (get-in state [:blocks active-id :selection])]
                   (when (and sel (< (.-start sel) (.-end sel)))
                     (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :bold true)))))))
                     
   ;; 🌟 支持跨块斜体
   :italic (fn [!state]
             (let [state @!state]
               (if-let [g-sel (:global-selection state)]
                 (text-cmd/apply-style-cross-block! !state g-sel :italic true)
                 (when-let [active-id (:active-block-id state)]
                   (let [sel (get-in state [:blocks active-id :selection])]
                     (when (and sel (< (.-start sel) (.-end sel)))
                       (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :italic true)))))))
                       
   ;; 🌟 支持跨块下划线
   :underline (fn [!state]
                (let [state @!state]
                  (if-let [g-sel (:global-selection state)]
                    (text-cmd/apply-style-cross-block! !state g-sel :underline true)
                    (when-let [active-id (:active-block-id state)]
                      (let [sel (get-in state [:blocks active-id :selection])]
                        (when (and sel (< (.-start sel) (.-end sel)))
                          (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :underline true)))))))
   :link (fn [_state] nil)})

(def full-default-config
  (assoc config/default-config :commands (default-command-handlers)))

(defn merge-config [user-config]
  (config/merge-config full-default-config user-config))