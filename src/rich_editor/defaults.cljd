(ns rich-editor.defaults
  "Contains default configurations, styling logic, and core command handlers for the editor."
  (:require ["package:flutter/services.dart" :as s]
            [rich-editor.config :as config]
            [rich-editor.services.history-service :as history]
            [rich-editor.services.clipboard-service :as clipboard]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.model.selection :as sel]))

;; =============================================================
;; Style detector (production-grade): checks if selection is 100% covered by target style
;; =============================================================

(defn- calc-overlap 
  "Calculate total overlap character count of a style in the given range [start-off, end-off]"
  [start-off end-off spans attr-key]
  (reduce (fn [acc span]
            (if (get-in span [:attrs attr-key])
              ;; Calculate the intersection length of two ranges
              (let [overlap-start (max start-off (:start span))
                    overlap-end   (min end-off (:end span))]
                (if (< overlap-start overlap-end)
                  (+ acc (- overlap-end overlap-start))
                  acc))
              acc))
          0
          spans))

(defn- is-active-style? 
  "Check if current selection has fully applied this style"
  [state attr-key]
  (if-let [g-sel (:global-selection state)]
    ;; Cross-block case: for performance and intuition, check if selected portion of start block is 100% covered
    (let [start-id (get-in g-sel [:start :id])
          start-off (get-in g-sel [:start :offset])
          content-len (count (get-in state [:blocks start-id :content] ""))
          spans (get-in state [:blocks start-id :content-spans] [])
          target-len (- content-len start-off)]
      (if (<= target-len 0) 
        false
        (>= (calc-overlap start-off content-len spans attr-key) target-len)))

    ;; Single-block case: exact calculation
    (when-let [active-id (:active-block-id state)]
      (when-let [sel (get-in state [:blocks active-id :selection])]
        (let [start-off (min (.-baseOffset sel) (.-extentOffset sel))
              end-off (max (.-baseOffset sel) (.-extentOffset sel))
              spans (get-in state [:blocks active-id :content-spans] [])]
          (if (= start-off end-off)
            ;; No text selected, cursor only: detect style of character before cursor
            (> (calc-overlap (max 0 (dec start-off)) start-off spans attr-key) 0)
            
            ;; Text selected: check if 100% covered by this style
            (let [target-len (- end-off start-off)]
              (>= (calc-overlap start-off end-off spans attr-key) target-len))))))))

;; =============================================================
;; Default command registry
;; =============================================================

(defn default-command-handlers []
  {;; 🌟 FIX: Global Cross-Block Select All
   :select-all (fn [!state]
                 (let [state-val @!state
                       ordered (vec (sel/get-all-ordered-ids state-val))]
                   (when (seq ordered)
                     (let [first-id (first ordered)
                           last-id (last ordered)
                           last-len (count (get-in state-val [:blocks last-id :content] ""))]
                       (swap! !state assoc :global-selection
                              {:start {:id first-id :offset 0}
                               :end   {:id last-id :offset last-len}})))))
   
   :undo (fn [!state] (history/undo! !state))
   :redo (fn [!state] (history/redo! !state))
   
   :copy (fn [!state] (clipboard/copy! @!state))
   :cut (fn [!state]
          (clipboard/cut!
           !state
           (fn [!s]
             (if-let [del! (get-in @!s [:editor-config :block-ops :delete-cross-block-selection!])]
               (when-let [g-sel (:global-selection @!s)]
                 (del! !s g-sel)
                 (swap! !s dissoc :global-selection))
               (editor-cmd/delete-global-selection! !s)))))
   :paste (fn [!state]
            (-> (clipboard/paste! !state)
                (.then (fn [focus-info]
                         (when focus-info
                           (editor-cmd/focus-block !state (:focus-block focus-info) (:offset focus-info)))))))
                           
   ;; Smart bold toggle (Ctrl+B)
   :bold (fn [!state]
           (let [state @!state
                 ;; If 100% covered pass nil (remove), otherwise pass true (bold)
                 target-val (if (is-active-style? state :bold) nil true)]
             (if-let [g-sel (:global-selection state)]
               (text-cmd/apply-style-cross-block! !state g-sel :bold target-val)
               (when-let [active-id (:active-block-id state)]
                 (let [sel (get-in state [:blocks active-id :selection])]
                   (when (and sel (< (.-start sel) (.-end sel)))
                     (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :bold target-val)))))))
                     
   ;; Smart italic toggle (Ctrl+I)
   :italic (fn [!state]
             (let [state @!state
                   target-val (if (is-active-style? state :italic) nil true)]
               (if-let [g-sel (:global-selection state)]
                 (text-cmd/apply-style-cross-block! !state g-sel :italic target-val)
                 (when-let [active-id (:active-block-id state)]
                   (let [sel (get-in state [:blocks active-id :selection])]
                     (when (and sel (< (.-start sel) (.-end sel)))
                       (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :italic target-val)))))))
                       
   ;; Smart underline toggle (Ctrl+U)
   :underline (fn [!state]
                (let [state @!state
                      target-val (if (is-active-style? state :underline) nil true)]
                  (if-let [g-sel (:global-selection state)]
                    (text-cmd/apply-style-cross-block! !state g-sel :underline target-val)
                    (when-let [active-id (:active-block-id state)]
                      (let [sel (get-in state [:blocks active-id :selection])]
                        (when (and sel (< (.-start sel) (.-end sel)))
                          (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :underline target-val)))))))
                          
   ;; Block indent (Tab / Shift+Tab) — delegated via :block-ops when provided (e.g. by block-editor)
   :indent (fn [!state]
             (when-let [indent! (get-in @!state [:editor-config :block-ops :indent-selection!])]
               (indent! !state 1)))
   :outdent (fn [!state]
              (when-let [indent! (get-in @!state [:editor-config :block-ops :indent-selection!])]
                (indent! !state -1)))
   
   ;; Reserved link interface
   :link (fn [_state] nil)})

;; =============================================================
;; Config export
;; =============================================================

(def full-default-config
  (assoc config/default-config :commands (default-command-handlers)))

(defn merge-config [user-config]
  (config/merge-config full-default-config user-config))