(ns rich-editor.commands.editor-commands
  (:require [rich-editor.services.ime-service :as ime]
            [rich-editor.services.history-service :as history]
            [rich-editor.services.clipboard-service :as clipboard]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.model.transaction :as tx]
            [rich-editor.model.node :as node]
            [rich-editor.model.selection :as sel]
            [rich-editor.config :as config]
            ["package:flutter/services.dart" :as s]))

;; =============================================================
;; 1. Focus and selection
;; =============================================================

(defn focus-block
  "Activate block: update state and attach IME"
  [!state block-id offset]
  (dart:core/print (str "[input] focus-block entry block-id=" block-id " offset=" offset))
  (let [new-selection (s/TextSelection. .baseOffset offset .extentOffset offset)]
    ;; 1. Update active-id, block selection, cursor visible
    (swap! !state (fn [curr]
                    (-> curr
                        (assoc :active-block-id block-id)
                        (assoc :cursor-visible true)
                        (assoc-in [:blocks block-id :selection] new-selection))))
    (dart:core/print "[input] focus-block state updated")
    ;; 2. No transaction (pure state switch). 3. Attach IME.
    (ime/attach! !state block-id)
    (dart:core/print (str "[input] focus-block ime/attach! done block-id=" block-id))))

(defn blur-all
  "Blur: clear focus and detach IME"
  [!state]
  (swap! !state (fn [s] (assoc s :active-block-id nil :cursor-visible false)))
  (ime/detach!))

;; =============================================================
;; 2. Document ops
;; =============================================================

(defn clear-document
  "Clear document and reset to single empty block. Block type from state's :editor-config :default-block-type.
   Sets active-block-id, cursor-visible and first block selection so cursor is visible; caller must call ime/attach! after first frame."
  [!state]
  (let [block-type (or (some-> (get @!state :editor-config) config/default-block-type) :paragraph)
        new-id (str "b-" (.-millisecondsSinceEpoch (dart:core/DateTime.now)))
        empty-block (node/make-node new-id block-type "")]
    (tx/commit-transaction! !state
      (tx/make-transaction
        :ops [(tx/delete-op :root 0 (count (:root @!state)))
              (tx/insert-op :root 0 [empty-block])]
        :after-selection (s/TextSelection. .baseOffset 0 .extentOffset 0)))
    ;; focus first block so cursor is visible and input works
    (swap! !state (fn [s]
                    (-> s
                        (assoc :active-block-id new-id)
                        (assoc :cursor-visible true)
                        (assoc-in [:blocks new-id :selection] (s/TextSelection. .baseOffset 0 .extentOffset 0)))))))

(defn delete-global-selection!
  "Deletes the text spanned by the global selection.
   Merges the start and end blocks if they span multiple nodes, and cleans up the orphaned blocks."
  [!state]
  (let [state @!state
        g-sel (:global-selection state)]
    (when (and g-sel (:start g-sel) (:end g-sel))
      (let [n-sel (sel/normalize state g-sel)
            start-id (get-in n-sel [:start :id])
            start-off (get-in n-sel [:start :offset])
            end-id (get-in n-sel [:end :id])
            end-off (get-in n-sel [:end :offset])
            root (:root state)
            start-idx (.indexOf root start-id)
            end-idx (.indexOf root end-id)]
        
        (if (= start-id end-id)
          ;; Single block fallback
          (let [len (- end-off start-off)]
            (swap! !state dissoc :global-selection)
            ;; If focus-block is in this same file, you can just call it:
            ;; (focus-block !state start-id start-off)
            (swap! !state assoc :active-block-id start-id :cursor-visible true)
            (swap! !state assoc-in [:blocks start-id :selection] 
                   (s/TextSelection.collapsed .offset start-off))
            (text-cmd/delete-range !state start-id start-off len))

          ;; 🌟 Multi-block deletion & merge
          (let [start-content (get-in state [:blocks start-id :content] "")
                end-content (get-in state [:blocks end-id :content] "")
                keep-prefix (subs start-content 0 start-off)
                keep-suffix (subs end-content end-off)
                new-content (str keep-prefix keep-suffix)
                blocks-to-remove (set (subvec root (inc start-idx) (inc end-idx)))
                new-root (vec (remove blocks-to-remove root))]
            
            (swap! !state
                   (fn [s]
                     (-> s
                         (dissoc :global-selection)
                         (assoc :root new-root)
                         (update :blocks (fn [blocks-map] (apply dissoc blocks-map blocks-to-remove)))
                         (assoc-in [:blocks start-id :content] new-content)
                         (assoc :active-block-id start-id)
                         (assoc-in [:blocks start-id :selection] 
                                   (s/TextSelection.collapsed .offset start-off))
                         (assoc :cursor-visible true))))))))))
;; =============================================================
;; 3. Shortcuts and actions
;; =============================================================

(defn handle-global-shortcut
  "Dispatch global shortcuts (Ctrl+A, Z, X/C/V, etc.)"
  [!state intent]
  (cond
    (= intent :select-all)
    (let [active-id (:active-block-id @!state)]
      (when active-id
        (let [content (get-in @!state [:blocks active-id :content])]
          (swap! !state assoc-in [:blocks active-id :selection]
                 (s/TextSelection. .baseOffset 0 .extentOffset (count content))))))

    (= intent :undo)
    (history/undo! !state)

    (= intent :redo)
    (history/redo! !state)

    (= intent :copy)
    (clipboard/copy! @!state)

    (= intent :cut)
    (clipboard/cut! !state delete-global-selection!)

    (= intent :paste)
    (-> (clipboard/paste! !state)
        (.then (fn [focus-info]
                 (when focus-info
                   (focus-block !state (:focus-block focus-info) (:offset focus-info))))))

    ;; Inline format (multi-TextSpan tree; Mongol supports TextSpan only)
    (= intent :bold)
    (when-let [active-id (:active-block-id @!state)]
      (let [block (get-in @!state [:blocks active-id])
            sel (:selection block)]
        (when (and sel (< (.-start sel) (.-end sel)))
          (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :bold true))))

    (= intent :italic)
    (when-let [active-id (:active-block-id @!state)]
      (let [block (get-in @!state [:blocks active-id])
            sel (:selection block)]
        (when (and sel (< (.-start sel) (.-end sel)))
          (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :italic true))))

    (= intent :underline)
    (when-let [active-id (:active-block-id @!state)]
      (let [block (get-in @!state [:blocks active-id])
            sel (:selection block)]
        (when (and sel (< (.-start sel) (.-end sel)))
          (text-cmd/apply-style !state active-id (.-start sel) (.-end sel) :underline true))))

    ;; Link: placeholder; URL dialog later
    (= intent :link)
    nil

    :else nil))