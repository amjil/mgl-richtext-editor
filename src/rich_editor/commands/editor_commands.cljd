(ns rich-editor.commands.editor-commands
  (:require [rich-editor.services.ime-service :as ime]
            [rich-editor.services.history-service :as history]
            [rich-editor.services.clipboard-service :as clipboard]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.model.transaction :as tx]
            [rich-editor.model.node :as node]
            [rich-editor.model.selection :as sel]
            [rich-editor.config :as config]
            ["package:flutter/services.dart" :as s]))

(defn focus-block
  "The ONLY place to clear typing-attributes. This happens when the cursor is explicitly moved."
  [!state block-id offset]
  (let [len (count (get-in @!state [:blocks block-id :content] ""))
        off (max 0 (min (or offset 0) len))
        new-sel (s/TextSelection.collapsed .offset off)]
    (swap! !state (fn [curr]
                    (-> curr
                        (dissoc :global-selection)
                        (dissoc :typing-attributes) ;; 🌟 Clear here only
                        (assoc :active-block-id block-id)
                        (assoc :cursor-visible true)
                        (assoc-in [:blocks block-id :selection] new-sel))))
    (ime/attach! !state block-id)))

(defn blur-all [!state]
  (swap! !state (fn [s] (-> s (assoc :active-block-id nil :cursor-visible false) (dissoc :typing-attributes))))
  (ime/detach!))

(defn- ensure-history
  "Push a structural snapshot unless the caller just recorded the same document."
  [state]
  (let [last-snap (last (get-in state [:history :undo-stack] []))]
    (if (and last-snap
             (= (:blocks last-snap) (:blocks state))
             (= (:root last-snap) (:root state)))
      state
      (history/push-history state false))))

(defn- descendant-of-removed?
  "True if this id is a child of a removed block (via :parent or children lists)."
  [state ids-to-remove id]
  (or (contains? ids-to-remove (:parent (get-in state [:blocks id])))
      (boolean (some (fn [rid]
                       (some #{id} (get-in state [:blocks rid :children] [])))
                     ids-to-remove))))

(defn delete-global-selection! [!state]
  (let [state-val @!state
        g-sel (:global-selection state-val)]
    (when (and g-sel (:start g-sel) (:end g-sel))
      (let [ns (sel/normalize state-val g-sel)
            sid (get-in ns [:start :id])
            soff (get-in ns [:start :offset] 0)
            eid (get-in ns [:end :id])
            eoff (get-in ns [:end :offset] 0)
            flat-ids (vec (sel/get-all-ordered-ids state-val))]
        (if (= sid eid)
          ;; Local deletion within the same block
          (do (swap! !state dissoc :global-selection)
              (swap! !state assoc :active-block-id sid :cursor-visible true)
              (swap! !state assoc-in [:blocks sid :selection] (s/TextSelection.collapsed .offset soff))
              (text-cmd/delete-range !state sid soff (- eoff soff)))

          ;; Tree-level deletion across multiple blocks.
          ;; Intermediate ids in document order (including children of sid that sit
          ;; between sid and eid) are fully selected and removed. Survivors whose
          ;; parent was removed are adopted by sid.
          (let [s-idx (.indexOf flat-ids sid)
                e-idx (.indexOf flat-ids eid)]
            (when (and (>= s-idx 0) (>= e-idx 0))
              (let [ids-to-remove (set (subvec flat-ids (inc s-idx) (inc e-idx)))
                    sb (get-in state-val [:blocks sid])
                    eb (get-in state-val [:blocks eid])
                    sc (:content sb "")
                    ec (:content eb "")
                    safe-soff (max 0 (min soff (count sc)))
                    safe-eoff (max 0 (min eoff (count ec)))
                    new-c (str (subs sc 0 safe-soff) (subs ec safe-eoff))
                    [s-spans _] (text-cmd/divide-spans-for-block (:content-spans sb []) safe-soff)
                    [_ e-rest] (text-cmd/divide-spans-for-block (:content-spans eb []) safe-eoff)
                    shifted-e (mapv (fn [span]
                                      (-> span
                                          (update :start + safe-soff)
                                          (update :end + safe-soff)))
                                    e-rest)
                    orphan-ids (filterv (fn [id]
                                          (and (not (contains? ids-to-remove id))
                                               (descendant-of-removed? state-val ids-to-remove id)))
                                        flat-ids)]
                (swap! !state
                       (fn [s]
                         (let [s (ensure-history s)
                               new-root (vec (remove ids-to-remove (:root s)))
                               blocks-clean (reduce-kv (fn [acc k v]
                                                         (if (ids-to-remove k)
                                                           acc
                                                           (assoc acc k (update v :children #(vec (remove ids-to-remove (or % [])))))))
                                                       {}
                                                       (:blocks s))
                               blocks-final (if (seq orphan-ids)
                                              (-> blocks-clean
                                                  (update-in [sid :children] #(vec (concat (or % []) orphan-ids)))
                                                  (#(reduce (fn [b-map oid] (assoc-in b-map [oid :parent] sid)) % orphan-ids)))
                                              blocks-clean)]
                           (-> s
                               (dissoc :global-selection :typing-attributes)
                               (assoc :root new-root)
                               (assoc :blocks blocks-final)
                               (assoc-in [:blocks sid :content] new-c)
                               (assoc-in [:blocks sid :content-spans] (vec (concat s-spans shifted-e)))
                               (assoc :active-block-id sid :cursor-visible true)
                               (assoc-in [:blocks sid :selection] (s/TextSelection.collapsed .offset safe-soff))))))))))))))

(defn handle-global-shortcut [!state intent]
  (cond
    (= intent :select-all)
    (let [aid (:active-block-id @!state)]
      (when aid (swap! !state assoc-in [:blocks aid :selection]
                       (s/TextSelection. .baseOffset 0 .extentOffset (count (get-in @!state [:blocks aid :content] ""))))))
    (= intent :undo) (history/undo! !state)
    (= intent :redo) (history/redo! !state)
    (= intent :copy) (clipboard/copy! @!state)
    (= intent :cut) (clipboard/cut! !state delete-global-selection!)
    (= intent :paste) (-> (clipboard/paste! !state delete-global-selection!)
                          (.then #(when % (focus-block !state (:focus-block %) (:offset %)))))
    (= intent :bold) (text-cmd/toggle-style! !state :bold)
    (= intent :italic) (text-cmd/toggle-style! !state :italic)
    (= intent :underline) (text-cmd/toggle-style! !state :underline)
    :else nil))