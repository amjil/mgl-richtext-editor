(ns rich-editor.commands.format-commands
  "Legacy format helpers. Prefer rich-editor.commands.text-commands."
  (:require [rich-editor.commands.text-commands :as text-cmd]))

(defn toggle-format!
  "Toggle format on the current selection (e.g. :bold, :italic).
   Delegates to text-commands/toggle-style!."
  [!state format-key]
  (text-cmd/toggle-style! !state format-key))
