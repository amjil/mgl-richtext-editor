(ns rich-editor.commands.text-commands
  "Handles text mutations, formatting, and block-level transformations for the rich text editor.
   Powered by a high-performance O(S) Interval Math Engine for rendering spans."
  (:require ["package:flutter/services.dart" :as s]
            ["package:flutter/material.dart" :as m]
            ["dart:core" :as dc]
            [rich-editor.model.delta :as delta]
            [rich-editor.model.transaction :as tx]
            [rich-editor.model.selection :as sel]))

;; =============================================================
;; Helper: High-Performance Interval Math Engine (O(S) Complexity)
;; =============================================================

(defn get-formats-at-offset
  "Accurately resolves overlapping spans to find the true format at the cursor."
  [spans offset old-len]
  (let [target (if (> old-len 0) offset (max 0 (dec offset)))]
    (reduce (fn [acc {:keys [start end attrs]}]
              (if (and (<= start target) (> end target))
                (merge acc attrs)
                acc))
            {}
            spans)))

(defn- normalize-spans
  "Merges adjacent spans with identical attributes and removes empty spans.
   Prevents span fragmentation over time."
  [spans]
  (let [valid-spans (filter #(> (:end %) (:start %)) spans)
        sorted-spans (sort-by :start valid-spans)]
    (reduce (fn [acc span]
              (if-let [last-span (last acc)]
                ;; If adjacent and attributes are exactly the same, merge them
                (if (and (= (:end last-span) (:start span))
                         (= (:attrs last-span) (:attrs span)))
                  (conj (vec (butlast acc)) (assoc last-span :end (:end span)))
                  (conj acc span))
                [span]))
            []
            sorted-spans)))

(defn- sever-spans-at
  "Splits any span that crosses the specific mathematical point."
  [spans point]
  (mapcat (fn [{:keys [start end attrs] :as span}]
            (if (and (< start point) (> end point))
              ;; Cut the span into two pieces at the point
              [{:start start :end point :attrs attrs}
               {:start point :end end :attrs attrs}]
              [span]))
          spans))

(defn- splice-spans
  "Pure mathematical interval splicing. 
   Deletes spans within [offset, offset + del-len], shifts subsequent spans, 
   and inserts the newly typed active-attrs span. 
   Complexity: O(S) where S is the number of format spans, NOT character count."
  [old-spans offset del-len ins-len active-attrs]
  (let [del-end (+ offset del-len)
        ;; 1. Sever spans exactly at the boundaries of the mutation
        s1 (sever-spans-at old-spans offset)
        s2 (sever-spans-at s1 del-end)
        
        ;; 2. Filter deleted segments and shift surviving downstream segments
        shift-amount (- ins-len del-len)
        shifted-spans (mapcat (fn [{:keys [start end attrs] :as span}]
                                (cond
                                  ;; Entirely before the mutation area -> keep untouched
                                  (<= end offset) [span]
                                  
                                  ;; Inside the deletion range -> drop completely
                                  (and (>= start offset) (<= end del-end)) []
                                  
                                  ;; Entirely after the mutation -> shift coordinates
                                  (>= start del-end)
                                  [(-> span
                                       (update :start #(+ % shift-amount))
                                       (update :end #(+ % shift-amount)))]
                                       
                                  ;; Should not reach here due to sever-spans-at guarantees
                                  :else [span]))
                              s2)
        
        ;; 3. Inject the newly typed format span if insertion occurred
        final-spans (if (> ins-len 0)
                      (conj (vec shifted-spans) {:start offset :end (+ offset ins-len) :attrs (or active-attrs {})})
                      shifted-spans)]
    
    ;; 4. Clean up fragmentation
    (normalize-spans final-spans)))

(defn- apply-format-to-spans
  "Applies or removes a specific format in the [start, end) range seamlessly using interval math."
  [old-spans format-start format-end format-key format-val]
  (if (>= format-start format-end)
    old-spans
    (let [;; 1. Isolate the target range by severing spans at boundaries
          s1 (sever-spans-at old-spans format-start)
          s2 (sever-spans-at s1 format-end)
          
          ;; 2. Map over the isolated spans and mutate attributes if they fall inside the range
          mutated-spans (map (fn [{:keys [start end attrs] :as span}]
                               (if (and (>= start format-start) (<= end format-end))
                                 (if (nil? format-val)
                                   (update span :attrs dissoc format-key)
                                   (assoc-in span [:attrs format-key] format-val))
                                 span))
                             s2)]
      
      ;; 3. Clean up fragmentation
      (normalize-spans mutated-spans))))

;; =============================================================
;; Basic Text Mutations (Insert, Delete, Replace) - IME Safe
;; =============================================================

(defn insert-string
  "Insert string and precisely splice active formats. Protected against IME desync."
  [!state block-id offset text]
  (let [state-val @!state
        block (get-in state-val [:blocks block-id])
        content-len (count (:content block ""))
        
        ;; SHIELD: Clamp offset to prevent IME out-of-bounds crashes
        safe-offset (max 0 (min offset content-len))
        
        spans (:content-spans block [])
        inherited (get-formats-at-offset spans safe-offset 0)
        active-attrs (if (contains? state-val :typing-attributes) (:typing-attributes state-val) inherited)
        text-len (count text)
        new-offset (+ safe-offset text-len)
        ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain safe-offset) (delta/insert text)]))]]
    
    (tx/commit-transaction! !state
      (tx/make-transaction :ops ops :after-selection (m/TextSelection.collapsed .offset new-offset))
      :merge? true)
      
    (swap! !state update-in [:blocks block-id]
           (fn [b]
             (assoc b :content-spans (splice-spans (:content-spans b []) safe-offset 0 text-len active-attrs))))))

(defn delete-range
  "Delete range and collapse spans. Protected against IME desync."
  [!state block-id offset length]
  (let [content-len (count (get-in @!state [:blocks block-id :content] ""))
        ;; SHIELD: Ensure we don't start or end out of bounds
        safe-offset (max 0 (min offset content-len))
        safe-len (max 0 (min length (- content-len safe-offset)))]
    (when (> safe-len 0)
      (let [ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain safe-offset) (delta/delete safe-len)]))]]
        (tx/commit-transaction! !state
          (tx/make-transaction :ops ops :after-selection (m/TextSelection.collapsed .offset safe-offset))
          :merge? true)
        (swap! !state update-in [:blocks block-id]
               (fn [b]
                 (assoc b :content-spans (splice-spans (:content-spans b []) safe-offset safe-len 0 nil))))))))

(defn replace-text
  "Replace text (IME) and precisely splice active formats. Protected against IME desync."
  [!state block-id offset old-text new-text]
  (let [state-val @!state
        block (get-in state-val [:blocks block-id])
        content-len (count (:content block ""))
        old-len (count old-text)
        
        ;; SHIELD: Clamp offsets
        safe-offset (max 0 (min offset content-len))
        safe-old-len (max 0 (min old-len (- content-len safe-offset)))
        
        new-len (count new-text)
        spans (:content-spans block [])
        inherited (get-formats-at-offset spans safe-offset safe-old-len)
        active-attrs (if (contains? state-val :typing-attributes) (:typing-attributes state-val) inherited)
        ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain safe-offset) (delta/delete safe-old-len) (delta/insert new-text)]))]]
    
    (tx/commit-transaction! !state
      (tx/make-transaction :ops ops :after-selection (m/TextSelection.collapsed .offset (+ safe-offset new-len)))
      :merge? true)
      
    (swap! !state update-in [:blocks block-id]
           (fn [b]
             (assoc b :content-spans (splice-spans (:content-spans b []) safe-offset safe-old-len new-len active-attrs))))))

;; =============================================================
;; Formatting Commands
;; =============================================================

(defn apply-style
  "Apply style to selection."
  [!state block-id start end attr-key attr-val]
  (let [len (- end start)
        ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain start) (delta/retain len {attr-key attr-val})]))]]
    (tx/commit-transaction! !state
                            (tx/make-transaction :ops ops :after-selection (m/TextSelection. .baseOffset start .extentOffset end)))
    (swap! !state (fn [s]
                    (let [old (get-in s [:blocks block-id :content-spans] [])
                          new-s (apply-format-to-spans old start end attr-key attr-val)]
                      (assoc-in s [:blocks block-id :content-spans] new-s))))))

(defn apply-style-cross-block!
  "Cross-block formatting."
  [!state g-sel attr-key attr-val]
  (let [state-val @!state
        n-sel (sel/normalize state-val g-sel)
        sid (get-in n-sel [:start :id])
        eid (get-in n-sel [:end :id])
        soff (get-in n-sel [:start :offset] 0)
        eoff (get-in n-sel [:end :offset] 0)
        root (:root state-val)]
    (if (= sid eid) (apply-style !state sid soff eoff attr-key attr-val)
        (let [sidx (.indexOf root sid)
              eidx (.indexOf root eid)]
          (tx/commit-transaction! !state (tx/make-transaction :ops [] :after-selection nil) :merge? false)
          (swap! !state (fn [st]
                          (reduce (fn [acc id]
                                    (let [content (get-in acc [:blocks id :content] "")
                                          old (get-in acc [:blocks id :content-spans] [])
                                          bs (if (= id sid) soff 0)
                                          be (if (= id eid) eoff (count content))]
                                      (assoc-in acc [:blocks id :content-spans] (apply-format-to-spans old bs be attr-key attr-val))))
                                  st (subvec root sidx (inc eidx)))))))))

(defn toggle-style!
  "Master toggle for formats. Prioritizes typing-attributes for precise control."
  [!state attr-key]
  (let [state-val @!state
        g-sel (:global-selection state-val)
        aid (:active-block-id state-val)]
    (if g-sel
      (let [ns (sel/normalize state-val g-sel)
            sid (get-in ns [:start :id])
            soff (get-in ns [:start :offset])
            old (get-in state-val [:blocks sid :content-spans] [])
            ;; Check if format exists dynamically via reduce
            active? (get (get-formats-at-offset old (inc soff) 0) attr-key)]
        (apply-style-cross-block! !state g-sel attr-key (if active? nil true)))
      (when aid
        (let [block (get-in state-val [:blocks aid])
              sel (:selection block)]
          (if (and sel (not (.-isCollapsed sel)))
            (let [start (min (.-baseOffset sel) (.-extentOffset sel))
                  end (max (.-baseOffset sel) (.-extentOffset sel))
                  old (:content-spans block [])
                  active? (get (get-formats-at-offset old (inc start) 0) attr-key)]
              (apply-style !state aid start end attr-key (if active? nil true)))
            ;; Collapsed: Control the pending state
            (let [off (if sel (.-extentOffset sel) 0)
                  inherited (get-formats-at-offset (:content-spans block []) off 0)
                  current (if (contains? state-val :typing-attributes) (:typing-attributes state-val) inherited)
                  active? (get current attr-key)
                  new-attr (if active? (dissoc current attr-key) (assoc current attr-key true))]
              (swap! !state assoc :typing-attributes new-attr))))))))

;; =============================================================
;; Block Splitting Engine
;; =============================================================

(defn- divide-spans-for-block 
  "Splits existing spans at the block break coordinate. 
   Returns a tuple [before-spans after-spans]."
  [spans offset]
  (reduce (fn [[before after] span]
            (let [{:keys [start end attrs]} span]
              (cond (<= end offset) [(conj before span) after]
                    (>= start offset) [before (conj after {:start (- start offset) :end (- end offset) :attrs attrs})]
                    :else [(conj before {:start start :end offset :attrs attrs})
                           (conj after {:start 0 :end (- end offset) :attrs attrs})])))
          [[] []] (or spans [])))

(defn split-block! 
  "Splits a block at the given offset. Generates a safe UUID for the new block."
  [!state active-id offset]
  (swap! !state (fn [state]
                  (let [block (get-in state [:blocks active-id])
                        content (:content block "")
                        spans (:content-spans block [])
                        b-type (:type block)
                        is-empty? (and (contains? #{:list-item :blockquote} b-type) (empty? content))]
                    (if is-empty? (assoc-in state [:blocks active-id :type] :paragraph)
                        (let [soff (max 0 (min offset (count content)))
                              [sb sa] (divide-spans-for-block spans soff)
                              ;; Fix: Utilized random-uuid to prevent rapid-split collisions
                              nid (str "b-" (random-uuid))
                              nb {:id nid :type (if (contains? #{:list-item :blockquote} b-type) b-type :paragraph)
                                  :content (subs content soff) :content-spans sa :children []}
                              root (:root state)
                              idx (inc (.indexOf root active-id))]
                          (-> state
                              (assoc-in [:blocks active-id :content] (subs content 0 soff))
                              (assoc-in [:blocks active-id :content-spans] sb)
                              (assoc-in [:blocks nid] nb)
                              (assoc :root (vec (concat (subvec root 0 idx) [nid] (subvec root idx))))
                              (assoc :active-block-id nid))))))))