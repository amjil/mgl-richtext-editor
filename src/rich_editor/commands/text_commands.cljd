(ns rich-editor.commands.text-commands
  "Handles text mutations, formatting, and block-level transformations for the rich text editor."
  (:require ["package:flutter/services.dart" :as s]
            ["package:flutter/material.dart" :as m]
            ["dart:core" :as dc]
            [rich-editor.model.delta :as delta]
            [rich-editor.model.transaction :as tx]
            [rich-editor.model.selection :as sel]))

;; =============================================================
;; Helper: Absolute Splice & Formatting Engine
;; =============================================================

(defn get-formats-at-offset
  "Accurately resolves overlapping spans to find the true format at the cursor."
  [spans offset old-len]
  (let [target (if (> old-len 0) offset (max 0 (dec offset)))]
    (reduce (fn [acc {:keys [start end attrs]}]
              (if (and (<= start target) (> end target))
                (merge acc attrs)
                acc))
            {}
            spans)))

(defn- safe-subvec [v start end]
  (let [s (max 0 (min start (count v)))
        e (max s (min end (count v)))]
    (subvec v s e)))

(defn- splice-spans
  "🌟 CORE ENGINE: Flattens spans into a character array, splices new formats, and regroups.
   This guarantees ZERO overlapping spans and flawless typing-attributes overrides."
  [content-len old-spans offset del-len ins-len active-attrs]
  (let [safe-len (max 0 content-len)
        ;; 1. Flatten old spans into per-character attributes
        char-attrs (reduce (fn [acc {:keys [start end attrs]}]
                             (reduce (fn [a i] (if (and (>= i 0) (< i safe-len)) (update a i merge attrs) a))
                                     acc (range start end)))
                           (vec (repeat safe-len {}))
                           old-spans)
        ;; 2. Delete characters range
        after-del (vec (concat (safe-subvec char-attrs 0 offset)
                               (safe-subvec char-attrs (+ offset del-len) (count char-attrs))))
        ;; 3. Insert new characters with active attributes (punches a hole in surrounding formats)
        after-ins (vec (concat (safe-subvec after-del 0 offset)
                               (vec (repeat ins-len (or active-attrs {})))
                               (safe-subvec after-del offset (count after-del))))]
    ;; 4. Regroup continuous identical attributes into absolute spans
    (->> (map-indexed vector after-ins)
         (partition-by second)
         (map (fn [group]
                (let [gs (first (first group))
                      ge (inc (first (last group)))
                      at (second (first group))]
                  (when (seq at) {:start gs :end ge :attrs at}))))
         (remove nil?)
         vec)))

(defn- apply-format-to-spans
  "Applies or removes a specific format in the [start, end) range seamlessly."
  [content old-spans start end format-key format-val]
  (let [len (count content)
        char-attrs (reduce (fn [acc {:keys [start end attrs]}]
                             (reduce (fn [a i] (if (and (>= i 0) (< i len)) (update a i merge attrs) a))
                                     acc (range start end)))
                           (vec (repeat len {})) old-spans)
        updated-attrs (map-indexed (fn [idx attrs]
                                     (if (and (>= idx start) (< idx end))
                                       (if (nil? format-val) (dissoc attrs format-key) (assoc attrs format-key format-val))
                                       attrs))
                                   char-attrs)]
    (if (empty? content) []
        (->> (map-indexed vector updated-attrs)
             (partition-by second)
             (map (fn [group]
                    (let [gs (first (first group))
                          ge (inc (first (last group)))
                          at (second (first group))]
                      (when (seq at) {:start gs :end ge :attrs at}))))
             (remove nil?) vec))))

;; =============================================================
;; Basic Text Mutations (Insert, Delete, Replace)
;; =============================================================

(defn insert-string
  "Insert string and precisely splice active formats."
  [!state block-id offset text]
  (let [state-val @!state
        block (get-in state-val [:blocks block-id])
        content-len (count (:content block ""))
        spans (:content-spans block [])
        inherited (get-formats-at-offset spans offset 0)
        active-attrs (if (contains? state-val :typing-attributes) (:typing-attributes state-val) inherited)
        text-len (count text)
        new-offset (+ offset text-len)
        ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain offset) (delta/insert text)]))]]

    (tx/commit-transaction! !state
                            (tx/make-transaction :ops ops :after-selection (m/TextSelection.collapsed .offset new-offset))
                            :merge? true)

    (swap! !state update-in [:blocks block-id]
           (fn [b]
             (assoc b :content-spans (splice-spans content-len (:content-spans b []) offset 0 text-len active-attrs))))))

(defn delete-range
  "Delete range and collapse spans."
  [!state block-id offset length]
  (when (> length 0)
    (let [content-len (count (get-in @!state [:blocks block-id :content] ""))
          ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain offset) (delta/delete length)]))]]
      (tx/commit-transaction! !state
                              (tx/make-transaction :ops ops :after-selection (m/TextSelection.collapsed .offset offset))
                              :merge? true)
      (swap! !state update-in [:blocks block-id]
             (fn [b]
               (assoc b :content-spans (splice-spans content-len (:content-spans b []) offset length 0 nil)))))))

(defn replace-text
  "Replace text (IME) and precisely splice active formats."
  [!state block-id offset old-text new-text]
  (let [old-len (count old-text)
        new-len (count new-text)
        state-val @!state
        block (get-in state-val [:blocks block-id])
        content-len (count (:content block ""))
        spans (:content-spans block [])
        inherited (get-formats-at-offset spans offset old-len)
        active-attrs (if (contains? state-val :typing-attributes) (:typing-attributes state-val) inherited)
        ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain offset) (delta/delete old-len) (delta/insert new-text)]))]]

    (tx/commit-transaction! !state
                            (tx/make-transaction :ops ops :after-selection (m/TextSelection.collapsed .offset (+ offset new-len)))
                            :merge? true)

    (swap! !state update-in [:blocks block-id]
           (fn [b]
             (assoc b :content-spans (splice-spans content-len (:content-spans b []) offset old-len new-len active-attrs))))))

;; =============================================================
;; Formatting Commands
;; =============================================================

(defn apply-style
  "Apply style to selection."
  [!state block-id start end attr-key attr-val]
  (let [len (- end start)
        ops [(tx/update-content-op block-id (delta/make-delta [(delta/retain start) (delta/retain len {attr-key attr-val})]))]]
    (tx/commit-transaction! !state
                            (tx/make-transaction :ops ops :after-selection (m/TextSelection. .baseOffset start .extentOffset end)))
    (swap! !state (fn [s]
                    (let [content (get-in s [:blocks block-id :content] "")
                          old (get-in s [:blocks block-id :content-spans] [])
                          new-s (apply-format-to-spans content old start end attr-key attr-val)]
                      (assoc-in s [:blocks block-id :content-spans] new-s))))))

(defn apply-style-cross-block!
  "Cross-block formatting."
  [!state g-sel attr-key attr-val]
  (let [state-val @!state
        n-sel (sel/normalize state-val g-sel)
        sid (get-in n-sel [:start :id])
        eid (get-in n-sel [:end :id])
        soff (get-in n-sel [:start :offset] 0)
        eoff (get-in n-sel [:end :offset] 0)
        root (:root state-val)]
    (if (= sid eid) (apply-style !state sid soff eoff attr-key attr-val)
        (let [sidx (.indexOf root sid)
              eidx (.indexOf root eid)]
          (tx/commit-transaction! !state (tx/make-transaction :ops [] :after-selection nil) :merge? false)
          (swap! !state (fn [st]
                          (reduce (fn [acc id]
                                    (let [content (get-in acc [:blocks id :content] "")
                                          old (get-in acc [:blocks id :content-spans] [])
                                          bs (if (= id sid) soff 0)
                                          be (if (= id eid) eoff (count content))]
                                      (assoc-in acc [:blocks id :content-spans] (apply-format-to-spans content old bs be attr-key attr-val))))
                                  st (subvec root sidx (inc eidx)))))))))

(defn toggle-style!
  "Master toggle for formats. Prioritizes typing-attributes for precise control."
  [!state attr-key]
  (let [state-val @!state
        g-sel (:global-selection state-val)
        aid (:active-block-id state-val)]
    (if g-sel
      (let [ns (sel/normalize state-val g-sel)
            sid (get-in ns [:start :id])
            soff (get-in ns [:start :offset])
            old (get-in state-val [:blocks sid :content-spans] [])
            ;; Check if format exists dynamically via reduce
            active? (get (get-formats-at-offset old (inc soff) 0) attr-key)]
        (apply-style-cross-block! !state g-sel attr-key (if active? nil true)))
      (when aid
        (let [block (get-in state-val [:blocks aid])
              sel (:selection block)]
          (if (and sel (not (.-isCollapsed sel)))
            (let [start (min (.-baseOffset sel) (.-extentOffset sel))
                  end (max (.-baseOffset sel) (.-extentOffset sel))
                  old (:content-spans block [])
                  active? (get (get-formats-at-offset old (inc start) 0) attr-key)]
              (apply-style !state aid start end attr-key (if active? nil true)))
            ;; Collapsed: Control the pending state
            (let [off (if sel (.-extentOffset sel) 0)
                  inherited (get-formats-at-offset (:content-spans block []) off 0)
                  current (if (contains? state-val :typing-attributes) (:typing-attributes state-val) inherited)
                  active? (get current attr-key)
                  new-attr (if active? (dissoc current attr-key) (assoc current attr-key true))]
              (swap! !state assoc :typing-attributes new-attr))))))))

;; =============================================================
;; Block Splitting Engine
;; =============================================================

(defn- split-spans-at [spans offset]
  (reduce (fn [[before after] span]
            (let [{:keys [start end attrs]} span]
              (cond (<= end offset) [(conj before span) after]
                    (>= start offset) [before (conj after {:start (- start offset) :end (- end offset) :attrs attrs})]
                    :else [(conj before {:start start :end offset :attrs attrs})
                           (conj after {:start 0 :end (- end offset) :attrs attrs})])))
          [[] []] (or spans [])))

(defn split-block! [!state active-id offset]
  (swap! !state (fn [state]
                  (let [block (get-in state [:blocks active-id])
                        content (:content block "")
                        spans (:content-spans block [])
                        b-type (:type block)
                        is-empty? (and (contains? #{:list-item :blockquote} b-type) (empty? content))]
                    (if is-empty? (assoc-in state [:blocks active-id :type] :paragraph)
                        (let [soff (max 0 (min offset (count content)))
                              [sb sa] (split-spans-at spans soff)
                              nid (str "b-" (.-millisecondsSinceEpoch (dc/DateTime.now)))
                              nb {:id nid :type (if (contains? #{:list-item :blockquote} b-type) b-type :paragraph)
                                  :content (subs content soff) :content-spans sa :children []}
                              root (:root state)
                              idx (inc (.indexOf root active-id))]
                          (-> state
                              (assoc-in [:blocks active-id :content] (subs content 0 soff))
                              (assoc-in [:blocks active-id :content-spans] sb)
                              (assoc-in [:blocks nid] nb)
                              (assoc :root (vec (concat (subvec root 0 idx) [nid] (subvec root idx))))
                              (assoc :active-block-id nid))))))))