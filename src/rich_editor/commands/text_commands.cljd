(ns rich-editor.commands.text-commands
  "Handles text mutations, formatting, and block-level transformations for the rich text editor."
  (:require ["package:flutter/services.dart" :as s]
            ["package:flutter/material.dart" :as m]
            ["dart:core" :as dc]
            [rich-editor.model.delta :as delta]
            [rich-editor.model.transaction :as tx]
            [rich-editor.model.selection :as sel]))

;; =============================================================
;; Helper
;; =============================================================

(defn- get-active-info [state]
  (let [block-id (:active-block-id state)
        block (get-in state [:blocks block-id])
        selection (:selection block)]
    {:id block-id
     :block block
     :selection selection}))

;; =============================================================
;; Basic Text Mutations (Insert, Delete, Replace)
;; =============================================================

(defn insert-string
  "Insert string at offset in block-id"
  [!state block-id offset text]
  (dc/print (str "[input] insert-string entry block-id=" block-id " offset=" offset " text=" (pr-str text)))
  (let [new-offset (+ offset (count text))
        ops [(tx/update-content-op 
               block-id 
               (delta/make-delta [(delta/retain offset) 
                                  (delta/insert text)]))]
        after-sel (sel/make-position block-id new-offset)]
    
    (tx/commit-transaction! !state
      (tx/make-transaction
        :ops ops
        :after-selection (m/TextSelection. .baseOffset new-offset .extentOffset new-offset))
      :merge? true)
    (dc/print (str "[input] insert-string committed block-id=" block-id " new-offset=" new-offset))))

(defn delete-range
  "Delete a range of text in block-id"
  [!state block-id offset length]
  (when (> length 0)
    (let [ops [(tx/update-content-op 
                 block-id 
                 (delta/make-delta [(delta/retain offset) 
                                    (delta/delete length)]))]
          after-sel (m/TextSelection. .baseOffset offset .extentOffset offset)]
      
      (tx/commit-transaction! !state
        (tx/make-transaction
          :ops ops
          :after-selection after-sel)
        :merge? true))))

(defn replace-text
  "Replace text (e.g. IME candidate)"
  [!state block-id offset old-text new-text]
  (let [old-len (count old-text)
        new-len (count new-text)
        ops [(tx/update-content-op 
               block-id 
               (delta/make-delta [(delta/retain offset) 
                                  (delta/delete old-len) 
                                  (delta/insert new-text)]))]
        after-sel (m/TextSelection. .baseOffset (+ offset new-len) .extentOffset (+ offset new-len))]
    
    (tx/commit-transaction! !state
      (tx/make-transaction
        :ops ops
        :after-selection after-sel)
      :merge? true)))

;; =============================================================
;; Single-block formatting
;; =============================================================

(defn apply-style
  "Apply style to current selection (e.g. bold) within a single block"
  [!state block-id selection-start selection-end attr-key attr-val]
  (let [len (- selection-end selection-start)
        ops [(tx/update-content-op 
               block-id 
               (delta/make-delta [(delta/retain selection-start) 
                                  (delta/retain len {attr-key attr-val})]))]]
    
    (tx/commit-transaction! !state
      (tx/make-transaction
        :ops ops
        :after-selection (m/TextSelection. 
                           .baseOffset selection-start 
                           .extentOffset selection-end)))))

;; =============================================================
;; Cross-block formatting
;; =============================================================

(defn apply-style-cross-block!
  "Apply inline format across blocks (head: from start to end of content; middle: full; tail: from 0 to end-off).
   global-selection must be a map with :start and :end."
  [!state global-selection attr-key attr-val]
  (let [state-val @!state
        n-sel (sel/normalize state-val global-selection)
        start-pos (:start n-sel)
        end-pos (:end n-sel)
        start-id (:id start-pos)
        end-id (:id end-pos)
        start-off (or (:offset start-pos) 0)
        end-off (or (:offset end-pos) 0)
        root (:root state-val)]

    (if (= start-id end-id)
      ;; not cross-block, fallback to single-block
      (apply-style !state start-id start-off end-off attr-key attr-val)
      
      (let [start-idx (.indexOf root start-id)
            end-idx (.indexOf root end-id)
            
            ;; 1. head: from start-off to end of content
            start-len (max 0 (- (count (:content (get-in state-val [:blocks start-id]) "")) start-off))
            op-start (tx/update-content-op start-id 
                       (delta/make-delta [(delta/retain start-off) 
                                          (delta/retain start-len {attr-key attr-val})]))
            
            ;; 2. tail: from 0 to end-off
            op-end (tx/update-content-op end-id 
                     (delta/make-delta [(delta/retain end-off {attr-key attr-val})]))
            
            ;; 3. body: full range for all middle blocks
            middle-ids (subvec root (inc start-idx) end-idx)
            middle-ops (map (fn [id]
                              (let [len (count (:content (get-in state-val [:blocks id]) ""))]
                                (tx/update-content-op id 
                                  (delta/make-delta [(delta/retain len {attr-key attr-val})]))))
                            middle-ids)
            
            ;; 4. combine and execute
            ops (concat [op-start op-end] middle-ops)]
            
        (tx/commit-transaction! !state
          (tx/make-transaction :ops (vec ops) :after-selection nil)
          :merge? false)))))

;; =============================================================================
;; NEW: Block Splitting Engine (The "Enter" key core logic)
;; =============================================================================

(defn- split-spans-at 
  "Splits an array of rich text spans at a specific cursor offset.
   Returns a vector containing two arrays: [spans-before, spans-after]."
  [spans offset]
  (reduce (fn [[before after] span]
            (let [{:keys [start end attrs]} span]
              (cond
                ;; Case 1: The span is completely to the left of the cursor -> stays in the old block
                (<= end offset)
                [(conj before span) after]

                ;; Case 2: The span is completely to the right of the cursor -> moves to the new block
                ;; The coordinates must be shifted by subtracting the offset.
                (>= start offset)
                [before (conj after {:start (- start offset)
                                     :end (- end offset)
                                     :attrs attrs})]

                ;; Case 3: The cursor cuts exactly through the middle of the span -> split it into two!
                :else
                [(conj before {:start start :end offset :attrs attrs})
                 (conj after {:start 0 :end (- end offset) :attrs attrs})])))
          [[] []]
          (or spans [])))

(defn split-block!
  "Splits the current block at the given offset. 
   Creates a new database block record, redistributes text and styling spans, and moves the cursor."
  [!state active-id offset]
  (swap! !state
         (fn [state]
           (let [block (get-in state [:blocks active-id])
                 content (:content block "")
                 spans (:content-spans block [])
                 b-type (:type block)
                 
                 ;; UX Detail: If the user presses Enter in an empty List or Blockquote,
                 ;; exit the formatting instead of creating another empty list item.
                 is-empty-format? (and (contains? #{:list-item :blockquote} b-type)
                                       (empty? content))
                 
                 exit-format-state
                 (when is-empty-format?
                   (-> state (assoc-in [:blocks active-id :type] :paragraph)))]
             
             (if exit-format-state
               exit-format-state
               
               ;; Proceed with the actual block split
               (let [;; 1. Slice the text
                     safe-offset (max 0 (min offset (count content)))
                     text-before (subs content 0 safe-offset)
                     text-after (subs content safe-offset)
                     
                     ;; 2. Slice the rich text styles
                     [spans-before spans-after] (split-spans-at spans safe-offset)
                     
                     ;; 3. Generate the new Block ID
                     new-id (str "block-" (.-millisecondsSinceEpoch (dc/DateTime.now)))
                     
                     ;; 4. Inherit type (if pressing enter in a list, keep making lists)
                     new-type (if (contains? #{:list-item :blockquote} b-type) b-type :paragraph)
                     
                     ;; Build the new block
                     new-block {:id new-id
                                :type new-type
                                :content text-after
                                :content-spans spans-after
                                :children []}
                     
                     ;; 5. Insert the new block ID into the root array immediately after the current one
                     root (:root state)
                     idx (inc (.indexOf root active-id))
                     new-root (vec (concat (subvec root 0 idx) [new-id] (subvec root idx)))]
                 
                 ;; 6. Update the global state structurally
                 (-> state
                     (assoc-in [:blocks active-id :content] text-before)
                     (assoc-in [:blocks active-id :content-spans] spans-before)
                     (assoc-in [:blocks new-id] new-block)
                     (assoc :root new-root)
                     (assoc :active-block-id new-id))))))))