(ns rich-editor.model.selection
  (:require [clojure.string :as str]))

;; =============================================================
;; 1. Position & Selection
;; =============================================================

(defn make-position
  "id: block id (String). offset: character offset (Integer)."
  [id offset]
  {:id id :offset offset})

(defn make-selection
  [start end]
  {:start start :end end})

;; =============================================================
;; 2. Block order
;; =============================================================

(defn get-all-ordered-ids
  "Linear order of all block ids (root + children). For cross-block selection order."
  [state]
  (let [blocks (:blocks state)
        walk (fn walk [id]
               (let [children (get-in blocks [id :children])]
                 (cons id (mapcat walk children))))]
    (mapcat walk (:root state))))

(defn compare-block-order
  "Compare two block-ids: negative (id1 first), 0 (same), positive (id2 first)."
  [state id1 id2]
  (if (= id1 id2)
    0
    (let [ordered-ids (get-all-ordered-ids state)
          idx1 (.indexOf ordered-ids id1)
          idx2 (.indexOf ordered-ids id2)]
      (- idx1 idx2))))

;; =============================================================
;; 3. Position compare
;; =============================================================

(defn position-compare
  [state pos1 pos2]
  (let [block-cmp (compare-block-order state (:id pos1) (:id pos2))]
    (if (not= block-cmp 0)
      block-cmp
      (- (or (:offset pos1) 0) (or (:offset pos2) 0)))))

(defn position-before? [state pos1 pos2] (< (position-compare state pos1 pos2) 0))

;; =============================================================
;; 4. Selection ops
;; =============================================================

(defn collapsed?
  [{:keys [start end]}]
  (and (= (:id start) (:id end))
       (= (or (:offset start) 0) (or (:offset end) 0))))

(defn normalize
  "Normalize selection direction (start before end)."
  [state selection]
  (if (or (nil? selection) (collapsed? selection))
    selection
    (if (position-before? state (:end selection) (:start selection))
      (make-selection (:end selection) (:start selection))
      selection)))

(defn is-block-selected?
  "Whether block-id is within cross-block selection."
  [state selection block-id]
  (let [n (normalize state selection)
        start-id (get-in n [:start :id])
        end-id (get-in n [:end :id])
        order (compare-block-order state start-id block-id)
        order-end (compare-block-order state block-id end-id)]
    (and (>= order 0) (>= order-end 0))))

;; =============================================================
;; 5. Export
;; =============================================================

(defn to-map [selection]
  (if (nil? selection)
    nil
    {:start {:id (get-in selection [:start :id]) :offset (get-in selection [:start :offset])}
     :end   {:id (get-in selection [:end :id])   :offset (get-in selection [:end :offset])}}))