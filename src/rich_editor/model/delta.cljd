(ns rich-editor.model.delta)

;; --- Constants: standard Delta ops [{:insert "..." :attributes {}} {:delete n} {:retain n}]

(defn insert? [op] (contains? op :insert))
(defn delete? [op] (contains? op :delete))
(defn retain? [op] (contains? op :retain))

(defn op-length [op]
  (cond
    (insert? op) (count (:insert op))
    (delete? op) (:delete op)
    (retain? op) (:retain op)
    :else 0))

;; --- Constructors ---

(defn make-delta [ops]
  {:ops (vec ops)})

(defn insert
  ([text] {:insert text})
  ([text attrs] {:insert text :attributes attrs}))

(defn delete [len]
  {:delete len})

(defn retain
  ([len] {:retain len})
  ([len attrs] {:retain len :attributes attrs}))

;; --- Pack: merge adjacent same-type ops, drop zero-length

(defn pack [ops]
  (reduce
   (fn [acc op]
     (let [last-op (last acc)]
       (cond
         ;; Skip zero-length
         (zero? (op-length op)) acc
         
         ;; Merge adjacent inserts (same attrs)
         (and last-op (insert? last-op) (insert? op) 
              (= (:attributes last-op) (:attributes op)))
         (conj (pop acc) (update last-op :insert str (:insert op)))

         ;; Merge adjacent deletes
         (and last-op (delete? last-op) (delete? op))
         (conj (pop acc) (update last-op :delete + (:delete op)))

         ;; Merge adjacent retains (same attrs)
         (and last-op (retain? last-op) (retain? op)
              (= (:attributes last-op) (:attributes op)))
         (conj (pop acc) (update last-op :retain + (:retain op)))

         :else (conj acc op))))
   []
   ops))

;; --- Transform: how position shifts when a delta is applied (collab/undo)

(defn transform-position
  "Transform logical offset by delta"
  [pos delta priority]
  (let [ops (:ops delta)]
    (loop [ops ops
           current-pos pos
           offset 0]
      (if (or (empty? ops) (<= current-pos 0))
        (+ pos offset)
        (let [op (first ops)
              len (op-length op)]
          (cond
            (insert? op)
            (if (or priority (< 0 current-pos))
              (recur (rest ops) current-pos (+ offset len))
              (recur (rest ops) current-pos offset))

            (delete? op)
            (let [deleted (min current-pos len)]
              (recur (rest ops) (- current-pos deleted) (- offset deleted)))

            (retain? op)
            (recur (rest ops) (- current-pos len) offset)))))))

;; --- Compose: merge two deltas (e.g. batch input into one transaction)

(defn compose
  "Compose [a, b]; b is applied on top of a."
  [delta-a delta-b]
  (make-delta (pack (concat (:ops delta-a) (:ops delta-b)))))

;; --- Content spans: inline format ranges [{:start 0 :end 5 :attrs {:bold true}}] ---

(defn- shift-spans
  "Shift span start/end >= from by amount (positive = right)."
  [spans from amount]
  (mapv (fn [s]
          (-> s
              (update :start #(if (>= % from) (+ % amount) %))
              (update :end   #(if (>= % from) (+ % amount) %))))
        spans))

(defn- trim-spans-over-delete
  "Given spans and deleted range [del-start del-end], return spans with that range removed (trim/split)."
  [spans del-start del-end]
  (let [len (- del-end del-start)]
    (mapcat (fn [s]
              (let [a (:start s) b (:end s)]
                (cond
                  (<= b del-start) [s]
                  (>= a del-end)   [(update (update s :start #(- % len)) :end #(- % len))]
                  (and (< a del-start) (> b del-end))
                  [(assoc s :end del-start)
                   (-> s (assoc :start del-end) (update :start #(- % len)) (update :end #(- % len)))]
                  (and (< a del-start) (<= b del-end)) [(assoc s :end del-start)]
                  (and (>= a del-start) (> b del-end))
                  [(-> s (assoc :start del-end) (update :start #(- % len)) (update :end #(- % len)))]
                  :else [])))
            spans)))

(defn transform-spans
  "Apply delta to content-spans. content-length = (count content) before delta.
   Returns new spans (vector of {:start :end :attrs})."
  [spans delta content-length]
  (let [ops (:ops delta)
        spans (or spans [])]
    (loop [pos 0
           len content-length
           acc spans
           remaining ops]
      (if (empty? remaining)
        (filterv #(> (- (:end %) (:start %)) 0) acc)
        (let [op (first remaining)
              op-len (op-length op)]
          (cond
            (insert? op)
            (let [L (count (:insert op))
                  attrs (get op :attributes)
                  shifted (shift-spans acc pos L)
                  with-new (if (and (map? attrs) (not (empty? attrs)))
                             (conj shifted {:start pos :end (+ pos L) :attrs attrs})
                             shifted)]
              (recur (+ pos L) (+ len L) with-new (rest remaining)))

            (delete? op)
            (let [del-end (+ pos op-len)
                  trimmed (trim-spans-over-delete acc pos del-end)
                  shifted (mapv (fn [s]
                                 (if (>= (:start s) del-end)
                                   (-> s (update :start #(- % op-len)) (update :end #(- % op-len)))
                                   s))
                                 trimmed)]
              (recur pos (- len op-len) shifted (rest remaining)))

            (retain? op)
            (let [attrs (get op :attributes)
                  end-pos (+ pos op-len)]
              (if (and (map? attrs) (not (empty? attrs)))
                (recur end-pos len (conj acc {:start pos :end end-pos :attrs attrs}) (rest remaining))
                (recur end-pos len acc (rest remaining))))))))))

(defn content+spans->segments
  "Split content string by spans into segments [{:text s :attrs {}} ...]. Spans sorted by :start, non-overlapping."
  [content spans]
  (let [content (or content "")
        len (count content)
        spans (or spans [])
        sorted (sort-by :start (filterv #(and (>= (:start %) 0) (< (:end %) (inc len)) (> (- (:end %) (:start %)) 0)) spans))
        raw (if (empty? sorted)
              (if (empty? content) [] [{:text content :attrs {}}])
              (loop [pos 0
                     rest-spans sorted
                     acc []]
                (if (empty? rest-spans)
                  (if (< pos len) (conj acc {:text (subs content pos) :attrs {}}) acc)
                  (let [s (first rest-spans)
                        start (:start s)
                        end (min (:end s) len)]
                    (if (>= end start)
                      (let [before (when (< pos start) {:text (subs content pos start) :attrs {}})
                            seg    {:text (subs content start end) :attrs (or (:attrs s) {})}
                            next-acc (cond-> acc
                                       (and before (not (empty? (:text before)))) (conj before)
                                       (not (empty? (:text seg))) (conj seg))]
                        (recur end (rest rest-spans) next-acc))
                      (recur pos (rest rest-spans) acc))))))]
    (filterv #(not (empty? (:text %))) raw)))

;; --- Apply delta to string (tests / plain export) ---

(defn apply-to-string [s delta]
  (let [ops (:ops delta)]
    (loop [ops ops
           text s
           pos 0]
      (if (empty? ops)
        text
        (let [op (first ops)
              len (op-length op)]
          (cond
            (insert? op)
            (recur (rest ops) 
                   (str (subs text 0 pos) (:insert op) (subs text pos))
                   (+ pos len))

            (delete? op)
            (recur (rest ops)
                   (str (subs text 0 pos) (subs text (+ pos len)))
                   pos)

            (retain? op)
            (recur (rest ops) text (+ pos len))))))))