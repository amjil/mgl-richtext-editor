(ns rich-editor.model.transaction
  (:require [rich-editor.model.delta :as delta]
            [rich-editor.services.history-service :as history]))

;; =============================================================
;; 1. Operation constructors
;; =============================================================

(defn insert-op [parent-id index nodes]
  {:type :insert :parent-id parent-id :index index :nodes nodes})

(defn delete-op [parent-id index count]
  {:type :delete :parent-id parent-id :index index :count count})

(defn update-content-op [block-id delta]
  {:type :update-content :block-id block-id :delta delta})

(defn update-attr-op [block-id attributes]
  {:type :update-attr :block-id block-id :attributes attributes})

;; =============================================================
;; 2. Apply logic (pure)
;; =============================================================

(defn- apply-op [state op]
  (case (:type op)
    ;; Insert: update blocks pool and parent id list
    :insert
    (let [{:keys [parent-id index nodes]} op
          node-ids (mapv :id nodes)
          ;; 1. Add to blocks pool
          state (update state :blocks (fn [m] (reduce #(assoc %1 (:id %2) %2) m nodes)))
          ;; 2. Insert id refs
          parent-path (if (= parent-id :root) [:root] [:blocks parent-id :children])]
      (update-in state parent-path 
                 (fn [ids] (let [[before after] (split-at index (or ids []))]
                            (vec (concat before node-ids after))))))

    ;; Delete: remove from id list; keep blocks for undo
    :delete
    (let [{:keys [parent-id index count]} op
          parent-path (if (= parent-id :root) [:root] [:blocks parent-id :children])]
      (update-in state parent-path 
                 (fn [ids] (vec (concat (subvec ids 0 index) (subvec ids (+ index count)))))))

    ;; Update content via delta; also update content-spans for inline format (bold, italic, etc.)
    :update-content
    (let [{:keys [block-id delta]} op
          block (get-in state [:blocks block-id])
          content (or (:content block) "")
          spans (or (:content-spans block) [])
          new-content (delta/apply-to-string content delta)
          new-spans (delta/transform-spans spans delta (count content))]
      (assoc-in (assoc-in state [:blocks block-id :content] new-content)
                [:blocks block-id :content-spans] new-spans))

    :update-attr
    (update-in state [:blocks (:block-id op) :attributes] merge (:attributes op))

    state))

;; =============================================================
;; 3. Transaction runner
;; =============================================================

(defn make-transaction
  "Build transaction. :ops - list of ops; :after-selection - caret position after apply."
  [& {:keys [ops after-selection]}]
  {:ops (vec ops)
   :after-selection after-selection})

(defn apply-transaction
  "Apply transaction to state; return new state. :after-selection updates top-level and active block selection for UI."
  [state transaction]
  (let [new-state (reduce apply-op state (:ops transaction))
        sel (:after-selection transaction)]
    (if-not sel
      new-state
      (let [with-global (assoc new-state :selection sel)
            active-id (:active-block-id new-state)]
        (if active-id
          (assoc-in with-global [:blocks active-id :selection] sel)
          with-global)))))

(defn commit-transaction!
  "Apply transaction to global atom. When merge? is false, push-history first for undo."
  [!state transaction & {:keys [merge?]}]
  (dart:core/print (str "[input] commit-transaction! merge?=" merge? " ops-count=" (count (:ops transaction))))
  (swap! !state (fn [curr]
                  (let [curr' (if merge? curr (history/push-history curr))
                        next-state (apply-transaction curr' transaction)]
                    next-state))))