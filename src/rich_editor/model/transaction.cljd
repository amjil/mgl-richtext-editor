(ns rich-editor.model.transaction
  "Core transaction engine. Handles pure state transitions and atomic commits."
  (:require [rich-editor.model.delta :as delta]
            [rich-editor.services.history-service :as history]))

;; =============================================================
;; 1. Operation Constructors
;; =============================================================

(defn insert-op
  "Creates an operation to insert new nodes at a specific index under a parent."
  [parent-id index nodes]
  {:type :insert :parent-id parent-id :index index :nodes nodes})

(defn delete-op
  "Creates an operation to delete a specific number of child nodes under a parent."
  [parent-id index count]
  {:type :delete :parent-id parent-id :index index :count count})

(defn update-content-op
  "Updates block text content via Delta. 
   Optionally accepts pre-calculated new-spans for strictly atomic formatting without recalculation."
  [block-id delta & [new-spans]]
  {:type :update-content :block-id block-id :delta delta :new-spans new-spans})

(defn update-attr-op
  "Updates block-level specific attributes (e.g., text alignment, indent level)."
  [block-id attributes]
  {:type :update-attr :block-id block-id :attributes attributes})

(defn update-block-data-op
  "Merges block data comprehensively: replaces :content, merges :type, and any other custom :data attributes."
  [block-id data]
  {:type :update-block-data :block-id block-id :data data})

;; =============================================================
;; 2. Apply Logic (Pure Functions)
;; =============================================================

(defn- apply-op
  "Pure function that applies a single operation to the document state immutably."
  [state op]
  (case (:type op)
    :insert
    (let [{:keys [parent-id index nodes]} op
          node-ids (mapv :id nodes)
          state (update state :blocks (fn [m] (reduce #(assoc %1 (:id %2) %2) m nodes)))
          parent-path (if (= parent-id :root) [:root] [:blocks parent-id :children])]
      (update-in state parent-path
                 (fn [ids] (let [[before after] (split-at index (or ids []))]
                             (vec (concat before node-ids after))))))

    :delete
    (let [{:keys [parent-id index count]} op
          parent-path (if (= parent-id :root) [:root] [:blocks parent-id :children])
          ids (vec (or (get-in state parent-path) []))
          n (count ids)
          idx (max 0 (min (or index 0) n))
          cnt (max 0 (min (or count 0) (- n idx)))
          removed (if (zero? cnt) [] (subvec ids idx (+ idx cnt)))
          collect-ids (fn collect [id]
                        (cons id (mapcat collect (get-in state [:blocks id :children] []))))
          to-drop (set (mapcat collect-ids removed))]
      (if (zero? cnt)
        state
        (-> state
            (assoc-in parent-path (vec (concat (subvec ids 0 idx) (subvec ids (+ idx cnt)))))
            (update :blocks (fn [m] (apply dissoc m to-drop))))))

    :update-content
    (let [{:keys [block-id delta new-spans]} op
          block (get-in state [:blocks block-id])
          content (or (:content block) "")
          spans (or (:content-spans block) [])
          new-content (delta/apply-to-string content delta)
          ;; Use exact spans if provided (e.g. from splice-spans engine), otherwise fallback to delta transformation
          final-spans (if new-spans new-spans (delta/transform-spans spans delta (count content)))]
      (-> state
          (assoc-in [:blocks block-id :content] new-content)
          (assoc-in [:blocks block-id :content-spans] final-spans)))

    :update-attr
    (update-in state [:blocks (:block-id op) :attributes] merge (:attributes op))

    :update-block-data
    (let [{:keys [block-id data]} op
          path [:blocks block-id]
          content (get data :content)
          type (get data :type)
          data-keys (remove #{:content :type} (keys data))
          data-merger (when (seq data-keys) (select-keys data data-keys))]
      (update-in state path
                 (fn [b]
                   (cond-> b
                     (some? content) (assoc :content content :content-spans [])
                     (some? type) (assoc :type type)
                     (seq data-merger) (update :data merge data-merger)))))

    ;; Fallback for unknown operations
    state))

;; =============================================================
;; 3. Transaction Runner
;; =============================================================

(defn make-transaction
  "Builds a transaction object containing operations and the post-commit cursor selection."
  [& {:keys [ops after-selection]}]
  {:ops (vec ops)
   :after-selection after-selection})

(defn apply-transaction
  "Applies a transaction immutably to the state.
   Updates both the global document selection and the local active block selection."
  [state transaction]
  (let [new-state (reduce apply-op state (:ops transaction))
        sel (:after-selection transaction)]
    (if-not sel
      new-state
      (let [with-global (assoc new-state :selection sel)
            active-id (:active-block-id new-state)]
        (if active-id
          (assoc-in with-global [:blocks active-id :selection] sel)
          with-global)))))

(defn commit-transaction!
  "Applies transaction to the global state atom. 
   Automatically delegates to history-service for debounced snapshot tracking.
   NOTE: Internal debug prints have been removed for production readiness."
  [!state transaction & {:keys [merge?] :or {merge? false}}]
  (swap! !state
         (fn [curr]
           ;; 1. Evaluate debounce & snapshot logic via history service
           (let [curr-with-history (history/push-history curr merge?)
                 ;; 2. Apply all structural and selection changes sequentially
                 next-state (apply-transaction curr-with-history transaction)]
             next-state))))