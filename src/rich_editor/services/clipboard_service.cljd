(ns rich-editor.services.clipboard-service
  "Handles clipboard operations (Copy, Cut, Paste) for both single-block and cross-block selections."
  (:require ["package:flutter/services.dart" :as s]
            [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.model.selection :as sel]
            [clojure.string :as str]))

;; --- 1. Extract ---

(defn- safe-subs
  "Substring clamped to [0, (count s)]."
  [s start end]
  (let [n (count (or s ""))
        a (max 0 (min (or start 0) n))
        b (max a (min (or end n) n))]
    (subs (or s "") a b)))

(defn- extract-selected-text
  "Extracts text handling both global (cross-block) and local (single-block) selections."
  [state]
  (if-let [g-sel (:global-selection state)]
    ;; Case 1: Cross-block selection exists
    (if (and (:start g-sel) (:end g-sel))
      (let [n-sel (sel/normalize state g-sel)
            start-id (get-in n-sel [:start :id])
            end-id (get-in n-sel [:end :id])
            start-off (get-in n-sel [:start :offset] 0)
            end-off (get-in n-sel [:end :offset] 0)
            ordered (vec (sel/get-all-ordered-ids state))
            start-idx (.indexOf ordered start-id)
            end-idx (.indexOf ordered end-id)]
        (if (and (>= start-idx 0) (>= end-idx 0))
          (let [ids-in-range (subvec ordered start-idx (inc end-idx))
                texts (map-indexed
                       (fn [i id]
                         (let [content (get-in state [:blocks id :content] "")]
                           (cond
                             (= start-idx end-idx) (safe-subs content start-off end-off)
                             (= i 0) (safe-subs content start-off (count content))
                             (= i (dec (count ids-in-range))) (safe-subs content 0 end-off)
                             :else content)))
                       ids-in-range)]
            (str/join "\n" texts))
          ""))
      "")
    ;; Case 2: No cross-block selection, fallback to active block local selection
    (if-let [active-id (:active-block-id state)]
      (let [block (get-in state [:blocks active-id])
            sel (:selection block)]
        (if (and sel (not (.-isCollapsed sel)))
          (let [start (min (.-baseOffset sel) (.-extentOffset sel))
                end (max (.-baseOffset sel) (.-extentOffset sel))]
            (safe-subs (:content block "") start end))
          ""))
      "")))

;; --- 2. Copy ---

(defn copy!
  "Put selection into system clipboard.
   NOTE: Debug print removed for production readiness."
  [state]
  (let [text (extract-selected-text state)]
    (when (not-empty text)
      (s/Clipboard.setData (s/ClipboardData. .text text)))))

(defn- delete-selection!
  "Delete global selection via :block-ops when present, otherwise fallback-delete!."
  [!state fallback-delete!]
  (if-let [del! (get-in @!state [:editor-config :block-ops :delete-cross-block-selection!])]
    (when-let [g-sel (:global-selection @!state)]
      (del! !state g-sel)
      (swap! !state dissoc :global-selection))
    (when (and fallback-delete! (:global-selection @!state))
      (fallback-delete! !state))))

;; --- 3. Paste ---

(defn- paste-into-active-block!
  "Replace the local selection if any, otherwise insert at the caret."
  [!state active-id raw-text]
  (let [block (get-in @!state [:blocks active-id])
        content (:content block "")
        sel (:selection block)
        start (if sel (min (.-baseOffset sel) (.-extentOffset sel)) (count content))
        end (if sel (max (.-baseOffset sel) (.-extentOffset sel)) (count content))
        n (count content)
        safe-start (max 0 (min start n))
        safe-end (max safe-start (min end n))]
    (if (not= safe-start safe-end)
      (text-cmd/replace-text !state active-id safe-start (subs content safe-start safe-end) raw-text)
      (text-cmd/insert-string !state active-id safe-start raw-text))))

(defn paste!
  "Read clipboard and insert at caret, replacing any local or cross-block selection.
   Future resolves to {:focus-block id :offset 0} when new block created (no focus); caller focus-block.
   fallback-delete! is used when :block-ops :delete-cross-block-selection! is absent."
  ([!state]
   (paste! !state nil))
  ([!state fallback-delete!]
   (delete-selection! !state fallback-delete!)
   (let [f (s/Clipboard.getData s.Clipboard/kTextPlain)
         f2 (.then f (fn [data]
                       (when-let [raw-text (and data (.-text data))]
                         (let [state @!state
                               active-id (:active-block-id state)]
                           (if active-id
                             (do (paste-into-active-block! !state active-id raw-text)
                                 nil)
                             (when-let [paste-no-focus! (get-in state [:editor-config :block-ops :paste-when-no-focus!])]
                               (paste-no-focus! !state raw-text)))))))]
     (.catchError f2 (fn [_err] nil)))))

;; --- 4. Cut ---

(defn cut!
  "Copy and delete selection."
  [!state delete-global-fn]
  (let [state @!state]
    (copy! state)
    (if (:global-selection state)
      (delete-selection! !state delete-global-fn)
      (when-let [active-id (:active-block-id state)]
        (let [sel (get-in state [:blocks active-id :selection])]
          (when (and sel (not (.-isCollapsed sel)))
            (let [start (min (.-baseOffset sel) (.-extentOffset sel))
                  end (max (.-baseOffset sel) (.-extentOffset sel))
                  len (- end start)]
              (text-cmd/delete-range !state active-id start len))))))))