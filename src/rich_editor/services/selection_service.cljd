(ns rich-editor.services.selection-service
  (:require [rich-editor.model.selection :as sel]
            [rich-editor.ui-state :as ui]
            [rich-editor.services.node-service :as node-service]
            [rich-editor.services.scroll-service :as scroll-service]
            [rich-editor.ui.selection-menu :as sel-menu]
            [rich-editor.utils.logger :as log]
            ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as srv]
            ["package:flutter/gestures.dart" :as g]))

;; --- Private helper functions: extract common logic ---

(defn- get-clamped-offset 
  "Calculate text offset from local coordinates, includes fallback logic for vertical layout"
  [selectable ^m/RenderBox rb ^m/Offset local-pos]
  (let [size (.-size rb)
        text (.toPlainText (.-text selectable))
        text-len (count text)
        ;; 1. Basic conversion
        clamped-local (m/Offset. (max 0.0 (min (.-width size) (.-dx local-pos)))
                                 (max 0.0 (min (.-height size) (.-dy local-pos))))]
    (try
      (let [pos (.getPositionForOffset selectable clamped-local)
            offset (.-offset pos)]
        ;; 2. Special correction for Mongolian vertical layout:
        ;; If getPositionForOffset returns the end but the actual click is in the top area, or at the edge, use ratio calculation
        (if (and (> text-len 0)
                 (or (= offset text-len) (= offset 0))
                 (< (.-dy local-pos) (.-height size))
                 (>= (.-dy local-pos) 0))
          (let [ratio (/ (.-dy clamped-local) (.-height size))]
            (-> (* ratio text-len) .round (max 0) (min text-len)))
          offset))
      (catch Exception e
        (log/log-warn (str "Offset calculation failed, using ratio fallback: " e))
        (let [ratio (/ (max 0.0 (min (.-height size) (.-dy local-pos))) (.-height size))]
          (-> (* ratio text-len) .round (max 0) (min text-len)))))))

(defn- update-editor-selection!
  "Update editor selection, force refresh even if value is the same to ensure UI update"
  [!editor-state new-sel]
  (let [current-sel (:selection @!editor-state)]
    ;; Update even if value is the same to ensure didUpdateWidget is called, triggering cursor repaint
    (swap! !editor-state assoc :selection new-sel)
    (if (not= current-sel new-sel)
      (log/log-info (str "Selection updated: " new-sel))
      (log/log-info (str "Forced selection refresh (same value): " new-sel)))))

;; --- Exported API ---

(defn handle-tap-down!
  [!editor-state ^g/TapDownDetails details]
  (let [global-pos (.-globalPosition details)
        ui-st @ui/!ui-state
        now (.millisecondsSinceEpoch (dart:core/DateTime.now))
        ;; Debounce logic
        is-double-tap? (some-> (:last-double-tap-time ui-st) (- now) (abs) (< 300))]
    
    (when-not is-double-tap?
      (sel-menu/hide-selection-menu!)
      (if-let [node (node-service/get-node-at-offset global-pos)]
        (let [{:keys [path selectable render-box]} node
              local-pos (.globalToLocal ^m/RenderBox render-box global-pos)
              offset (get-clamped-offset selectable render-box local-pos)
              new-pos (sel/make-position path offset)
              new-sel (sel/make-selection new-pos new-pos)]
          (node-service/focus-node! path)
          (update-editor-selection! !editor-state new-sel)
          (swap! ui/!ui-state assoc :pan-start-position new-pos))
        ;; Click on blank area
        (do (update-editor-selection! !editor-state nil)
            (swap! ui/!ui-state assoc :pan-start-position nil))))))

(defn handle-secondary-tap-down!
  "Handle right-click event: show context menu at click position"
  [!editor-state ^m/TapDownDetails details]
  (let [global-pos (.-globalPosition details)
        node (node-service/get-node-at-offset global-pos)
        state @!editor-state
        selection (:selection state)]
    ;; 1. If there's no selection or clicking on a different node, move cursor first
    (when (or (nil? selection)
              (and (sel/collapsed? selection)
                   (not= (get-in selection [:start :path]) (:path node))))
      (handle-tap-down! !editor-state details))
    ;; 2. Show selection menu (context menu) at click position
    (sel-menu/show-selection-menu! global-pos)))

(defn handle-pan-start!
  [!editor-state ^g/DragStartDetails details]
  (let [global-pos (.-globalPosition details)]
    (if-let [{:keys [path selectable render-box]} (node-service/get-node-at-offset global-pos)]
      (let [local-pos (.globalToLocal ^m/RenderBox render-box global-pos)
            offset (get-clamped-offset selectable render-box local-pos)
            start-pos (sel/make-position path offset)]
        (swap! ui/!ui-state assoc :pan-start-position start-pos)
        (update-editor-selection! !editor-state (sel/make-selection start-pos start-pos)))
      (swap! ui/!ui-state assoc :pan-start-position nil))))

(defn handle-pan-update!
  [!editor-state ^g/DragUpdateDetails details viewport-size scroll-controller]
  (let [global-pos (.-globalPosition details)
        start-pos (:pan-start-position @ui/!ui-state)]
    (when-let [{:keys [path selectable render-box]} (and (some? start-pos) (node-service/get-node-at-offset global-pos))]
      (let [local-pos (.globalToLocal ^m/RenderBox render-box global-pos)
            offset (get-clamped-offset selectable render-box local-pos)
            current-pos (sel/make-position path offset)
            new-sel (sel/make-selection start-pos current-pos)]
        (update-editor-selection! !editor-state new-sel)
        (scroll-service/check-auto-scroll global-pos viewport-size scroll-controller true)))))

(defn handle-pan-end!
  [!editor-state _]
  (swap! ui/!ui-state dissoc :pan-start-position)
  (let [sel (:selection @!editor-state)]
    (when (and sel (not (sel/collapsed? sel)))
      (sel-menu/show-menu-at-selection! sel))))

(defn handle-double-tap!
  [!editor-state global-pos]
  (swap! ui/!ui-state assoc :last-double-tap-time (.millisecondsSinceEpoch (dart:core/DateTime.now)))
  (sel-menu/hide-selection-menu!)
  (when-let [{:keys [selectable render-box path]} (node-service/get-node-at-offset global-pos)]
    (try
      (let [local-pos (.globalToLocal ^m/RenderBox render-box global-pos)
            pos-in-block (.getPositionForOffset selectable local-pos)
            boundary (.getWordBoundary selectable pos-in-block)
            new-sel (sel/make-selection
                      (sel/make-position path (.-start boundary))
                      (sel/make-position path (.-end boundary)))]
        (update-editor-selection! !editor-state new-sel)
        (sel-menu/show-menu-at-selection! new-sel))
      (catch Exception e (log/log-warn (str "Word selection failed: " e))))))

(defn handle-long-press!
  [!editor-state ^m/LongPressStartDetails details]
  (let [global-pos (.-globalPosition details)]
    (.selectionClick srv/HapticFeedback)
    ;; handle-double-tap! already shows the menu, no need to show it again
    (handle-double-tap! !editor-state global-pos)))

(defn handle-handle-drag!
  "Handle selection handle drag movement"
  [!editor-state global-pos handle-type]
  (.selectionClick srv/HapticFeedback)
  (let [node (node-service/get-node-at-offset global-pos)
        current-sel (:selection @!editor-state)]
    (when (and current-sel node)
      (let [{:keys [path selectable render-box]} node
            local-pos (.globalToLocal ^m/RenderBox render-box global-pos)
            offset (get-clamped-offset selectable render-box local-pos)
            new-point (sel/make-position path offset)
            
            ;; Update selection based on handle type
            updated-sel (if (= handle-type :start)
                          (assoc current-sel :start new-point)
                          (assoc current-sel :end new-point))]
        (update-editor-selection! !editor-state (sel/normalize updated-sel))))))

;; --- coordinate conversion tool ---

(defn text-selection->editor-selection
  "convert the Flutter native TextSelection to our custom cross-block Selection"
  [flutter-sel node-path]
  (sel/make-selection
   (sel/make-position node-path (.-baseOffset flutter-sel))
   (sel/make-position node-path (.-extentOffset flutter-sel))))
