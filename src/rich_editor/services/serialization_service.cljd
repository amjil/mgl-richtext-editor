(ns rich-editor.services.serialization-service)

;; Serialize/deserialize document state for save/load. Export as map; caller can pr-str (EDN) or JSON.encode.

(defn export-state
  "Export state as persistent map (:blocks :root, optional :selection :active-block-id). pr-str for EDN or JSON."
  [state]
  (select-keys state [:blocks :root :selection :active-block-id]))

(defn- document-data?
  [data]
  (and (map? data)
       (map? (:blocks data))
       (or (nil? (:root data)) (vector? (:root data)))))

(defn import-from-map
  "Merge parsed document keys into state. Ignores maps that are not a document."
  [state data]
  (if (document-data? data)
    (merge state (select-keys data [:blocks :root :selection :active-block-id]))
    state))

(defn load-state!
  "Merge document data into !state (keeps :history etc. not in export)."
  [!state data]
  (when (document-data? data)
    (swap! !state (fn [curr] (merge curr (select-keys data [:blocks :root :selection :active-block-id]))))
    true))

(defn replace-state!
  "Replace !state with data (clears history etc.)."
  [!state data]
  (when (map? data)
    (reset! !state data)
    true))
