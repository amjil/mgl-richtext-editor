(ns rich-editor.services.platform-input-service
  (:require
   [rich-editor.utils.platform :as platform]
   [rich-editor.services.desktop-input-service :as desktop-input]
   [rich-editor.services.virtual-keyboard-service :as vk-service]))

;; =============================================================
;; Platform-aware text input facade
;; Desktop: TextInput.attach + thin Dart Client (IME bridge)
;; Mobile: virtual keyboard + sync-from-editor / sync-to-editor
;; Web: no desktop IME connection
;; =============================================================

(defn update-editing-state!
  "Update the current platform's input state when selection/content changes.
   Desktop: update TextInput connection (attach / setEditingState)
   Mobile: sync to virtual keyboard editing state
   Web: no-op"
  []
  (cond
    (platform/is-web?)     nil
    (platform/is-desktop?) (desktop-input/update-editing-state!)
    (platform/is-mobile?)  (vk-service/initialize-editing-state!)
    :else                  nil))

(defn on-editor-focus-or-keyboard-show!
  "Called when the editor gains focus or the keyboard should be shown (mobile: init virtual keyboard state)."
  []
  (when (platform/is-mobile?)
    (vk-service/initialize-editing-state!)))

(defn update-caret-position!
  "Update caret/selection position in the system input layer (desktop IME only)."
  [size transform rect]
  (when (platform/is-desktop?)
    (desktop-input/update-caret-position! size transform rect)))

(defn detach!
  "Detach the current input connection (desktop: close TextInput connection)."
  []
  (when (platform/is-desktop?)
    (desktop-input/detach!)))
