(ns rich-editor.services.desktop-input-service
  (:require
   ["package:flutter/services.dart" :as service]
   ["package:flutter/widgets.dart" :as w]
   ["package:flutter/foundation.dart" :as foundation]
   ["package:mgl_editor_core/desktop_text_input_client.dart" :refer [DesktopTextInputClient]]
   [clojure.string]
   [rich-editor.command.text-commands :as cmd]
   [rich-editor.command.text-commands-helpers :as helpers]
   [rich-editor.state :as state]
   [rich-editor.model.selection :as sel]
   [rich-editor.utils.delta :as delta-utils]
   [rich-editor.model.delta :as delta]
   [rich-editor.utils.logger :as log]))

;; =============================================================
;; Desktop Text Input Service
;; Handles TextInputConnection for desktop platforms using Dart Client
;; =============================================================

(defonce ^:private text-input-connection (atom nil))
(defonce ^:private ^DesktopTextInputClient text-input-client-instance (atom nil))
(defonce ^:private last-attached-path (atom nil))
(defonce ^:private last-update-time (atom 0))
(defonce ^:private pending-path-change (atom nil))
(defonce ^:private last-selection-state (atom nil))

(defn- get-cross-block-text
  "Get text from cross-block selection"
  [doc start-idx end-idx start-offset end-offset]
  (let [text-parts (loop [idx start-idx
                          parts []]
                     (if (> idx end-idx)
                       parts
                       (let [block (get-in doc [:children idx])
                             current-delta (get-in block [:data :delta])
                             copy-start (if (= idx start-idx) start-offset 0)
                             copy-end (if (= idx end-idx) 
                                        end-offset 
                                        (helpers/get-delta-text-length current-delta))
                             text (delta-utils/delta->text 
                                   (delta/slice-delta current-delta copy-start copy-end))]
                         (recur (inc idx) (conj parts text)))))]
    (clojure.string/join "\n" text-parts)))

(defn- get-current-text []
  (let [editor-state @state/!editor-state
        selection (:selection editor-state)]
    (if selection
      (let [normalized (sel/normalize selection)
            start-path (:path (:start normalized))
            end-path (:path (:end normalized))
            start-offset (:offset (:start normalized))
            end-offset (:offset (:end normalized))
            doc (:doc editor-state)]
        (if (= start-path end-path)
          ;; Single block selection
          (let [delta (helpers/get-delta-at-path doc start-path)]
            (delta-utils/delta->text delta))
          ;; Cross-block selection
          (get-cross-block-text doc (first start-path) (first end-path) start-offset end-offset)))
      "")))

(defn- clamp-offset
  "Clamp offset to valid range and log warning"
  [offset text-len offset-name]
  (let [clamped (max 0 (min offset text-len))
        diff (max (- offset clamped) (- clamped offset))]
    (when (and (not= offset clamped) (> diff 1))
      (log/log-warn (str "[Desktop Input] get-current-selection corrected " offset-name " - original: " offset ", corrected: " clamped ", text-len: " text-len)))
    clamped))

(defn- calculate-cross-block-selection-offsets
  "Calculate offsets for cross-block selection"
  [doc start-idx end-idx start-offset end-offset]
  (let [start-block (get-in doc [:children start-idx])
        start-delta (get-in start-block [:data :delta])
        start-block-text (delta-utils/delta->text start-delta)
        start-block-len (count start-block-text)
        start-block-selected-len (- start-block-len start-offset)
        ;; Calculate cumulative length of intermediate blocks (with newlines)
        intermediate-len (if (= start-idx end-idx)
                           0
                           (loop [idx (inc start-idx)
                                  total 0]
                             (if (>= idx end-idx)
                               total
                               (let [block (get-in doc [:children idx])
                                     current-delta (get-in block [:data :delta])
                                     block-len (helpers/get-delta-text-length current-delta)]
                                 (recur (inc idx) (+ total block-len 1)))))) ; +1 for newline
        newline-len (if (= start-idx end-idx) 0 1)
        final-end-offset (+ start-block-selected-len newline-len intermediate-len end-offset)]
    {:start-offset start-offset
     :end-offset final-end-offset}))

(defn- get-current-selection []
  (let [editor-state @state/!editor-state
        selection (:selection editor-state)]
    (if selection
      (let [normalized (sel/normalize selection)
            start-path (:path (:start normalized))
            end-path (:path (:end normalized))
            start-offset (:offset (:start normalized))
            end-offset (:offset (:end normalized))
            doc (:doc editor-state)]
        (if (= start-path end-path)
          ;; Single block selection
          (let [delta (helpers/get-delta-at-path doc start-path)
                text (delta-utils/delta->text delta)
                text-len (count text)
                clamped-start (clamp-offset start-offset text-len "start-offset")
                clamped-end (clamp-offset end-offset text-len "end-offset")]
            (w/TextSelection
             :baseOffset clamped-start
             :extentOffset clamped-end))
          ;; Cross-block selection
          (let [{:keys [start-offset end-offset]} (calculate-cross-block-selection-offsets 
                                                    doc (first start-path) (first end-path) 
                                                    start-offset end-offset)
                text (get-current-text)
                text-len (count text)
                clamped-start (clamp-offset start-offset text-len "start-offset")
                clamped-end (clamp-offset end-offset text-len "end-offset")]
            (w/TextSelection
             :baseOffset clamped-start
             :extentOffset clamped-end))))
      (w/TextSelection.collapsed :offset 0))))

;; IME delta contract (from Dart): :type one of
;; :insertion {:insertionOffset, :textInserted}
;; :deletion  {:deletedRange {:start, :end}, :selectionBaseOffset, :selectionExtentOffset}
;; :replacement {:replacedRange {:start, :end}, :replacementText, :selectionBaseOffset, :selectionExtentOffset}
;; :selector  {:name "deleteBackward:" | "deleteForward:"}
(defn- dart-delta->clj [m]
  (when m
    (let [type (keyword (get m "type"))]
      (case type
        :insertion {:type type
                    :insertionOffset (get m "insertionOffset")
                    :textInserted (get m "textInserted")}
        :deletion (let [dr (get m "deletedRange")]
                    {:type type
                     :deletedRange (when dr {:start (get dr "start") :end (get dr "end")})
                     :selectionBaseOffset (get m "selectionBaseOffset")
                     :selectionExtentOffset (get m "selectionExtentOffset")})
        :replacement (let [rr (get m "replacedRange")]
                       {:type type
                        :replacedRange (when rr {:start (get rr "start") :end (get rr "end")})
                        :replacementText (get m "replacementText" "")
                        :selectionBaseOffset (get m "selectionBaseOffset")
                        :selectionExtentOffset (get m "selectionExtentOffset")})
        :selector {:type type :name (get m "name")}
        nil))))

(defn- dart-list->clj-deltas [dart-list]
  (map (fn [i]
         (dart-delta->clj (nth dart-list i)))
       (range (.-length dart-list))))

(defn- apply-delete-direction! [range* base extent]
  (when range*
    (if (not= base extent)
      (cmd/delete-selection!)
      (if (<= (get range* :end) base)
        (cmd/delete-backward!)
        (cmd/delete-forward!)))))

(defn- apply-ime-deltas! [deltas]
  (doseq [delta deltas]
    (when delta
      (let [type (:type delta)]
        (case type
          :insertion (when-let [text (not-empty (str (get delta :textInserted)))]
                       (cmd/insert-text! text))
          :deletion (let [dr (get delta :deletedRange)
                         base (get delta :selectionBaseOffset 0)
                         extent (get delta :selectionExtentOffset 0)]
                     (apply-delete-direction! dr base extent))
          :replacement (let [rr (get delta :replacedRange)
                             base (get delta :selectionBaseOffset 0)
                             extent (get delta :selectionExtentOffset 0)
                             repl-text (str (get delta :replacementText ""))]
                         (when rr
                           (when (> (get rr :end) (get rr :start))
                             (apply-delete-direction! rr base extent))
                           (when (not= repl-text "")
                             (cmd/insert-text! repl-text))))
          :selector (case (get delta :name "")
                      "deleteBackward:" (cmd/delete-backward!)
                      "deleteForward:" (cmd/delete-forward!)
                      nil)
          nil)))))

(defn- init-client! []
  (when (nil? @text-input-client-instance)
    (reset! text-input-client-instance
            (DesktopTextInputClient
             .onDeltas (fn [dart-list]
                         (apply-ime-deltas! (dart-list->clj-deltas dart-list)))))))

(defn detach! []
  (when-let [conn @text-input-connection]
    (when (.-attached conn) (.close conn))
    (reset! text-input-connection nil)
    (reset! last-attached-path nil)))

(defn attach! []
  (when-not foundation/kIsWeb
    (let [editor-state @state/!editor-state
          selection (:selection editor-state)]
      (when selection
        (init-client!)
        (let [normalized (sel/normalize selection)
              current-path (:path (:start normalized))
              existing-conn @text-input-connection]
          ;; Only detach if path actually changed
          (when (and existing-conn (not= @last-attached-path current-path))
            (detach!))
          
          (let [conn @text-input-connection
                client ^DesktopTextInputClient @text-input-client-instance]
            (when (or (nil? conn) (not (.-attached conn)))
              (let [text (get-current-text)
                    text-selection (get-current-selection)
                    editing-value (w/TextEditingValue .text text .selection text-selection)
                    config (service/TextInputConfiguration
                            .inputAction service/TextInputAction.newline
                            .inputType service/TextInputType.multiline
                            .enableDeltaModel true)
                    new-conn (service.TextInput/attach client config)]
                (reset! text-input-connection new-conn)
                (reset! last-attached-path current-path)
                (set! (.-updatingFromEditor client) true)
                (try
                  (.updateState client editing-value)
                  (.setEditingState new-conn editing-value)
                  (.show new-conn)
                  (finally
                    (set! (.-updatingFromEditor client) false)))))))))))

(defn update-editing-state! []
  (when-not foundation/kIsWeb
    (let [editor-state @state/!editor-state
          selection (:selection editor-state)]
      (when selection
        ;; Throttle: only update if selection actually changed or enough time has passed
        (let [normalized (sel/normalize selection)
              current-path (:path (:start normalized))
              start-offset (:offset (:start normalized))
              current-state {:path current-path :offset start-offset}
              now (.millisecondsSinceEpoch (dart:core/DateTime.now))
              time-since-last-update (- now @last-update-time)
              selection-changed? (not= @last-selection-state current-state)]
          ;; Only proceed if selection changed or it's been more than 100ms since last update
          (when (or selection-changed? (>= time-since-last-update 100))
            (reset! last-selection-state current-state)
            (reset! last-update-time now)
            ;; Ensure client is initialized before use
            (init-client!)
            (let [client ^DesktopTextInputClient @text-input-client-instance]
              ;; Debounce path changes: only process if path is stable for at least 50ms
              (if (not= @last-attached-path current-path)
                (do
                  (reset! pending-path-change current-path)
                  ;; Only actually change if path has been stable for 50ms or it's been more than 200ms
                  (when (or (>= time-since-last-update 50)
                            (nil? @text-input-connection))
                    (when (and @last-attached-path (not= @last-attached-path current-path))
                      (log/log-info (str "[Desktop Input] update-editing-state! - path changed, calling attach! - path: " current-path ", offset: " start-offset)))
                    (reset! last-attached-path current-path)
                    (reset! pending-path-change nil)
                    (attach!)))
                ;; Path hasn't changed, check if we need to update editing state
                (if (nil? @text-input-connection)
                  (attach!)
                  ;; Otherwise, update the existing connection's editing state
                  (when-let [conn @text-input-connection]
                    (when (and (.-attached conn) client)
                      (let [text (get-current-text)
                            text-selection (get-current-selection)
                            editing-value (w/TextEditingValue :text text :selection text-selection)
                            current-value (.-currentTextEditingValue client)]
                        ;; Only update when text or selection actually changes
                        (when (or (nil? current-value)
                                  (not= (.-text current-value) text)
                                  (not= (.-baseOffset (.-selection current-value)) (.-baseOffset text-selection))
                                  (not= (.-extentOffset (.-selection current-value)) (.-extentOffset text-selection)))
                          (set! (.-updatingFromEditor client) true)
                          (try
                            (.updateState client editing-value)
                            (.setEditingState conn editing-value)
                            (finally
                              (set! (.-updatingFromEditor client) false))))))))))))))))

(defn update-caret-position! [size transform rect]
  (when-let [conn @text-input-connection]
    (when (.-attached conn)
      (.setEditableSizeAndTransform conn size transform)
      (.setCaretRect conn rect))))
