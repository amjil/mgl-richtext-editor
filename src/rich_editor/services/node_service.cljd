(ns rich-editor.services.node-service
  (:require ["package:flutter/rendering.dart" :as r]
            ["package:flutter/widgets.dart" :as widgets]
            [rich-editor.utils.logger :as log]))

;; --- State Storage ---

;; Original registry: {path-vector {:render-box RenderBox :selectable SelectableMixin :focus-node FocusNode}}
(defonce !node-registry (atom {}))

;; Cache index: automatically maintained by watch
(defonce !nodes-by-top-level (atom {}))
(defonce !sorted-top-levels (atom []))

;; Focus throttling
(defonce ^:private !last-focus-time (atom {}))

;; --- Geometry Helper Functions ---

(defn- get-node-rect ^r/Rect [node]
  (let [^r/RenderBox rb (:render-box node)]
    (when (and rb (.-attached rb))
      (let [origin (.localToGlobal rb r/Offset.zero)]
        (r/Rect.fromLTWH (.-dx origin) (.-dy origin) 
                         (.-width (.-size rb)) (.-height (.-size rb)))))))

(defn- squared-distance-to-point ^double [^r/Rect rect ^r/Offset point]
  (let [dx (max 0.0 (- (.-left rect) (.-dx point)) (- (.-dx point) (.-right rect)))
        dy (max 0.0 (- (.-top rect) (.-dy point)) (- (.-dy point) (.-bottom rect)))]
    (+ (* dx dx) (* dy dy))))

;; --- Cache Maintenance ---

(defn- rebuild-cache! [new-registry]
  (let [grouped (group-by (fn [[path _]] (first path)) (seq new-registry))
        sorted-keys (vec (sort (keys grouped)))]
    (reset! !nodes-by-top-level grouped)
    (reset! !sorted-top-levels sorted-keys)
    (log/log-info (str "[Cache] Rebuilt. Top-level blocks: " (count sorted-keys)))))

;; Core mechanism: ensure data consistency through watch, eliminating the risk of manual maintenance
(remove-watch !node-registry :node-cache)
(add-watch !node-registry :node-cache
  (fn [_ _ _ new-reg] (rebuild-cache! new-reg)))

;; Initial sync (for hot reload)
(rebuild-cache! @!node-registry)

;; --- Exported API ---

(defn register-node! [path render-box selectable focus-node]
  (swap! !node-registry assoc path 
         {:render-box render-box
          :selectable selectable
          :focus-node focus-node}))

(defn unregister-node! [path]
  (swap! !node-registry dissoc path))

(defn focus-node! [path]
  (when-let [node (get @!node-registry path)]
    (let [^widgets/FocusNode fn-obj (:focus-node node)
          now (.millisecondsSinceEpoch (dart:core/DateTime.now))
          last-time (get @!last-focus-time path 0)
          ;; Allow request when throttled by 100ms or currently not focused
          should-request? (or (not (.-hasFocus fn-obj))
                              (> (- now last-time) 100))]
      (when (and fn-obj should-request?)
        (swap! !last-focus-time assoc path now)
        (try
          (let [binding (widgets/WidgetsBinding.instance)]
            (.addPostFrameCallback binding
              (fn [_] (when (.-canRequestFocus fn-obj) (.requestFocus fn-obj)))))
          (catch Exception _ (.requestFocus fn-obj)))))))

(defn get-node-at-offset
  "Use binary search to locate top-level block, then find nearest node within block through geometric determination"
  [^r/Offset global-offset]
  (let [top-indices @!sorted-top-levels
        nodes-map @!nodes-by-top-level
        target-x (.-dx global-offset)
        target-y (.-dy global-offset)
        n (count top-indices)]
    (if (zero? n)
      ;; Fallback when cache is empty: directly iterate registry
      (let [registry @!node-registry]
        (when (pos? (count registry))
          (let [best-result
                (reduce (fn [best [path {:keys [render-box selectable]}]]
                          (if (and render-box (.-attached render-box))
                            (let [size (.-size render-box)
                                  global-origin (.localToGlobal render-box r/Offset.zero)
                                  left (.-dx global-origin)
                                  right (+ left (.-width size))
                                  top (.-dy global-origin)
                                  bottom (+ top (.-height size))
                                  inside? (and (>= target-x left) (<= target-x right)
                                               (>= target-y top) (<= target-y bottom))]
                              (if inside?
                                (reduced {:path path :selectable selectable :render-box render-box})
                                (let [dist-x (if (< target-x left)
                                               (- left target-x)
                                               (if (> target-x right)
                                                 (- target-x right)
                                                 0.0))
                                      dist-y (if (< target-y top)
                                               (- top target-y)
                                               (if (> target-y bottom)
                                                 (- target-y bottom)
                                                 0.0))
                                      dist-sq (+ (* dist-x dist-x) (* dist-y dist-y))]
                                  (if (or (nil? best) (< dist-sq (get best :dist-sq 1.797e308)))
                                    {:path path :selectable selectable :render-box render-box :dist-sq dist-sq}
                                    best))))
                            best))
                        nil
                        registry)]
            (when (and best-result (or (nil? (:dist-sq best-result)) (< (:dist-sq best-result) 40000.0)))
              (dissoc best-result :dist-sq)))))
      (loop [low 0
             high (dec n)
             best-node nil
             min-dist-sq 40000.0] ;; 200.0^2 initial threshold
        (if (<= low high)
          (let [mid (quot (+ low high) 2)
                top-idx (nth top-indices mid)
                block-entries (get nodes-map top-idx)
                ;; Check all nodes within block
                [block-best block-min-sq last-rect]
                (reduce 
                  (fn [[b-node b-dist ^r/Rect _] [path node]]
                    (if-let [rect (get-node-rect node)]
                      (let [d-sq (squared-distance-to-point rect global-offset)]
                        (if (< d-sq b-dist)
                          [{:path path 
                            :selectable (:selectable node)
                            :render-box (:render-box node)} d-sq rect]
                          [b-node b-dist rect]))
                      [b-node b-dist nil]))
                  [nil 1.797e308 nil]
                  block-entries)]
            
            ;; If point is inside a node (d-sq == 0), return directly
            (if (and block-best (zero? block-min-sq))
              block-best
              ;; Otherwise determine binary search direction based on block's X coordinate
              (let [rect-left (if last-rect (.-left last-rect) 0.0)
                    [new-best new-dist] (if (< block-min-sq min-dist-sq)
                                          [block-best block-min-sq]
                                          [best-node min-dist-sq])]
                (if (< target-x rect-left)
                  (recur low (dec mid) new-best new-dist)
                  (recur (inc mid) high new-best new-dist)))))
          best-node)))))

(defn get-selectable-by-path
  "Get node information directly by path"
  [path]
  (get @!node-registry path))