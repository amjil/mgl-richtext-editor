(ns rich-editor.services.layout-service
  (:require [rich-editor.services.node-service :as node-service]
            [rich-editor.model.selection :as sel]
            [rich-editor.model.node :as node]
            [rich-editor.state :as state]
            [rich-editor.utils.logger :as log]
            ["package:flutter/material.dart" :as m]))

;; Constants
(def ^:private default-char-width 20.0)
(def ^:private horizontal-handle-offset 10.0)

(defn- get-text-direction
  "Gets the text direction for a given path."
  [path]
  (let [block-index (first path)
        doc (:doc @state/!editor-state)
        block (node/get-block-at-path doc [block-index])]
    (get-in block [:attributes :direction] :ttb)))

(defn- create-handle-text-selection
  "Creates a TextSelection for handle positioning at the given offset."
  [type handle-pos node-len]
  (if (and (= type :end) (= handle-pos node-len) (> node-len 0))
    ;; Select the last character for end handle at end of text
    (m/TextSelection :baseOffset (- node-len 1) :extentOffset node-len)
    ;; Normal selection: from handle-pos to handle-pos+1
    (let [handle-end-pos (if (and (= handle-pos node-len) (> node-len 0))
                           node-len
                           (min (+ handle-pos 1) node-len))]
      (m/TextSelection :baseOffset handle-pos :extentOffset handle-end-pos))))

(defn- calculate-local-offset-from-rect
  "Calculates local offset from a text rectangle based on text direction and handle type."
  [target-rect direction type]
  (if (= direction :ttb)
    ;; Vertical text: handle on the right side, centered vertically
    (m/Offset. (.-right target-rect)
               (+ (.-top target-rect) (/ (.-height target-rect) 2)))
    ;; Horizontal text: handle on top/bottom, centered horizontally
    (let [center-x (+ (.-left target-rect) (/ (.-width target-rect) 2))]
      (if (= type :start)
        ;; Start handle on top
        (m/Offset. center-x (.-top target-rect))
        ;; End handle on bottom
        (m/Offset. center-x (.-bottom target-rect))))))

(defn- calculate-local-offset-from-caret
  "Calculates local offset from caret position as fallback when no rects are available."
  [selectable render-box caret-pos direction type]
  (let [caret-local-offset (.getOffsetForCaret selectable caret-pos (m/Rect.zero))]
    (if (= direction :ttb)
      ;; Vertical: get actual character width and add to x
      (let [char-width (or (when (and render-box (.-getFullHeightForCaret render-box))
                             (.getFullHeightForCaret render-box caret-pos))
                           default-char-width)]
        (m/Offset. (+ (.-dx caret-local-offset) char-width) (.-dy caret-local-offset)))
      ;; Horizontal: adjust vertically based on type
      (let [y-offset (if (= type :start)
                       (- (.-dy caret-local-offset) horizontal-handle-offset)
                       (+ (.-dy caret-local-offset) horizontal-handle-offset))]
        (m/Offset. (.-dx caret-local-offset) y-offset)))))

(defn- calculate-handle-position-from-rects
  "Calculates handle position from text selection rectangles."
  [render-box handle-rects direction type]
  (let [target-rect (if (= type :start) (first handle-rects) (last handle-rects))
        local-offset (calculate-local-offset-from-rect target-rect direction type)]
    (.localToGlobal render-box local-offset)))

(defn- calculate-handle-position-fallback
  "Calculates handle position using caret offset as fallback."
  [selectable render-box handle-pos direction type]
  (let [caret-pos (m/TextPosition :offset handle-pos)
        adjusted-local-offset (calculate-local-offset-from-caret selectable render-box caret-pos direction type)]
    (.localToGlobal render-box adjusted-local-offset)))

(defn- calculate-handle-position
  "Calculates the global position of a handle for the given node and position."
  [selectable render-box node-text target-offset direction type]
  (let [node-len (count node-text)
        handle-pos (max 0 (min target-offset node-len))
        handle-text-sel (create-handle-text-selection type handle-pos node-len)
        handle-rects (.getBoxesForSelection selectable handle-text-sel)]
    (if (seq handle-rects)
      (calculate-handle-position-from-rects render-box handle-rects direction type)
      (calculate-handle-position-fallback selectable render-box handle-pos direction type))))

(defn get-selection-global-position
  "Calculates the global position of the selection (start or end).
   Returns an Offset or nil if not found or if the layout is not ready."
  [selection type]
  (try
    (when selection
      (let [normalized (sel/normalize selection)
            target-pos (if (= type :start) (:start normalized) (:end normalized))
            path (:path target-pos)]
        (if-let [node (node-service/get-selectable-by-path path)]
          (let [selectable (:selectable node)
                render-box (:render-box node)
                attached? (and render-box (.-attached render-box))]
            (if (and selectable render-box attached?)
              (let [node-text (.toPlainText (.-text selectable))
                    target-offset (:offset target-pos)
                    direction (get-text-direction path)]
                (calculate-handle-position selectable render-box node-text target-offset direction type))
              (do
                (log/log-warn (str "[Layout Service] node not ready - selectable: " selectable
                                   ", render-box: " render-box ", attached?: " attached?))
                nil)))
          (do
            (log/log-warn (str "[Layout Service] node not found for path: " path))
            nil))))
    (catch Exception e
      (log/log-error (str "[Layout Service] Error in get-selection-global-position: " e) e)
      nil)))

