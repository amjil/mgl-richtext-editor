(ns rich-editor.services.html-parser
  (:require ["package:html/parser.dart" :as html-parser]
            ["package:html/dom.dart" :as dom]
            [clojure.string :as str]
            [rich-editor.model.node :as node]
            [rich-editor.model.delta :as delta]))

(defn- generate-id []
  (str "b-" (.-microsecondsSinceEpoch (dart:core/DateTime.now)) "-" (rand-int 10000)))

(defn- tag->block-type [tag default-type]
  (case tag
    "h1" :heading-1
    "h2" :heading-2
    "blockquote" :blockquote
    "pre" :code-block
    "li" :list-item
    "p"  :paragraph
    "img" :image
    default-type))

(defn- tag->inline-style [tag current-styles]
  (case tag
    ("b" "strong") (assoc current-styles :bold true)
    ("i" "em")     (assoc current-styles :italic true)
    ("u" "ins")    (assoc current-styles :underline true)
    current-styles))

;; =============================================================
;; 🌟 核心：封口并生成一个 Block
;; =============================================================
(defn- flush-block! 
  "将积攒的文本和样式封装为一个 Block，并附加正确的缩进属性"
  [!current-block !blocks]
  (let [{:keys [type deltas indent url]} @!current-block]
    (when (or (seq deltas) (= type :image))
      (let [content (apply str (map :insert deltas))
            ;; 简化版：这里你应该调用你的 delta->spans 算法
            ;; 这里为了演示先给个空的，或者你可以保留纯文本
            spans [] 
            
            ;; 1. 创建基础 Node
            new-node (node/make-node (generate-id) type content)
            
            ;; 2. 🌟 附加缩进属性：只有 indent > 0 时才加，保持数据干净
            new-node (if (> indent 0)
                       (assoc-in new-node [:attributes :indent] indent)
                       new-node)
            
            ;; 3. 如果是图片，附加上 url
            new-node (if (= type :image)
                       (assoc new-node :data {:url url})
                       new-node)]
                       
        (swap! !blocks conj (assoc new-node :content-spans spans))))
    
    ;; 重置当前块的状态，默认缩进为 0
    (reset! !current-block {:type :paragraph :deltas [] :indent 0})))

;; =============================================================
;; 🌟 核心递归树遍历算法 (DOM Walker with Indentation)
;; =============================================================
(defn- walk-node! 
  "递归遍历 DOM。
   新增参数 current-indent：记录当前的嵌套深度。"
  [^dom/Node node current-styles current-indent !current-block !blocks]
  (cond
    ;; 1. 文本节点：累加内容
    (= (.-nodeType node) dom/Node.TEXT_NODE)
    (let [text (.-text node)]
      (when-not (str/blank? (str/trim text))
        (swap! !current-block update :deltas conj (delta/insert text current-styles))))

    ;; 2. 元素节点
    (= (.-nodeType node) dom/Node.ELEMENT_NODE)
    (let [^dom/Element el node
          tag-name (str/lower-case (.-localName el))]
      (cond
        ;; 🌟 A. 遇到嵌套容器 (ul, ol)
        ;; 我们不创建 Block，而是让 current-indent + 1，然后遍历它的子节点（li）
        ;; 注意：最外层的 ul 传入的 indent 是 -1，加 1 后变成 0（顶级列表缩进为 0）
        (#{"ul" "ol"} tag-name)
        (doseq [child (.-nodes el)]
          (walk-node! child current-styles (inc current-indent) !current-block !blocks))

        ;; 🌟 B. 遇到块级元素 (p, li, h1, blockquote...)
        (#{"p" "div" "h1" "h2" "h3" "blockquote" "pre" "li" "img"} tag-name)
        (do
          ;; 先把之前可能积攒的内容封口
          (flush-block! !current-block !blocks)

          ;; 设置当前块的类型和缩进级别
          (let [b-type (tag->block-type tag-name :paragraph)
                ;; 为了防止负数，强制最小为 0
                actual-indent (max 0 current-indent)]
            
            (if (= b-type :image)
              ;; 特殊处理单标签图片
              (let [src (if (.-attributes el) (get (.-attributes el) "src") "")]
                (reset! !current-block {:type :image :deltas [] :indent actual-indent :url src})
                (flush-block! !current-block !blocks))
              
              ;; 常规块，遍历内部可能存在的文本或 span
              (do
                (reset! !current-block {:type b-type :deltas [] :indent actual-indent})
                (doseq [child (.-nodes el)]
                  (walk-node! child current-styles current-indent !current-block !blocks))
                (flush-block! !current-block !blocks)))))

        ;; 🌟 C. 遇到行内元素 (b, i, u, span)
        ;; 不打断块，仅更新 current-styles
        :else
        (let [new-styles (tag->inline-style tag-name current-styles)]
          (doseq [child (.-nodes el)]
            (walk-node! child new-styles current-indent !current-block !blocks)))))))

;; =============================================================
;; 对外暴露的 API
;; =============================================================
(defn html->blocks 
  [html-str]
  (let [document (html-parser/parse html-str)
        body (.-body document)
        !blocks (atom [])
        !current-block (atom {:type :paragraph :deltas [] :indent 0})]
    
    (when body
      (doseq [child (.-nodes body)]
        ;; 🌟 核心技巧：初始的 current-indent 传 -1
        ;; 这样当遇到第一个 <ul> 时，-1 + 1 = 0，使得第一层列表没有缩进。
        ;; 当遇到 <ul> 内部嵌套的 <ul> 时，0 + 1 = 1，完美对应 1 级缩进。
        (walk-node! child {} -1 !current-block !blocks)))
    
    (flush-block! !current-block !blocks)
    @!blocks))