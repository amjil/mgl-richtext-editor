(ns rich-editor.config
  "Editor config and registry: block types, inline formats, commands, shortcuts. Highly customizable.
   Does not depend on clipboard/history/commands to avoid cyclic load with block-commands; full defaults in rich-editor.defaults."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]))

;; =============================================================
;; 1. Default block style (block-type -> TextStyle or (fn [block-type] -> TextStyle))
;; =============================================================

(defn default-block-style [block-type]
  (case block-type
    :heading-1 (m/TextStyle. .fontSize 28.0 .fontWeight m.FontWeight/bold
                           .height 2.0 .fontFamily "OyunQaganTig")
    :heading-2 (m/TextStyle. .fontSize 24.0 .fontWeight m.FontWeight/bold
                           .height 2.0 .fontFamily "OyunQaganTig")
    :blockquote (m/TextStyle. .fontSize 20.0 .fontStyle m.FontStyle/italic
                             .height 2.0 .fontFamily "OyunQaganTig")
    :code-block (m/TextStyle. .fontSize 16.0 .fontFamily "monospace" .height 1.8)
    :list-item (m/TextStyle. .fontSize 20.0 .height 2.0 .fontFamily "OyunQaganTig")
    (m/TextStyle. .fontSize 20.0 .height 2.0 .fontFamily "OyunQaganTig")))

;; =============================================================
;; 2. Default inline format (attr -> applied to base-style)
;; =============================================================

(defn default-apply-inline [base-style attrs]
  (if (or (empty? attrs) (nil? base-style))
    base-style
    (let [s (if (:bold attrs) (.copyWith base-style .fontWeight m.FontWeight/bold) base-style)
          s (if (:italic attrs) (.copyWith s .fontStyle m.FontStyle/italic) s)
          s (if (:underline attrs) (.copyWith s .decoration m.TextDecoration/underline) s)
          s (if (:link attrs) (.copyWith s .decoration m.TextDecoration/underline .color m.Colors/blue) s)]
      s)))

;; =============================================================
;; 3. Default shortcuts (SingleActivator -> intent)
;; =============================================================

(defn- default-shortcuts []
  [[(m/SingleActivator. (.-keyA s/LogicalKeyboardKey) :control true) :select-all]
   [(m/SingleActivator. (.-keyA s/LogicalKeyboardKey) :meta true) :select-all]
   [(m/SingleActivator. (.-keyZ s/LogicalKeyboardKey) :control true) :undo]
   [(m/SingleActivator. (.-keyZ s/LogicalKeyboardKey) :meta true) :undo]
   [(m/SingleActivator. (.-keyZ s/LogicalKeyboardKey) :control true :shift true) :redo]
   [(m/SingleActivator. (.-keyZ s/LogicalKeyboardKey) :meta true :shift true) :redo]
   [(m/SingleActivator. (.-keyY s/LogicalKeyboardKey) :control true) :redo]
   [(m/SingleActivator. (.-keyY s/LogicalKeyboardKey) :meta true) :redo]
   [(m/SingleActivator. (.-keyX s/LogicalKeyboardKey) :control true) :cut]
   [(m/SingleActivator. (.-keyX s/LogicalKeyboardKey) :meta true) :cut]
   [(m/SingleActivator. (.-keyC s/LogicalKeyboardKey) :control true) :copy]
   [(m/SingleActivator. (.-keyC s/LogicalKeyboardKey) :meta true) :copy]
   [(m/SingleActivator. (.-keyV s/LogicalKeyboardKey) :control true) :paste]
   [(m/SingleActivator. (.-keyV s/LogicalKeyboardKey) :meta true) :paste]
   [(m/SingleActivator. (.-keyB s/LogicalKeyboardKey) :control true) :bold]
   [(m/SingleActivator. (.-keyB s/LogicalKeyboardKey) :meta true) :bold]
   [(m/SingleActivator. (.-keyI s/LogicalKeyboardKey) :control true) :italic]
   [(m/SingleActivator. (.-keyI s/LogicalKeyboardKey) :meta true) :italic]
   [(m/SingleActivator. (.-keyU s/LogicalKeyboardKey) :control true) :underline]
   [(m/SingleActivator. (.-keyU s/LogicalKeyboardKey) :meta true) :underline]
   [(m/SingleActivator. (.-keyK s/LogicalKeyboardKey) :control true) :link]
   [(m/SingleActivator. (.-keyK s/LogicalKeyboardKey) :meta true) :link]])

;; =============================================================
;; 5. Config merge and access
;; =============================================================

(def default-config
  "Default config skeleton (no :commands to avoid cyclic dependency). Full defaults in rich-editor.defaults/full-default-config."
  {:block-style default-block-style
   :inline-format-applier default-apply-inline
   :commands {}
   :shortcuts (default-shortcuts)
   :text-block-types #{:paragraph :heading-1 :heading-2 :blockquote :code-block :list-item}
   :default-block-type :paragraph
   :custom-block-renderers {}})

(defn merge-config
  "Merge user-config into base. base is usually defaults/full-default-config.
   User can override :block-style :inline-format-applier :commands :shortcuts :text-block-types :default-block-type :custom-block-renderers."
  ([base user-config]
   (let [base (or base default-config)
        block-style (or (:block-style user-config) (:block-style base))
        ;; if block-style is a map, wrap as fn
        block-style-fn (if (fn? block-style)
                        block-style
                        (fn [t] (get block-style t (default-block-style t))))
        inline (or (:inline-format-applier user-config) (:inline-format-applier base))
        cmd-default (:commands base)
        cmd-user (:commands user-config)
        commands (if (empty? cmd-user) cmd-default (merge cmd-default cmd-user))
        shortcuts (or (:shortcuts user-config) (:shortcuts base))
        text-types (or (:text-block-types user-config) (:text-block-types base))
        default-type (or (:default-block-type user-config) (:default-block-type base))
        custom-renderers (merge (:custom-block-renderers base) (:custom-block-renderers user-config {}))]
    {:block-style block-style-fn
     :inline-format-applier inline
     :commands commands
     :shortcuts shortcuts
     :text-block-types text-types
     :default-block-type default-type
        :custom-block-renderers custom-renderers})))

(defn get-block-style
  [config block-type]
  ((:block-style config) block-type))

(defn apply-inline-formats
  [config base-style attrs]
  ((:inline-format-applier config) base-style attrs))

(defn get-command [config intent]
  (get (:commands config) intent))

(defn run-command
  "Run intent from config; returns nil if not registered"
  [config !state intent]
  (when-let [handler (get-command config intent)]
    (handler !state)))

(defn shortcut-bindings
  "Build CallbackShortcuts bindings map from config: activator -> (fn [])"
  [config !state]
  (into {} (map (fn [[activator intent]]
                  [activator (fn [] (run-command config !state intent))])
                (:shortcuts config))))

(defn text-block-type?
  [config block-type]
  (contains? (:text-block-types config) block-type))

(defn default-block-type [config]
  (:default-block-type config))
