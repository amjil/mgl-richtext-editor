(ns editor-test.main
  (:require ["package:flutter/material.dart" :as m]
            ["package:mgl_editor_core/post_frame_trigger.dart" :as pft]
            [cljd.flutter :as f]
            [rich-editor.components.editor-root :as root]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [rich-editor.services.history-service :as history]
            [rich-editor.services.ime-service :as ime]
            [rich-editor.config :as config]
            [rich-editor.defaults :as defaults]
            [rich-editor.components.node-view :as node-view]
            [shared-ime.fst-reader :as fst]
            [shared-ime.overlay-view :as overlay]
            ;; 🌟 Import the export/import services
            [rich-editor.services.export-service :as export]
            [rich-editor.services.import-service :as import]))

(defonce !state (atom {:root []
                       :blocks {}
                       :active-block-id nil
                       :cursor-visible false
                       :history {:undo-stack [] :redo-stack [] :max-depth 100}}))

(defonce !ime-attached (atom false))

;; 🌟 Test HTML with heading, bold, italic and nested lists
(def test-html-string
  "<h1>ᠮᠣᠩᠭᠣᠯ ᠪᠢᠴᠢᠭ</h1>
   <p>ᠰᠠᠢᠨ ᠪᠠᠢᠨ᠎ᠠ ᠤᠤ, <strong>ᠲᠠᠨᠢᠯᠴᠠᠬᠤ ᠳᠤ</strong> ᠲᠠᠭᠠᠲᠠᠢ ᠪᠠᠢᠨ᠎ᠠ.</p>
   <ul>
     <li>ᠡᠬᠢᠨ ᠦ ᠮᠥᠷ (List 1)</li>
     <ul>
       <li>ᠳᠡᠳ᠋ ᠮᠥᠷ (Nested List 1)</li>
       <li>ᠳᠡᠳ᠋ ᠮᠥᠷ ᠬᠣᠶᠠᠷ (Nested List 2)</li>
     </ul>
     <li>ᠳᠠᠷᠠᠭᠠᠬᠢ ᠮᠥᠷ (List 2)</li>
   </ul>
   <blockquote>ᠡᠨᠡ ᠪᠣᠯ ᠢᠰᠢᠲᠠᠲᠠᠯ᠂ <em>ᠮᠢᠨᠢ</em> ᠲᠤᠷᠰᠢᠯᠲᠠ (Blockquote with italic)</blockquote>")

(defn main []
  (m.WidgetsFlutterBinding/ensureInitialized)
  (fst/ensure-loaded)

  (editor-cmd/clear-document !state)

  (ime/set-merge-focus-callback! (fn [!state prev-id new-offset]
                                   (editor-cmd/focus-block !state prev-id new-offset)))
  (ime/set-split-focus-callback! (fn [!state new-id _]
                                   (editor-cmd/focus-block !state new-id 0)))
  (ime/set-after-update-callback! (fn [] (swap! root/!refresh-tick inc)))

  (ime/set-get-caret-offset-callback!
   (fn [block-id]
     (when-let [text-key (get @node-view/!block-text-keys block-id)]
       (when-let [ctx (.-currentContext text-key)]
         (try
           (let [^m/RenderBox rb (.findRenderObject ctx)]
             (.localToGlobal rb m.Offset/zero))
           (catch Exception _ nil))))))

  (f/run
    (m/MaterialApp
      .title "Mongol Editor Test"
      .debugShowCheckedModeBanner false
      .theme (m/ThemeData 
               .primarySwatch m.Colors/blue
               .brightness m.Brightness/dark
               .visualDensity m.VisualDensity/adaptivePlatformDensity)
      .home
      (f/widget
        :watch [state !state]
        (m/Scaffold
          .appBar
          (m/AppBar
            .title (m/Text "ᠮᠣᠩᠭᠣᠯ ᠵᠠᠰᠠᠪᠤᠷᠢᠯᠠᠭᠴᠢ" .style (m/TextStyle .fontFamily "OyunQaganTig"))
            .actions
            [(m/IconButton
               .icon (m/Icon m.Icons/undo)
               .tooltip "Undo (Ctrl+Z)"
               .onPressed (if (empty? (get-in state [:history :undo-stack]))
                            nil
                            #(history/undo! !state)))
             (m/IconButton
               .icon (m/Icon m.Icons/redo)
               .tooltip "Redo (Ctrl+Y)"
               .onPressed (if (empty? (get-in state [:history :redo-stack]))
                            nil
                            #(history/redo! !state)))
             (m/IconButton
               .icon (m/Icon m.Icons/format_bold)
               .tooltip "Bold (Ctrl+B)"
               .onPressed #(config/run-command defaults/full-default-config !state :bold))
             
             ;; 🌟 Vertical divider between edit and import/export
             (m/VerticalDivider .color m.Colors/grey .width 20.0 .indent 10.0 .endIndent 10.0)

             ;; 🌟 1. Import test button (Import HTML)
             (m/IconButton
               .icon (m/Icon m.Icons/file_download)
               .tooltip "Test Import HTML"
               .onPressed #(let [new-nodes (import/html->blocks test-html-string)
                                 new-root (mapv :id new-nodes)
                                 new-blocks-map (into {} (map (juxt :id identity) new-nodes))]
                             ;; Overwrite state with parsed blocks and reset history
                             (swap! !state assoc 
                                    :root new-root 
                                    :blocks new-blocks-map 
                                    :history {:undo-stack [] :redo-stack [] :max-depth 100}
                                    :global-selection nil)
                             ;; Refocus
                             (when (seq new-root)
                               (editor-cmd/focus-block !state (first new-root) 0))))

             ;; 🌟 2. Export test button (Export HTML)
             (m/IconButton
               .icon (m/Icon m.Icons/code)
               .tooltip "Export HTML to Console"
               .onPressed #(let [html (export/state->html @!state)]
                             ;; Print to console
                             (dart:core/print "\n========= 🚀 EXPORTED HTML =========")
                             (dart:core/print html)
                             (dart:core/print "====================================\n")))])
          
          .body
          (overlay/ime-global-wrapper
            (pft/PostFrameTrigger
              .onLayout (fn []
                          (when (compare-and-set! !ime-attached false true)
                            (when-let [active-id (:active-block-id @!state)]
                              (when (seq (:root @!state))
                                (ime/attach! !state active-id)))))
              .child (m/SafeArea
                       .child (root/editor-container !state defaults/full-default-config)))))))))