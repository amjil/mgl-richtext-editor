(ns editor-test.main
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/foundation.dart" :as foundation :refer [kIsWeb]]
   [cljd.flutter :as f]
   [rich-editor.components.editor :as editor]
   [rich-editor.components.text-field :as custom-tf]
   [rich-editor.components.toolbar :as toolbar]
   [rich-editor.defaults :as defaults]

   ;; Cross-platform IME Engine Dictionary Libraries
   [virtual-keyboard.input-control :as input-control]
   [ime-core.remote-api :as remote]
   [ime-core.fst-engine :as fst]
   [ime-core.next-word :as next-word]))
   
(defn is-mobile? []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform foundation.TargetPlatform/android)
        (= platform foundation.TargetPlatform/iOS))))

;; =============================================================
;; 1. Declare shared global state
;; =============================================================
(defonce !editor-state
  (atom {:root ["b-init"]
         :blocks {"b-init" {:id "b-init" :type :paragraph :content ""}}
         :active-block-id nil
         :cursor-visible false
         :external-keyboard-delegate nil
         :history {:undo-stack [] :redo-stack [] :max-depth 100}}))

;; =============================================================
;; 2. Main Page View
;; =============================================================
(defn main-page []
  (f/widget
   :managed [title-focus-node (m/FocusNode)
             title-controller (m/TextEditingController)]

   (m/Scaffold
    .appBar (m/AppBar
             .title (m/Text "ᠮᠣᠩᠭᠣᠯ ᠵᠠᠰᠠᠪᠤᠷᠢᠯᠠᠭᠴᠢ"
                            .style (m/TextStyle .fontFamily "OyunQaganTig"))
             .elevation 0.0)
    .body
    (m/SafeArea
     .child
     (m/Column
      .children
      [(m/Expanded
        .child (editor/mongol-editor
                !editor-state
                defaults/full-default-config

                :leading-widget
                (m/Padding
                 .padding (m/EdgeInsets.only .left 20.0 .right 0.0 .top 20.0)
                 .child
                 (custom-tf/text-field
                  !editor-state
                  {:controller title-controller
                   :focus-node title-focus-node
                   :hint "ᠭᠠᠷᠴᠠᠭ ᠣᠷᠣᠭᠤᠯᠬᠤ..."
                   :on-submitted (fn [text]
                                   (dart:core/print (str "Title input completed: " text)))
                   :style (m/TextStyle .fontSize 24.0 .fontWeight m.FontWeight/bold)}))
                
                ;; 🌟 FIX: Pass the toolbar directly into the editor component
                :toolbar (toolbar/mongol-toolbar !editor-state)))])))))

;; =============================================================
;; 3. App Entry and Initialization
;; =============================================================
(defn main []
  (m.WidgetsFlutterBinding/ensureInitialized)
  
  (remote/set-config! {:base-url "localhost:3003"
                       :candidate-api-path "/api/next_word/candidates"
                       :next-word-api-path "/api/next_word/list"})
  
  (when-not kIsWeb
    (await (fst/ensure-loaded))
    (await (next-word/ensure-loaded)))
  
  (when (is-mobile?)
    (input-control/set-control))

  (f/run
   (m/MaterialApp
    .title "Mongol Editor"
    .debugShowCheckedModeBanner false
    .theme (m/ThemeData
            .brightness m.Brightness/dark
            .primarySwatch m.Colors/blue
            .fontFamily "OyunQaganTig")
    .home (main-page))))