(ns editor-test.main
  (:require
   ["package:flutter/material.dart" :as m]
   [cljd.flutter :as f]
   [rich-editor.components.editor :as editor]
   [rich-editor.components.text-field :as custom-tf]
   [rich-editor.defaults :as defaults]

   ;; Dictionary and keyboard initialization dependencies
   [virtual-keyboard.zip-utils :as zip-utils]
   [virtual-keyboard.fst-reader :as vk-fst]
   [virtual-keyboard.input-control :as input-control]
   [virtual-keyboard.keyboard-candidates :as kc]
   [shared-ime.fst-reader :as fst]
   [shared-ime.next :as next]))

;; =============================================================
;; 1. Declare shared global state
;; =============================================================
(defonce !editor-state
  (atom {:root ["b-init"]
         :blocks {"b-init" {:id "b-init" :type :paragraph :content ""}}
         :active-block-id nil
         :cursor-visible false
         :external-keyboard-delegate nil
         :history {:undo-stack [] :redo-stack [] :max-depth 100}}))

;; =============================================================
;; 2. Main Page View
;; =============================================================
(defn main-page []
  (f/widget
   :managed [title-focus-node (m/FocusNode)
             title-controller (m/TextEditingController)]

   (m/Scaffold
    .appBar (m/AppBar
             .title (m/Text "ᠮᠣᠩᠭᠣᠯ ᠵᠠᠰᠠᠪᠤᠷᠢᠯᠠᠭᠴᠢ"
                            .style (m/TextStyle .fontFamily "OyunQaganTig"))
             .elevation 0.0)
    .body
    (m/SafeArea
     .child
     (editor/mongol-editor
      !editor-state
      defaults/full-default-config

      :leading-widget
      (m/Padding
       .padding (m/EdgeInsets.only .left 20.0 .right 20.0 .top 20.0)
       .child
       (m/SizedBox
        .width 60.0
        .child
        (custom-tf/text-field
         !editor-state
         {:controller title-controller
          :focus-node title-focus-node
          :hint "ᠭᠠᠷᠴᠠᠭ ᠣᠷᠣᠭᠤᠯᠬᠤ..."
          :on-submitted (fn [text]
                          (dart:core/print (str "Title input completed: " text)))

          :style (m/TextStyle .fontSize 24.0 .fontWeight m.FontWeight/bold)}))))))))

;; =============================================================
;; 3. App Entry and Initialization
;; =============================================================
(defn main []
  (m.WidgetsFlutterBinding/ensureInitialized)

  ;; 🌟 CORE FIX: Initialize core FST engines globally (for both Desktop and Mobile)
  (fst/ensure-loaded)
  (next/ensure-loaded)

  ;; Mobile specific asset loading for virtual keyboard
  (when (editor/is-mobile?)
    (zip-utils/load-assets-parallel [[kc/next "assets/next.zip"]])
    (vk-fst/ensure-loaded) ;; Note: Use .then if await is not supported in this context
    (input-control/set-control))

  (f/run
   (m/MaterialApp
    .title "Mongol Editor"
    .debugShowCheckedModeBanner false
    .theme (m/ThemeData
            .brightness m.Brightness/dark
            .primarySwatch m.Colors/blue
            .fontFamily "OyunQaganTig")
    .home (main-page))))