(ns editor-test.main
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/foundation.dart" :as foundation :refer [kIsWeb]]
   [cljd.flutter :as f]
   
   ;; Core component imports
   [rich-editor.components.editor :as editor]
   [rich-editor.components.simple-editor :as simple-editor]
   [rich-editor.components.text-field :as custom-tf]
   [rich-editor.components.toolbar :as toolbar]
   [rich-editor.defaults :as defaults]

   ;; Cross-platform Mongolian IME engine libraries
   [virtual-keyboard.input-control :as input-control]
   [ime-core.remote-api :as remote]
   [ime-core.fst-engine :as fst]
   [ime-core.next-word :as next-word]))
   
(defn is-mobile? []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform foundation.TargetPlatform/android)
        (= platform foundation.TargetPlatform/iOS))))

;; =============================================================================
;; 1. Global atom state for both editor modes
;; =============================================================================

(defonce !multi-block-state
  (atom {:root ["b-init"]
         :blocks {"b-init" {:id "b-init" :type :paragraph :content ""}}
         :active-block-id nil
         :cursor-visible false
         :external-keyboard-delegate nil
         :history {:undo-stack [] :redo-stack [] :max-depth 100}}))

(defonce !single-block-state (simple-editor/init-simple-state))

;; =============================================================================
;; 2. Sandbox mock tag picker
;; =============================================================================
(defn- show-sandbox-tag-modal! [ctx !state on-insert-fn]
  (m/showModalBottomSheet
   .context ctx
   .backgroundColor m.Colors/transparent
   .builder (fn [sheet-ctx]
              (m/Container
               .decoration (m/BoxDecoration 
                            .color (m/Color 0xFF212121)
                            .borderRadius (m/BorderRadius.vertical .top (m/Radius.circular 16.0)))
               .height 180.0
               .child
               (m/Column
                .children
                [(m/ListTile
                  .leading (m/Icon m.Icons/person .color m.Colors/blue)
                  .title (m/Text "@Oyun" .style (m/TextStyle .color m.Colors/white))
                  .onTap (fn []
                           (on-insert-fn "@Oyun" "user_test_888")
                           (m/Navigator.pop sheet-ctx)))
                 (m/ListTile
                  .leading (m/Icon m.Icons/tag .color m.Colors/blue)
                  .title (m/Text "#ClojureDart" .style (m/TextStyle .color m.Colors/white))
                  .onTap (fn []
                           (on-insert-fn "#ClojureDart" "topic_test_999")
                           (m/Navigator.pop sheet-ctx)))])))))

;; =============================================================================
;; 3. Page one: long-form / multi-block editor
;; =============================================================================
(defn multi-block-page []
  (f/widget
   :managed [title-focus-node (m/FocusNode)
             title-controller (m/TextEditingController)]
   (m/Scaffold
    .appBar 
    (m/AppBar
     .title (m/Text "Long-form Mode" .style (m/TextStyle .fontFamily "OyunQaganTig"))
     .elevation 0.0
     .actions [(m/IconButton
                .icon (m/Icon m.Icons/bug_report)
                .onPressed #(dart:core/print (str "📚 Content: " @!multi-block-state)))])
    .body
    (m/SafeArea
     .child
     (m/Column
      .children
      [(m/Expanded
        .child 
        (editor/mongol-editor
         !multi-block-state
         defaults/full-default-config
         :leading-widget
         (m/Padding
          .padding (m/EdgeInsets.only .left 20.0 .right 0.0 .top 20.0)
          .child
          (custom-tf/text-field
           !multi-block-state
           {:controller title-controller
            :focus-node title-focus-node
            :hint "ᠭᠠᠷᠴᠠᠭ ᠣᠷᠣᠭᠤᠯᠬᠤ..."
            :style (m/TextStyle .fontSize 24.0 .fontWeight m.FontWeight/bold)}))
         :toolbar (toolbar/mongol-toolbar !multi-block-state)))])))))

;; =============================================================================
;; 4. Page two: tweet / single-block post (leading & trailing slots)
;; =============================================================================
(defn single-block-page []
  (f/widget
   :context ctx
   (m/Scaffold
    .appBar 
    (m/AppBar
     .title (m/Text "Tweet Mode" .style (m/TextStyle .fontFamily "OyunQaganTig"))
     .elevation 0.0
     .actions [(m/IconButton
                .icon (m/Icon m.Icons/bug_report)
                .onPressed (fn []
                             (let [block (get-in @!single-block-state [:blocks "main-post-id"])]
                               (dart:core/print (str "📝 Text: " (:content block)))
                               (dart:core/print (str "📍 Spans: " (:content-spans block))))))])
    .body
    (m/SafeArea
     .child
     (simple-editor/simple-editor
      !single-block-state
      :editor-config {:on-tag-tap #(dart:core/print (str "🚀 Click Link ID: " %))}
      
      :leading 
      (m/Container
       .padding (m/EdgeInsets.only .top 12.0 .left 8.0 .right 4.0)
       .child
       (m/Column
        .children
        [(m/IconButton
          .icon (m/Icon m.Icons/alternate_email .color m.Colors/blue)
          .tooltip "Tag User"
          .onPressed #(show-sandbox-tag-modal! ctx !single-block-state 
                       (fn [display id] (simple-editor/insert-entity-at-cursor! !single-block-state display id))))
         (m/IconButton
          .icon (m/Icon m.Icons/tag .color m.Colors/blue)
          .tooltip "Add Topic"
          .onPressed #(show-sandbox-tag-modal! ctx !single-block-state 
                       (fn [display id] (simple-editor/insert-entity-at-cursor! !single-block-state display id))))
         (m/IconButton
          .icon (m/Icon m.Icons/image_outlined .color m.Colors/blue)
          .tooltip "Add Image"
          .onPressed #())]))

      ;; Trailing slot: quote preview
      :trailing
      (m/Container
       .width 140.0
       .margin (m/EdgeInsets.only .top 12.0 .right 16.0 .bottom 12.0)
       .padding (m/EdgeInsets.all 12.0)
       .decoration (m/BoxDecoration 
                    .color (m/Color 0xFF2A2A2A)
                    .border (m/Border.all .color m/Colors.grey.shade800)
                    .borderRadius (m/BorderRadius.circular 12.0))
       .child
       (m/Column
        .crossAxisAlignment m.CrossAxisAlignment/start
        .children
        [(m/Text "@Batjargal" .style (m/TextStyle .fontWeight m.FontWeight/bold .color m.Colors/blue))
         (m/SizedBox .height 8.0)
         (m/Text "This is a quote preview in the trailing slot beside the editor." 
                 .style (m/TextStyle .color m.Colors/white70 .fontSize 12.0)
                 .maxLines 8 
                 .overflow m.TextOverflow/ellipsis)])))))))

;; =============================================================================
;; 5. Home page navigation
;; =============================================================================
(defn home-page []
  (f/widget
   :context ctx
   (m/Scaffold
    .appBar (m/AppBar 
             .title (m/Text "Mongol Editor Sandbox" .style (m/TextStyle .fontFamily "OyunQaganTig"))
             .elevation 0.0)
    .body
    (m/Center
     .child
     (m/Column
      .mainAxisAlignment m.MainAxisAlignment/center
      .children
      [(m/ElevatedButton
        .style (m/ElevatedButton.styleFrom 
                .padding (m/EdgeInsets.symmetric .horizontal 32.0 .vertical 16.0))
        .onPressed (fn [] (m/Navigator.push ctx (m/MaterialPageRoute .builder (fn [_] (multi-block-page)))) nil)
        .child (m/Text "Open Multi-block Editor" .style (m/TextStyle .fontSize 18.0)))
       
       (m/SizedBox .height 24.0)
       
       (m/ElevatedButton
        .style (m/ElevatedButton.styleFrom 
                .backgroundColor m.Colors/teal
                .foregroundColor m.Colors/white
                .padding (m/EdgeInsets.symmetric .horizontal 32.0 .vertical 16.0))
        .onPressed (fn [] (m/Navigator.push ctx (m/MaterialPageRoute .builder (fn [_] (single-block-page)))) nil)
        .child (m/Text "Open Single-block Tweet Editor" .style (m/TextStyle .fontSize 18.0)))])))))

;; =============================================================================
;; 6. Engine initialization and entry point
;; =============================================================================
(defn main []
  (m.WidgetsFlutterBinding/ensureInitialized)
  
  (remote/set-config! {:base-url "localhost:3003"
                       :candidate-api-path "/api/next_word/candidates"
                       :next-word-api-path "/api/next_word/list"})
  
  (when-not kIsWeb
    (await (fst/ensure-loaded))
    (await (next-word/ensure-loaded)))
  
  (when (is-mobile?)
    (input-control/set-control))

  (f/run
   (m/MaterialApp
    .title "Mongol Editor Sandbox"
    .debugShowCheckedModeBanner false
    .theme (m/ThemeData
            .brightness m.Brightness/dark
            .primarySwatch m.Colors/blue
            .fontFamily "OyunQaganTig")
    .home (home-page))))